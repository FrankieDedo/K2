<?xml version="1.0" encoding="utf-8"?>
<!-- BepInEx.Core/BepInEx.PluginInfoProps aren't on nuget.org — they're published on BepInEx's own
     feed. Scoped to this project folder so it doesn't affect K2.App/K2.Core's restore. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="bepinex" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
