<Window x:Class="K2.Core.EmojiPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core"
        Title="{loc:Get emoji_picker_title}"
        Height="560" Width="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{DynamicResource K2WindowStyle}">

    <Window.Resources>
        <!-- One emoji cell: flat, chrome-free (the art IS the button), with a subtle hover
             fill and an accent outline on the current selection. -->
        <Style x:Key="EmojiCellStyle" TargetType="Button">
            <Setter Property="Width"  Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows are just containers: no selection chrome, no padding, no hit-test surface
             of their own (the cells inside handle everything). -->
        <Style x:Key="EmojiRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin"  Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- search + category -->
            <RowDefinition Height="*"/>      <!-- grid -->
            <RowDefinition Height="Auto"/>   <!-- selection preview -->
            <RowDefinition Height="Auto"/>   <!-- buttons -->
        </Grid.RowDefinitions>

        <!-- Search + category -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{loc:Get emoji_search_label}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox   Grid.Column="1" x:Name="TxtSearch" Height="26"
                       VerticalContentAlignment="Center"
                       TextChanged="Filter_Changed"/>

            <TextBlock Grid.Column="2" Text="{loc:Get emoji_category_label}"
                       VerticalAlignment="Center" Margin="14,0,8,0"/>
            <ComboBox  Grid.Column="3" x:Name="CbCategory" Width="170" Height="26"
                       SelectionChanged="Filter_Changed"/>
        </Grid>

        <!-- Emoji grid: rows of fixed-width cells inside a virtualizing ListBox (WPF has no
             virtualizing WrapPanel, and ~1400 un-virtualized cells is a visible stall). -->
        <Border Grid.Row="1" Background="#16161B" BorderBrush="#333" BorderThickness="1"
                CornerRadius="4" Padding="4">
            <Grid>
                <ListBox x:Name="LstRows"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource EmojiRowStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource EmojiCellStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{Binding Name}"
                                                Click="EmojiCell_Click">
                                            <Image Source="{Binding Image}" Width="32" Height="32"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="LblNoResults"
                           Text="{loc:Get emoji_no_results}"
                           Foreground="#777" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- Current selection -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Border Width="52" Height="52" Background="#1A1A1E"
                    BorderBrush="#333" BorderThickness="1" CornerRadius="9">
                <Image x:Name="ImgSelected" Width="36" Height="36"/>
            </Border>
            <TextBlock x:Name="LblSelected" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="{loc:Get emoji_none_selected}" Foreground="#CCC"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Get cancel}" Width="90" Padding="6,2" IsCancel="True"/>
            <Button x:Name="BtnOk" Content="{loc:Get ok}" Width="90" Padding="6,2" Margin="8,0,0,0"
                    IsDefault="True" IsEnabled="False"
                    Style="{DynamicResource K2IconAccentButton}"
                    Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
