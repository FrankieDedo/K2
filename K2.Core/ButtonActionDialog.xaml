<Window x:Class="K2.Core.ButtonActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core"
        Title="{loc:Get dlg_title}"
        Height="520" Width="580"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        Style="{DynamicResource K2WindowStyle}">
    <Window.Resources>
        <!-- Recent-paths list rows (exec/folder panels): dark background matching the rest
             of the dialog — the stock ListBox/ListBoxItem chrome otherwise forces a
             white/system background regardless of Background set on the instance (same fix
             as K2.App's MacroLibraryItemStyle/LbMacros). -->
        <Style x:Key="RecentPathItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E26"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A33"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared chrome for the breadcrumb crumbs (type trigger) AND every picker-overlay
             card (category/action/sub-action) — same accent-stripe + rounded card look
             throughout, just sized differently (crumbs: Auto width, content-sized; overlay
             cards: stretch to fill their UniformGrid cell). -->
        <ControlTemplate x:Key="CrumbCardTemplate" TargetType="Button">
            <Border x:Name="Card" CornerRadius="8" Background="#221F26"
                    BorderBrush="#2A2A32" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource K2AccentBrush}"
                            CornerRadius="8,0,0,8"/>
                    <ContentPresenter Grid.Column="1" Margin="10,6,12,6"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Card chrome shared by all three picker-overlay grids (category/action/sub-action):
             accent stripe + rounded border, same family as CrumbCardTemplate above. Each
             item's DataTemplate sets Content to a Grid with the icon (bottom-right, a little
             breathing room, never overflowing) + normal-case name (top-left) bound to the
             item VM — mirrors the crumb's ContentPresenter approach so hover/click stay
             simple ControlTemplate.Triggers instead of RelativeSource DataTriggers. -->
        <ControlTemplate x:Key="PickerCardTemplate" TargetType="Button">
            <Border x:Name="Card" CornerRadius="10" Background="#221F26"
                    BorderBrush="#2A2A32" BorderThickness="1" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource K2AccentBrush}"
                            CornerRadius="10,0,0,10"/>
                    <ContentPresenter Grid.Column="1"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblHeader" Grid.Row="0"
                   Text="{loc:Get dlg_button_label}"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

        <TextBlock x:Name="LblActionType" Grid.Row="1" Text="{loc:Get dlg_action_type}" Margin="0,0,0,4"/>

        <!-- Type trigger: a breadcrumb of 2-3 clickable crumbs (Category > Action [> Sub-action])
             showing the selection tree, each reopening the inline PickerPanel at its own level
             so any step can be changed without re-walking the whole tree. CbType/CbComboValue
             stay in the tree (Collapsed) as the single source of truth every other panel/
             handler already reads from — see ButtonActionDialog.TypePicker.cs.
             Hidden (with its label) while the picker is open: mid-pick the chain still shows
             the PREVIOUS selection, which reads as stale/contradictory next to the grid the
             user is choosing from — the picker's own title + back arrow carry the context
             there instead. -->
        <StackPanel x:Name="PnlBreadcrumb" Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="BtnCrumbCategory" Click="BtnCrumbCategory_Click" Height="40"
                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                    Template="{StaticResource CrumbCardTemplate}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtCrumbCategoryGlyph" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCrumbCategoryName" FontSize="13" VerticalAlignment="Center"
                               Margin="8,0,0,0" Foreground="{StaticResource K2TextBrush}"/>
                </StackPanel>
            </Button>
            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                       Foreground="#6A6A72" VerticalAlignment="Center" Margin="6,0"/>
            <Button x:Name="BtnCrumbAction" Click="BtnCrumbAction_Click" Height="40"
                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                    Template="{StaticResource CrumbCardTemplate}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtCrumbActionGlyph" FontSize="16" VerticalAlignment="Center"/>
                    <Path x:Name="PathCrumbActionIcon" Stretch="Uniform"
                          VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Image x:Name="ImgCrumbActionIcon" Width="16" Height="16" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtCrumbActionName" FontSize="13" VerticalAlignment="Center"
                               Margin="8,0,0,0" Foreground="{StaticResource K2TextBrush}"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="TxtCrumbChevron2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                       Foreground="#6A6A72" VerticalAlignment="Center" Margin="6,0" Visibility="Collapsed"/>
            <Button x:Name="BtnCrumbSubAction" Click="BtnCrumbSubAction_Click" Height="40"
                    Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0"
                    Visibility="Collapsed" Template="{StaticResource CrumbCardTemplate}">
                <TextBlock x:Name="TxtCrumbSubActionName" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource K2TextBrush}"/>
            </Button>
        </StackPanel>

        <ComboBox  Grid.Row="2" x:Name="CbType" Visibility="Collapsed"
                   SelectionChanged="CbType_SelectionChanged">
            <ComboBoxItem Content="{loc:Get act_none}"                  Tag="none"/>
            <ComboBoxItem Content="{loc:Get act_disable}"           Tag="disable"/>
            <ComboBoxItem Content="{loc:Get act_url}"              Tag="url"/>
            <ComboBoxItem Content="{loc:Get act_exec}"   Tag="exec"/>
            <ComboBoxItem Content="{loc:Get act_folder}"           Tag="folder"/>
            <ComboBoxItem Content="{loc:Get act_page}"             Tag="dp_folder"/>
            <ComboBoxItem Content="{loc:Get act_browser}"          Tag="browser"/>
            <ComboBoxItem Content="{loc:Get act_profile}"        Tag="profile"/>
            <ComboBoxItem Content="{loc:Get act_oscmd}"        Tag="oscmd"/>
            <ComboBoxItem Content="{loc:Get act_media}"             Tag="media"/>
            <ComboBoxItem Content="{loc:Get act_mouse}"          Tag="mouse"/>
            <ComboBoxItem Content="{loc:Get act_keys}"   Tag="keys"/>
            <ComboBoxItem Content="{loc:Get act_hotkeyswitch}"     Tag="hotkeyswitch"/>
            <ComboBoxItem Content="{loc:Get act_multi}"            Tag="multi"/>
            <ComboBoxItem Content="{loc:Get act_command}"         Tag="command"/>
            <ComboBoxItem Content="{loc:Get act_text}"            Tag="text"/>
            <ComboBoxItem Content="{loc:Get act_emoji}"           Tag="emoji"/>
            <ComboBoxItem Content="{loc:Get act_emojibrowser}"    Tag="dp_emojibrowser"/>
            <ComboBoxItem Content="{loc:Get act_dp_clock}"        Tag="dp_clock"/>
            <ComboBoxItem Content="{loc:Get act_dp_sysmon}"       Tag="dp_sysmon"/>
            <ComboBoxItem Content="{loc:Get act_dp_speedtest}"    Tag="dp_speedtest"/>
            <ComboBoxItem Content="{loc:Get act_macro}"            Tag="macro"/>
            <ComboBoxItem Content="{loc:Get act_googlehome}"       Tag="googlehome"/>
            <ComboBoxItem Content="{loc:Get act_adobe}"            Tag="adobe"/>
            <ComboBoxItem Content="{loc:Get act_davinci}"          Tag="davinci"/>
            <ComboBoxItem Content="{loc:Get act_zoom}"             Tag="zoom"/>
            <ComboBoxItem Content="{loc:Get act_obs}"              Tag="obs"/>
            <ComboBoxItem Content="{loc:Get act_twitch}"           Tag="twitch"/>
            <ComboBoxItem Content="{loc:Get act_spotify}"          Tag="spotify"/>
            <ComboBoxItem Content="{loc:Get act_discord}"          Tag="discord"/>
            <ComboBoxItem Content="{loc:Get act_audiodevice}"      Tag="audiodevice"/>
            <ComboBoxItem Content="{loc:Get act_youtube}"          Tag="youtube"/>
            <ComboBoxItem Content="{loc:Get act_pyscript}"         Tag="pyscript"/>
        </ComboBox>

        <!-- Content area: standard panel OR Python Script panel. Hidden as a whole while
             the inline type picker (PickerPanel, same Grid.Row) is showing. -->
        <Grid x:Name="ConfigPanels" Grid.Row="3" Margin="0,12,0,0">

            <!-- Standard panel (all types except pyscript) -->
            <Grid x:Name="StandardPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="LblPayload" Grid.Row="0" Text="{loc:Get dlg_value}" Margin="0,0,0,4"/>
                <TextBox   x:Name="TxtPayload" Grid.Row="1"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto"
                           FontFamily="Consolas"
                           MinHeight="60"/>
            </Grid>

            <!-- Open program / file panel -->
            <Grid x:Name="ExecPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Get exec_path_label}" Margin="0,0,0,4"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="32" Height="32" Margin="0,0,8,0"
                            VerticalAlignment="Center" Background="#22222A" CornerRadius="4">
                        <Image x:Name="ImgExecIcon" Width="24" Height="24" Stretch="Uniform"/>
                    </Border>
                    <TextBox x:Name="TxtExecPath" Grid.Column="1" Height="25"
                             VerticalContentAlignment="Center"
                             FontFamily="Consolas"
                             TextChanged="TxtExecPath_TextChanged"/>
                    <Button  x:Name="BtnExecBrowse" Grid.Column="2"
                             Content="{loc:Get browse}" Padding="10,2" Margin="6,0,0,0"
                             Click="BtnExecBrowse_Click"/>
                </Grid>

                <TextBlock Grid.Row="2" Text="{loc:Get recent_paths}" Margin="0,0,0,4" Foreground="#9A9AA2"/>
                <ListBox x:Name="LstExecRecent" Grid.Row="3"
                         ItemContainerStyle="{StaticResource RecentPathItemStyle}"
                         SelectionChanged="LstExecRecent_SelectionChanged">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{StaticResource K2SurfaceDarkBrush}"
                                    BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="1"
                                    CornerRadius="4">
                                <ScrollViewer Padding="2" CanContentScroll="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="RowRoot">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                           Foreground="{StaticResource K2TextBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                <Button x:Name="BtnRemove" Grid.Column="1" Padding="6,2"
                                        FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE74D;"
                                        Background="Transparent" BorderThickness="0" Foreground="#B0B0B8"
                                        Cursor="Hand" Opacity="0" IsHitTestVisible="False"
                                        ToolTip="{loc:Get remove_recent}"
                                        Click="BtnExecRecentRemove_Click" Tag="{Binding}"/>
                            </Grid>
                            <!-- Opacity (not Visibility) so the button always reserves its layout
                                 space — toggling Visibility made the row grow taller on hover
                                 (button chrome is taller than the plain text row), a jarring
                                 per-row resize effect. -->
                            <DataTemplate.Triggers>
                                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnRemove" Property="Opacity" Value="1"/>
                                    <Setter TargetName="BtnRemove" Property="IsHitTestVisible" Value="True"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Open folder panel -->
            <Grid x:Name="FolderPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Get folder_path_label}" Margin="0,0,0,4"/>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtFolderPath" Grid.Column="0" Height="25"
                             VerticalContentAlignment="Center"
                             FontFamily="Consolas"/>
                    <Button  x:Name="BtnFolderBrowse" Grid.Column="1"
                             Content="{loc:Get browse}" Padding="10,2" Margin="6,0,0,0"
                             Click="BtnFolderBrowse_Click"/>
                </Grid>

                <TextBlock Grid.Row="2" Text="{loc:Get recent_paths}" Margin="0,0,0,4" Foreground="#9A9AA2"/>
                <ListBox x:Name="LstFolderRecent" Grid.Row="3"
                         ItemContainerStyle="{StaticResource RecentPathItemStyle}"
                         SelectionChanged="LstFolderRecent_SelectionChanged">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{StaticResource K2SurfaceDarkBrush}"
                                    BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="1"
                                    CornerRadius="4">
                                <ScrollViewer Padding="2" CanContentScroll="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="RowRoot">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"
                                           Foreground="{StaticResource K2TextBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                <Button x:Name="BtnRemove" Grid.Column="1" Padding="6,2"
                                        FontFamily="Segoe MDL2 Assets" FontSize="13" Content="&#xE74D;"
                                        Background="Transparent" BorderThickness="0" Foreground="#B0B0B8"
                                        Cursor="Hand" Opacity="0" IsHitTestVisible="False"
                                        ToolTip="{loc:Get remove_recent}"
                                        Click="BtnFolderRecentRemove_Click" Tag="{Binding}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="RowRoot" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnRemove" Property="Opacity" Value="1"/>
                                    <Setter TargetName="BtnRemove" Property="IsHitTestVisible" Value="True"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- DisplayPad page (sub-navigation) panel -->
            <Grid x:Name="PagePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Get page_pick_label}" Margin="0,0,0,4"/>
                <ComboBox  x:Name="CbPage" Grid.Row="1" Margin="0,0,0,10"
                           SelectionChanged="CbPage_SelectionChanged"/>

                <TextBlock Grid.Row="2" Text="{loc:Get page_name_label}" Margin="0,0,0,4"/>
                <TextBox   x:Name="TxtPageName" Grid.Row="3" Height="25" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Open browser panel -->
            <Grid x:Name="BrowserPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="PnlBrowserChoices" Grid.Row="0" Margin="0,0,0,4"/>

                <RadioButton x:Name="RbBrowserOther" Grid.Row="1" Content="{loc:Get browser_other}"
                             GroupName="BrowserChoice" Margin="0,2,0,6" Checked="BrowserChoice_Changed"/>

                <Grid Grid.Row="2" Margin="18,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtBrowserOtherPath" Grid.Column="0" Height="25"
                             VerticalContentAlignment="Center" FontFamily="Consolas"/>
                    <Button  x:Name="BtnBrowserOtherBrowse" Grid.Column="1"
                             Content="{loc:Get browse}" Padding="10,2" Margin="6,0,0,0"
                             Click="BtnBrowserOtherBrowse_Click"/>
                </Grid>

                <TextBlock Grid.Row="3" Text="{loc:Get browser_url_label}" Margin="0,0,0,4"/>
                <TextBox   x:Name="TxtBrowserUrl" Grid.Row="4" Height="25" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Switch profile panel -->
            <Grid x:Name="ProfilePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Get profile_targets_label}" Margin="0,0,0,6"/>

                <StackPanel x:Name="PnlProfileRows" Grid.Row="1"/>

                <Button x:Name="BtnProfileAddRow" Grid.Row="2" Content="{loc:Get profile_add_target}"
                        HorizontalAlignment="Left" Padding="10,4" Margin="0,6,0,0"
                        Click="BtnProfileAddRow_Click"/>
            </Grid>

            <!-- Simple selector panel (system command / media key / mouse action / macro / Google Home / OBS) -->
            <Grid x:Name="ComboPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- The value itself is now picked via the breadcrumb's 3rd crumb (see
                     ButtonActionDialog.TypePicker.cs) — Label+ComboBox stay in the tree
                     (Collapsed) as CbComboValue is still the source of truth every handler
                     below (arg textbox/list, save) reads from. -->
                <TextBlock x:Name="LblComboPanel" Grid.Row="0" Margin="0,0,0,4" Visibility="Collapsed"/>
                <ComboBox  x:Name="CbComboValue" Grid.Row="1" Visibility="Collapsed"
                           SelectionChanged="CbComboValue_SelectionChanged"/>
                <TextBox   x:Name="TxtComboArg" Grid.Row="2" Height="25" Margin="0,8,0,0"
                           Visibility="Collapsed" ToolTip="{loc:Get obs_arg_hint}"/>
                <ComboBox  x:Name="CbComboArgList" Grid.Row="2" Margin="0,8,0,0" IsEditable="True"
                           Visibility="Collapsed" ToolTip="{loc:Get obs_arg_hint}"/>
                <Button    x:Name="BtnGhManage" Grid.Row="3" Margin="0,8,0,0"
                           Content="{loc:Get gh_manage}" HorizontalAlignment="Left"
                           Visibility="Collapsed" Click="BtnGhManage_Click"/>
                <Button    x:Name="BtnObsSettings" Grid.Row="3" Margin="0,8,0,0"
                           Content="{loc:Get obs_settings_button}" HorizontalAlignment="Left"
                           Visibility="Collapsed" Click="BtnObsSettings_Click"/>
                <Button    x:Name="BtnTwitchSettings" Grid.Row="3" Margin="0,8,0,0"
                           Content="{loc:Get twitch_settings_button}" HorizontalAlignment="Left"
                           Visibility="Collapsed" Click="BtnTwitchSettings_Click"/>
                <Button    x:Name="BtnSpotifySettings" Grid.Row="3" Margin="0,8,0,0"
                           Content="{loc:Get spotify_settings_button}" HorizontalAlignment="Left"
                           Visibility="Collapsed" Click="BtnSpotifySettings_Click"/>
                <Button    x:Name="BtnDiscordSettings" Grid.Row="3" Margin="0,8,0,0"
                           Content="{loc:Get discord_settings_button}" HorizontalAlignment="Left"
                           Visibility="Collapsed" Click="BtnDiscordSettings_Click"/>
                <Button    x:Name="BtnAudioDeviceRefresh" Grid.Row="3" Margin="0,8,0,0"
                           Content="{loc:Get audiodevice_refresh_button}" HorizontalAlignment="Left"
                           Visibility="Collapsed" Click="BtnAudioDeviceRefresh_Click"/>
            </Grid>

            <!-- Keys panel -->
            <Grid x:Name="KeysPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Get keys_modifiers_label}" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox x:Name="ChkKeyCtrl"  Content="Ctrl"  Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkKeyShift" Content="Shift" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkKeyAlt"   Content="Alt"   Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkKeyWin"   Content="Win"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="{loc:Get keys_key_label}" Margin="0,0,0,4"/>
                <ComboBox  x:Name="CbKeyValue" Grid.Row="3" IsEditable="True"/>

                <TextBlock Grid.Row="4" Margin="0,8,0,0"
                           TextWrapping="Wrap" Foreground="#9A9AA2"
                           Text="{loc:Get keys_win_hint}"/>
            </Grid>

            <!-- Hotkey Switch panel: two shortcuts, alternated on successive presses -->
            <Grid x:Name="HotkeySwitchPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Get hotkey_shortcut_a}" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox x:Name="ChkHkACtrl"  Content="Ctrl"  Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkHkAShift" Content="Shift" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkHkAAlt"   Content="Alt"   Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkHkAWin"   Content="Win"/>
                </StackPanel>
                <ComboBox  x:Name="CbHkAValue" Grid.Row="2" IsEditable="True" Margin="0,0,0,14"/>

                <TextBlock Grid.Row="3" Text="{loc:Get hotkey_shortcut_b}" FontWeight="Bold" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
                    <CheckBox x:Name="ChkHkBCtrl"  Content="Ctrl"  Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkHkBShift" Content="Shift" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkHkBAlt"   Content="Alt"   Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkHkBWin"   Content="Win"/>
                </StackPanel>
                <ComboBox  x:Name="CbHkBValue" Grid.Row="5" IsEditable="True"/>

                <TextBlock Grid.Row="7" Margin="0,8,0,0"
                           TextWrapping="Wrap" Foreground="#9A9AA2"
                           Text="{loc:Get hotkey_hint}"/>
            </Grid>

            <!-- Multi Action panel: an ordered chain of sub-actions, each with its own delay -->
            <Grid x:Name="MultiPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{loc:Get multi_steps_label}" Margin="0,0,0,4"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlMultiSteps"/>
                </ScrollViewer>
                <Button x:Name="BtnMultiAddStep" Grid.Row="2" Content="{loc:Get multi_add_step}"
                        HorizontalAlignment="Left" Padding="10,4" Margin="0,6,0,0"
                        Click="BtnMultiAddStep_Click"/>
            </Grid>

            <!-- Adobe / DaVinci Resolve / Zoom shared panel: app-specific shortcut editor.
                 App/Action combos are a reference aid only (Base Camp has no default shortcut
                 for Adobe/DaVinci actions) except Zoom, whose picks autofill the shortcut. -->
            <Grid x:Name="AppShortcutPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblAppShortcutApp" Grid.Row="0" Text="{loc:Get appshortcut_app_label}" Margin="0,0,0,4"/>
                <ComboBox  x:Name="CbAppShortcutApp" Grid.Row="1" Margin="0,0,0,10"
                           SelectionChanged="CbAppShortcutApp_SelectionChanged"/>

                <TextBlock Grid.Row="2" Text="{loc:Get appshortcut_action_label}" Margin="0,0,0,4"/>
                <ComboBox  x:Name="CbAppShortcutAction" Grid.Row="3" Margin="0,0,0,14"
                           SelectionChanged="CbAppShortcutAction_SelectionChanged"/>

                <TextBlock Grid.Row="4" Text="{loc:Get keys_modifiers_label}" Margin="0,0,0,4"/>
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
                    <CheckBox x:Name="ChkAppCtrl"  Content="Ctrl"  Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkAppShift" Content="Shift" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkAppAlt"   Content="Alt"   Margin="0,0,16,0"/>
                    <CheckBox x:Name="ChkAppWin"   Content="Win"/>
                </StackPanel>
                <ComboBox  x:Name="CbAppValue" Grid.Row="6" IsEditable="True"/>
            </Grid>

            <!-- Emoji panel: a preview of the picked emoji + the browser button. The emoji is
                 typed into the focused app on press; on a display key it also becomes the key
                 picture (see EmojiGlyphRenderer). -->
            <Grid x:Name="EmojiPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="72" Height="72" Background="#1A1A1E"
                            BorderBrush="#333" BorderThickness="1" CornerRadius="13">
                        <Image x:Name="ImgEmojiPreview" Width="52" Height="52"/>
                    </Border>
                    <TextBlock x:Name="LblEmojiName" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="{loc:Get emoji_none_selected}" Foreground="#CCC"
                               TextWrapping="Wrap" MaxWidth="330"/>
                </StackPanel>

                <Button Grid.Row="1" x:Name="BtnPickEmoji"
                        Content="{loc:Get emoji_choose_button}"
                        HorizontalAlignment="Left" Padding="10,4"
                        Click="BtnPickEmoji_Click"/>

                <TextBlock Grid.Row="2" Margin="0,12,0,0"
                           TextWrapping="Wrap" Foreground="#9A9AA2"
                           Text="{loc:Get emoji_hint}"/>
            </Grid>

            <!-- Youtube panel: just a chat-message textbox (the only real action) + Manage button -->
            <Grid x:Name="YoutubePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{loc:Get youtube_chat_message_label}" Margin="0,0,0,4"/>
                <TextBox   x:Name="TxtYoutubeMessage" Grid.Row="1" Height="25" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                <Button    x:Name="BtnYoutubeSettings" Grid.Row="2"
                           Content="{loc:Get youtube_settings_button}" HorizontalAlignment="Left"
                           Padding="10,4" Click="BtnYoutubeSettings_Click"/>
            </Grid>

            <!-- Python Script panel -->
            <Grid x:Name="PyPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="RbFile"   Content=".py File"
                                 GroupName="PyMode" Margin="0,0,18,0"
                                 Checked="PyMode_Changed"/>
                    <RadioButton x:Name="RbInline" Content="{loc:Get py_inline}"
                                 GroupName="PyMode"
                                 Checked="PyMode_Changed"/>
                </StackPanel>

                <!-- File mode: path + Browse -->
                <Grid x:Name="PathRow" Grid.Row="1" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPath" Grid.Column="0" Height="25"
                             VerticalContentAlignment="Center"
                             FontFamily="Consolas"/>
                    <Button  x:Name="BtnBrowse" Grid.Column="1"
                             Content="{loc:Get py_browse}" Padding="10,2" Margin="6,0,0,0"
                             Click="BtnBrowse_Click"/>
                </Grid>

                <!-- Inline mode: code editor -->
                <TextBox x:Name="TxtCode" Grid.Row="2"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" MinHeight="80"/>

                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Get py_args}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox   x:Name="TxtArgs" Grid.Column="1" Height="25"
                               FontFamily="Consolas"
                               VerticalContentAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="4" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Get py_timeout}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox   x:Name="TxtTimeout" Grid.Column="1" Width="70" Height="25"
                               Text="60" VerticalContentAlignment="Center"/>
                </Grid>

                <TextBlock Grid.Row="5" Margin="0,8,0,0"
                           TextWrapping="Wrap" Foreground="#9A9AA2"
                           Text="{loc:Get py_hint}"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Get cancel}" Width="90" Padding="6,2"  Click="BtnCancel_Click"/>
            <Button Content="{loc:Get save}"   Width="90" Padding="6,2" Margin="8,0,0,0"
                    IsDefault="True"  Click="BtnSave_Click"/>
        </StackPanel>

        <!-- Type picker, INLINE in the dialog's own content row (same Grid.Row as
             ConfigPanels above, shown instead of it — not a floating overlay/second popup):
             category cards (level 1) -> action cards (level 2) -> sub-action cards (level 3).
             Replaces CbType/CbComboValue's native dropdowns. See ButtonActionDialog.TypePicker.cs. -->
        <Grid x:Name="PickerPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnPickerBack" Grid.Column="0" Content="&#xE72B;"
                                FontFamily="Segoe MDL2 Assets" FontSize="15"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource K2TextBrush}"
                                Cursor="Hand" Padding="6,2" Margin="0,0,10,0"
                                ToolTip="{loc:Get picker_back}" Visibility="Collapsed"
                                Click="BtnPickerBack_Click"/>
                        <TextBlock x:Name="LblPickerTitle" Grid.Column="1" Text="{loc:Get picker_pick_category}"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnPickerClose" Grid.Column="2" Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets" FontSize="13"
                                Background="Transparent" BorderThickness="0" Foreground="#9A9AA2"
                                Cursor="Hand" Padding="6,2" Click="BtnPickerClose_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <!-- Top-aligned: without it the ScrollViewer stretches this Grid to
                             the full viewport height and the UniformGrid inside splits that
                             height evenly across its rows, leaving a big gap between card
                             rows whenever the grid is shorter than the dialog. -->
                        <Grid VerticalAlignment="Top">
                            <ItemsControl x:Name="IcPickerCategories">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="ItemBtn" Click="CategoryCard_Click" Tag="{Binding Key}"
                                                Cursor="Hand" Margin="4" Height="88"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Template="{StaticResource PickerCardTemplate}">
                                            <Grid>
                                                <TextBlock Text="{Binding Glyph}" FontSize="20"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                           Margin="0,0,10,8"/>
                                                <TextBlock x:Name="TxtName" Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource K2TextBrush}"
                                                           Margin="12,8,8,8" TextWrapping="Wrap"
                                                           VerticalAlignment="Top"/>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="ItemBtn" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TxtName" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="IcPickerActions" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="ItemBtn" Click="ActionCard_Click" Tag="{Binding Tag}"
                                                Cursor="Hand" Margin="4" Height="88"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Template="{StaticResource PickerCardTemplate}">
                                            <Grid>
                                                <TextBlock Text="{Binding Glyph}" FontSize="20"
                                                           Visibility="{Binding GlyphVisibility}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                           Margin="0,0,10,8"/>
                                                <Path Data="{Binding IconPathData}" Fill="{Binding IconColor}"
                                                      Stretch="Uniform"
                                                      Width="{Binding IconWidth}" Height="{Binding IconHeight}"
                                                      Visibility="{Binding IconVisibility}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                      Margin="0,0,10,8"/>
                                                <Image Source="{Binding IconImageUri}"
                                                       Width="{Binding IconWidth}" Height="{Binding IconHeight}"
                                                       Stretch="Uniform"
                                                       Visibility="{Binding ImageVisibility}"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       Margin="0,0,10,8"/>
                                                <TextBlock x:Name="TxtName" Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource K2TextBrush}"
                                                           Margin="12,8,8,8" TextWrapping="Wrap"
                                                           VerticalAlignment="Top"/>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="ItemBtn" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TxtName" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl x:Name="IcPickerSubActions" Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="ItemBtn" Click="SubActionCard_Click" Tag="{Binding Value}"
                                                Cursor="Hand" Margin="4" Height="88"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Template="{StaticResource PickerCardTemplate}">
                                            <Grid>
                                                <TextBlock Text="{Binding Glyph}" FontSize="20"
                                                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                           Margin="0,0,10,8"/>
                                                <TextBlock x:Name="TxtName" Text="{Binding Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource K2TextBrush}"
                                                           Margin="12,8,8,8" TextWrapping="Wrap"
                                                           VerticalAlignment="Top"/>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="ItemBtn" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TxtName" Property="Foreground" Value="White"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
        </Grid>
    </Grid>
</Window>
