<Window x:Class="K2.Core.DiscordSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core"
        Title="{loc:Get discord_settings_title}"
        Width="480" Height="580"
        MinWidth="400" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{DynamicResource K2WindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Get discord_settings_title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="{loc:Get discord_hint}" TextWrapping="Wrap" Foreground="#9A9AA2" Margin="0,0,0,8"/>

        <!-- RichTextBox, not a TextBlock: the setup guide must be selectable/copyable AND
             carry a clickable link to the developer portal (a WPF TextBlock can do neither).
             Read-only + transparent + borderless so it still reads as plain text. The document
             itself is built in code-behind (see BuildGuideDocument) from the localized string. -->
        <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <RichTextBox x:Name="RtbDiscordGuide" IsReadOnly="True" IsDocumentEnabled="True"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="#C7C7CE" FontSize="12"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
        </Border>

        <TextBlock Grid.Row="3" Text="{loc:Get discord_client_id_label}" Margin="0,0,0,4"/>
        <TextBox   x:Name="TxtDiscordClientId" Grid.Row="4" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="5" Text="{loc:Get discord_client_secret_label}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PwdDiscordClientSecret" Grid.Row="6" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="7" Text="{loc:Get discord_webhook_label}" Margin="0,0,0,4"/>
        <TextBox   x:Name="TxtDiscordWebhook" Grid.Row="8" Height="25" Margin="0,0,0,4" VerticalContentAlignment="Center"/>
        <TextBlock Grid.Row="9" Text="{loc:Get discord_webhook_hint}" TextWrapping="Wrap"
                   Foreground="#9A9AA2" FontSize="11" Margin="0,0,0,10"/>

        <!-- The webcam shortcut used to sit here (row 11); it moved to DiscordProfileConfigWindow
             alongside the voice-page return timer, since both are voice-page settings, not part of
             connecting the account. Row 11 stays as the "*" spacer it always was. -->

        <TextBlock x:Name="TxtDiscordStatus" Grid.Row="10" TextWrapping="Wrap" Foreground="#9A9AA2" Margin="0,0,0,4"/>

        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Get discord_disconnect}" Padding="10,4" Margin="0,0,8,0" Click="BtnDiscordDisconnect_Click"/>
            <Button Content="{loc:Get discord_connect}" Padding="10,4" Margin="0,0,8,0" Click="BtnDiscordConnect_Click"/>
            <Button Content="{loc:Get save}" Width="90" Padding="6,2" IsDefault="True" Click="BtnDiscordSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
