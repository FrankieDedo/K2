<ResourceDictionary x:Class="K2.Core.Themes.K2Theme"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:themes="clr-namespace:K2.Core.Themes"
                    xmlns:converters="clr-namespace:K2.Core.Converters">

    <converters:UpperCaseConverter x:Key="UpperCaseConverter"/>

    <!-- ============================================================
         K2 — Shared dark theme (DisplayPad / MacroPad / Everest).
         "Peripheral app" style: flat dark surfaces, teal accent
         #900000, rounded corners, custom title bar.
         Lives in K2.Core: each app merges it in its App.xaml via
         pack URI. The title bar uses WindowChrome + 3 caption
         buttons, handled by the code-behind K2Theme.xaml.cs.
         ============================================================ -->

    <!-- ===== Palette ===== -->
    <SolidColorBrush x:Key="K2BgBrush"          Color="#1A1A1E"/>
    <SolidColorBrush x:Key="K2SurfaceBrush"     Color="#1F1F24"/>
    <SolidColorBrush x:Key="K2SurfaceAltBrush"  Color="#26262C"/>
    <SolidColorBrush x:Key="K2SurfaceDarkBrush" Color="#141417"/>
    <SolidColorBrush x:Key="K2HoverBrush"       Color="#2E2E36"/>
    <SolidColorBrush x:Key="K2BorderBrush"      Color="#34343C"/>
    <SolidColorBrush x:Key="K2BorderStrongBrush" Color="#45454F"/>
    <SolidColorBrush x:Key="K2TextBrush"        Color="#E8E8EA"/>
    <SolidColorBrush x:Key="K2TextMutedBrush"   Color="#9A9AA2"/>
    <SolidColorBrush x:Key="K2TextDimBrush"     Color="#6E6E76"/>
    <SolidColorBrush x:Key="K2AccentBrush"      Color="#900000"/>
    <SolidColorBrush x:Key="K2AccentHoverBrush" Color="#B22222"/>
    <SolidColorBrush x:Key="K2AccentDimBrush"   Color="#5C0000"/>
    <SolidColorBrush x:Key="K2AccentTextBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="K2DangerBrush"      Color="#C7402F"/>

    <!-- ===== App-wide UI font (Settings > Font) =====
         Default = Roboto (embedded, see K2.Core/Fonts/LICENSE.Roboto.txt).
         Overridden at runtime by FontCatalog.Apply (K2.Core/Services) whenever
         the user picks a different font in Settings — it sets this same key on
         Application.Current.Resources, which every window's K2WindowStyle below
         picks up live via DynamicResource (no restart). See AppSettings.AppFontFamily. -->
    <FontFamily x:Key="K2AppFontFamily">pack://application:,,,/K2.Core;component/Fonts/#Roboto, Segoe UI</FontFamily>

    <!-- Base UI text size, same idea as K2AppFontFamily above: most control
         styles below set FontSize explicitly (they don't just inherit it from
         Window), so this single DynamicResource is what every one of them
         references — FontCatalog.Apply overrides it per font (e.g. smaller for
         OpenDyslexic, whose glyphs render noticeably larger than other fonts at
         the same nominal size). Icon glyphs (Segoe MDL2 Assets, FontSize 10/12/15
         elsewhere in this file) are deliberately NOT wired to this — they're
         unrelated to the selected text font. -->
    <sys:Double x:Key="K2AppFontSize">13</sys:Double>

    <!-- ===== Title bar buttons ===== -->
    <Style x:Key="K2CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource K2TextMutedBrush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K2CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource K2CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2DangerBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Accent button (primary action) ===== -->
    <Style x:Key="K2AccentButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource K2AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource K2AccentTextBrush}"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Icon button (Tag = Segoe MDL2 Assets glyph) =====
         Allows `<Button Style="{StaticResource K2IconButton}"
                          Tag="&#xE72C;" Content="Refresh"/>`.
         Advantage over an inline StackPanel: `Content` remains a
         string, so code-behind can replace it at runtime
         (e.g. "Cancel" / "Remap") without losing the glyph. -->
    <Style x:Key="K2IconButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource K2SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource K2BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2SurfaceDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K2IconAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource K2AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource K2AccentTextBrush}"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Margin="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Small color-square swatch (border/side-LED pickers) =====
         The plain Button style below (K2Theme's implicit TargetType="Button") bakes
         a fixed CornerRadius="7" into its template, which looks fine on the ~30px
         color-picker swatches (BtnEvColor1/BtnCustomBrushColor/...) but turns into a
         near-circle on the small ~12px per-LED border squares (BuildBorderSquares'
         PlaceEdge in MainWindow.CustomLighting.cs, and its Everest 60 mirror) since
         radius 7 is already more than half of a 12px side. This style uses a radius
         proportioned to that small size instead, so those squares read as "rounded
         squares" like every other color picker in the app, not blobs. -->
    <Style x:Key="K2ColorSquareButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource K2BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="3"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider: parts ===== -->
    <Style x:Key="K2SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="e" Fill="{DynamicResource K2AccentBrush}"
                             Stroke="{StaticResource K2BgBrush}" StrokeThickness="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="e" Property="Fill" Value="{DynamicResource K2AccentHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K2SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource K2AccentBrush}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K2SliderEmpty" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar: parts ===== -->
    <Style x:Key="K2ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="K2ScrollThumb" TargetType="Thumb">
        <Setter Property="MinWidth" Value="24"/>
        <Setter Property="MinHeight" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" Background="{StaticResource K2BorderStrongBrush}"
                            CornerRadius="3" Margin="2"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{StaticResource K2TextMutedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="K2VScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource K2ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource K2ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource K2ScrollThumb}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="K2HScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource K2ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource K2ScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource K2ScrollThumb}"/>
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="11"/>
        <Setter Property="Template" Value="{StaticResource K2VScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="11"/>
                <Setter Property="Template" Value="{StaticResource K2HScrollBarTemplate}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== ComboBox: toggle button ===== -->
    <ControlTemplate x:Key="K2ComboToggleTemplate" TargetType="ToggleButton">
        <Border x:Name="bd" CornerRadius="7"
                Background="{StaticResource K2SurfaceAltBrush}"
                BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="1">
            <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,9,0" Data="M0,0 L8,0 L4,5 Z"
                  Fill="{StaticResource K2TextMutedBrush}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                <Setter TargetName="arrow" Property="Fill" Value="{DynamicResource K2AccentBrush}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===== Standard button ===== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource K2SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource K2BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="25"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2SurfaceDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Template="{StaticResource K2ComboToggleTemplate}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}"/>
                        <ContentPresenter x:Name="ContentSite" Margin="11,0,28,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          IsHitTestVisible="False"/>
                        <!-- Required part name for IsEditable="True" ComboBoxes (CbKeyValue,
                             CbAppValue, etc.) - without it WPF has nowhere to display the
                             typed/parsed Text, so the closed box shows blank even though the
                             matching item is correctly selected/highlighted in the dropdown. -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Margin="11,0,28,0" Padding="0"
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 FontSize="{TemplateBinding FontSize}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Visibility="Collapsed"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Slide"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource K2SurfaceBrush}"
                                    BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="1"
                                    CornerRadius="7" Margin="0,4,0,6"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260" Padding="3">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="Padding" Value="3,6"/>
        <Setter Property="MinHeight" Value="25"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentDimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBox ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource K2SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource K2BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource K2AccentBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource K2AccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="7"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource K2BorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2SurfaceDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== CheckBox ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="17" Height="17" CornerRadius="4"
                                Background="{StaticResource K2SurfaceAltBrush}"
                                BorderBrush="{StaticResource K2BorderStrongBrush}" BorderThickness="1.5"
                                VerticalAlignment="Center">
                            <Path x:Name="check" Stretch="Uniform" Margin="3"
                                  Data="M0,5 L4,9 L11,0"
                                  Stroke="{DynamicResource K2AccentTextBrush}" StrokeThickness="2"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Toggle row (icon + label + pill switch) =====
         A CheckBox re-skinned as a settings row: `Tag` carries a Segoe
         MDL2 Assets glyph (icon), `Content` the label, and the check
         state renders as a sliding pill switch on the right — used by
         the Everest Display Dial "show menu" grid. -->
    <Style x:Key="K2ToggleRow" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent" Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{TemplateBinding Tag}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{StaticResource K2TextMutedBrush}"
                                   VerticalAlignment="Center" Width="20" Margin="0,0,10,0"/>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        <Border x:Name="pill" Grid.Column="2" Width="36" Height="18" CornerRadius="9"
                                Background="{StaticResource K2SurfaceAltBrush}"
                                BorderBrush="{StaticResource K2BorderStrongBrush}" BorderThickness="1.5"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                            <Ellipse x:Name="knob" Width="12" Height="12"
                                     Fill="{StaticResource K2TextMutedBrush}"
                                     HorizontalAlignment="Left" Margin="1,0,0,0"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,1,0"/>
                            <Setter TargetName="knob" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inline switch (pill only, no icon/label columns) =====
         Compact CheckBox-as-toggle for inline use next to a label, unlike
         K2ToggleRow (icon+label+pill, sized to fill a full row) — e.g.
         "Backlight: <switch>" in the LED lighting panels. -->
    <Style x:Key="K2InlineSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="pill" Width="36" Height="18" CornerRadius="9"
                            Background="{StaticResource K2SurfaceAltBrush}"
                            BorderBrush="{StaticResource K2BorderStrongBrush}" BorderThickness="1.5">
                        <Ellipse x:Name="knob" Width="12" Height="12"
                                 Fill="{StaticResource K2TextMutedBrush}"
                                 HorizontalAlignment="Left" Margin="1,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="pill" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="knob" Property="Margin" Value="0,0,1,0"/>
                            <Setter TargetName="knob" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== RadioButton ===== -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Ellipse x:Name="outer" StrokeThickness="1.5"
                                     Stroke="{StaticResource K2BorderStrongBrush}"
                                     Fill="{StaticResource K2SurfaceAltBrush}"/>
                            <Ellipse x:Name="dot" Width="7" Height="7"
                                     Fill="{DynamicResource K2AccentBrush}" Visibility="Collapsed"/>
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource K2AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outer" Property="Stroke" Value="{DynamicResource K2AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented button group ===== -->
    <!-- Alternative to ComboBox/CheckBox for a short (2-3) list of mutually
         exclusive options — e.g. "Angle snapping: Off/On", "Lift-off: Low/High".
         Wrap a UniformGrid Rows="1" of these RadioButtons (same GroupName) in a
         Border using K2SegmentedGroupBorder. The pill look comes from each edge
         button rounding its OWN inner Border via K2Segment.CornerRadius (set by
         the caller — SegmentedButtonGroup for dynamic groups, static XAML for
         fixed 2-way toggles), not from the group Border clipping its children:
         Border.ClipToBounds only clips to the plain rectangular layout bounds,
         not to CornerRadius, so a child's square corners paint right over a
         parent's rounded ones — a child rounding itself has no such problem. -->
    <Style x:Key="K2SegmentedGroupBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource K2SurfaceDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource K2BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Height" Value="28"/>
    </Style>
    <Style x:Key="K2SegmentedButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource K2TextMutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- WPF's default focus adorner is a plain dashed rectangle drawn in
             the AdornerLayer, above and unclipped by anything below it — an
             edge segment being clicked (which both checks it AND gives it
             keyboard focus) would otherwise square off its just-rounded
             corner. The checked red fill already indicates selection clearly,
             so the focus rect is redundant here; drop it. -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="0,0,1,0"
                            CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(themes:K2Segment.CornerRadius)}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource K2AccentTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Slider ===== -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource K2AccentBrush}"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource K2BorderBrush}"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource K2SliderFill}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource K2SliderEmpty}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource K2SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== GroupBox ===== -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{StaticResource K2SurfaceBrush}"
                            BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="1"
                            CornerRadius="9">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="13,9,13,7">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="{StaticResource K2TextMutedBrush}"
                                                  TextElement.FontSize="12"/>
                            </Border>
                            <Border Padding="8">
                                <ContentPresenter/>
                            </Border>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== StatusBar ===== -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{StaticResource K2SurfaceDarkBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource K2TextMutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBar">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="12,6">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ListView / GridView ===== -->
    <Style TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource K2SurfaceDarkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource K2BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
    </Style>

    <!-- Plain ContentPresenter, NOT GridViewRowPresenter (2026-07-27 fix): every
         ListView in this app except the two MacroPad/DisplayPad debug device tables
         (LvDevices/LvDpDevices, which set ListView.View to a real GridView with
         columns and use K2GridViewListViewItem below instead) just sets a plain
         ItemTemplate with no GridView at all — GridViewRowPresenter measures itself
         against GridView.ColumnCollection, and with no columns to lay out against it
         collapses to a near-zero row height regardless of the ItemTemplate content's
         actual size. That's what made every such list (Makalu's Key Binding button
         list, confirmed; likely every other device's Key Binding list too, same
         style) render as unreadable 2-3px slivers.-->
    <Style TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentDimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- For the two ListViews that DO set View="{GridView ...}" with real columns
         (MainWindow.xaml's LvDevices/LvDpDevices debug device tables) — the ORIGINAL
         GridViewRowPresenter-based template, applied explicitly via
         ItemContainerStyle so it doesn't regress when the default ListViewItem style
         above switched to a plain ContentPresenter. -->
    <Style x:Key="K2GridViewListViewItem" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="Padding" Value="4,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentDimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource K2SurfaceAltBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource K2TextMutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="0,0,1,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Separator (vertical toolbar) ===== -->
    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Width="1" Height="20" Margin="6,0"
                            Background="{StaticResource K2BorderBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Separator (horizontal, for category dividers in vertical sidebars) ===== -->
    <Style x:Key="K2SideSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,6"
                            Background="{StaticResource K2BorderBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ContextMenu / MenuItem ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource K2SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource K2BorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="3">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4"
                            Background="{StaticResource K2BorderBrush}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TabControl / TabItem ===== -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,8"/>
                        <Border Grid.Row="1" Background="{StaticResource K2SurfaceBrush}"
                                BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter ContentSource="SelectedContent"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Device tab strip (2026-07-28): same graphic language as the per-device
         "SECTIONS" sidebar (SectionTabStyle above) — decorative corner triangle,
         bigger/white when selected, title pinned top-left instead of centered.
         Height doubled (31px -> 62px) to give the top-left title / bottom-right
         triangle layout room to breathe. Title text goes bold+italic+uppercase
         via the Style setters below + UpperCaseConverter on the Header binding
         (ContentSource="Header" doesn't support a Converter, so Content is bound
         explicitly instead) — non-string headers (TabHome's icon glyph) pass
         through the converter unchanged; TabHome's TextBlock pins its own
         FontWeight/FontStyle back to Normal so the inherited bold/italic here
         doesn't distort the icon font glyph. Horizontal padding restored to 23
         per side (2026-07-28 follow-ups: 15 -> 23 -> 0 -> 23). MinWidth=170
         added the same round (real bug, not a look-alike): with a tab sized
         tight to its own content, Left-aligned text and Center-aligned text
         render at the EXACT same spot (no slack space to tell them apart) —
         confirmed by testing, padding alone never fixed it regardless of its
         value. A MinWidth wider than typical content leaves visible empty
         space to the right of the text, which is what actually makes "Left"
         read as left instead of centered. TabHome (Tag="home") opts out of
         the sidebar look via the Tag trigger below — icon-only tab, no title
         to put top-left, so it keeps the original centered content and no
         corner triangle (MinWidth still applies but is harmless there since
         it's centered on purpose). -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource K2TextMutedBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Height" Value="62"/>
        <Setter Property="MinWidth" Value="170"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="bd" Background="{StaticResource K2SurfaceAltBrush}" CornerRadius="7"
                            Margin="0,0,4,0" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Polygon x:Name="CornerTriangle"
                                     Points="14,0 14,14 0,14"
                                     Fill="#54545E"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                     Margin="0,0,-2,-2"/>
                            <ContentPresenter x:Name="Cp"
                                              Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Header, Converter={StaticResource UpperCaseConverter}}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource K2AccentTextBrush}"/>
                            <Setter TargetName="CornerTriangle" Property="Points" Value="26,0 26,26 0,26"/>
                            <Setter TargetName="CornerTriangle" Property="Fill" Value="White"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="home">
                            <Setter TargetName="CornerTriangle" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Cp" Property="HorizontalAlignment" Value="Center"/>
                            <Setter TargetName="Cp" Property="VerticalAlignment" Value="Center"/>
                            <!-- Square, not a pill: override the shared MinWidth=170 (needed for
                                 the OTHER tabs' left-aligned title to have visible slack, per the
                                 2026-07-28 fix above) down to exactly Height, since Home carries no
                                 title text to make room for. -->
                            <Setter Property="MinWidth" Value="62"/>
                            <Setter Property="Width" Value="62"/>
                            <!-- The shared Padding="23,10" (23px each side) leaves only 16px of
                                 usable width in a 62px-square tab — the 20px icon glyph got
                                 squeezed and clipped by the Border's rounded-corner clip geometry.
                                 Home has no title to pad for, so drop it to 0; centering (above)
                                 does the rest. -->
                            <Setter Property="Padding" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Window: custom title bar (WindowChrome) =====
         NOTE: keyed (not implicit) because in WPF an implicit style on
         `Window` is not applied to derived classes (MainWindow,
         ErrorDialog, ...): WPF resolves implicit styles for the EXACT
         runtime type. Each Window XAML must therefore reference it:
             Style="{StaticResource K2WindowStyle}". -->
    <Style x:Key="K2WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource K2BgBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
        <!-- User-selectable app-wide font (Settings > Font, default Roboto — see
             K2AppFontFamily above and FontCatalog). Inherited by every descendant
             control that doesn't set its own FontFamily (e.g. KeyCapStyle's BC
             keycap replica, Consolas log/hex viewers, and the Segoe MDL2 Assets
             icon glyphs are intentionally untouched). DynamicResource (not
             StaticResource) is required: it's how FontCatalog.Apply changes the
             font live, without restarting the app. -->
        <Setter Property="FontFamily" Value="{DynamicResource K2AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource K2AppFontSize}"/>
        <!-- TextFormattingMode="Display" used to be set here (present since the
             initial commit, no documented reason) — it pixel-snaps glyph outlines
             using a GDI-compatible rasterizer: crisper for small static text, but
             it flattens hinting on bold/large text, making curved letterforms
             (E, R, O, ...) look jagged/"pixellated", e.g. the Home tile device
             titles. Removed so text falls back to WPF's default Ideal formatting
             (ClearType sub-pixel anti-aliasing), which renders curves far more
             smoothly at these sizes (2026-07-28). -->

        <!-- Replaces the SnapsToDevicePixels="True" that used to be scattered across
             ~10 button/combobox/textbox/groupbox/listviewitem styles below: that
             property pixel-snaps the ENTIRE rendered edge, which also flattens the
             anti-aliasing on every rounded Border corner (CornerRadius) and the
             device-tab corner triangle, producing the jagged/"pixellated" look
             reported 2026-07-28. UseLayoutRounding only pixel-aligns element
             position/size during layout — straight edges (1px borders) stay crisp,
             curves and diagonals keep their anti-aliased blend. Set once here since,
             unlike SnapsToDevicePixels, UseLayoutRounding DOES cascade to descendants. -->
        <Setter Property="UseLayoutRounding" Value="True"/>
        <!-- Same issue as the Home tile artwork (2026-07-28 follow-up, user request
             "applichi lo stesso fix anche alle immagini nella ui?"): most device board/
             keyboard/mouse graphics under Assets/ are shown at a fraction of their native
             resolution (e.g. everest60_board.png 2887x1084 down to a 504x186 Canvas, ~5.8x)
             — WPF's default (unspecified) scaling mode blurs a downscale that aggressive.
             RenderOptions.BitmapScalingMode, unlike SnapsToDevicePixels, DOES cascade to
             descendants, so setting it once here covers every Image/ImageBrush app-wide
             instead of annotating each one individually. -->
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                                    CornerRadius="0" GlassFrameThickness="0"
                                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="WindowBorder"
                            Background="{StaticResource K2BgBrush}"
                            BorderBrush="{StaticResource K2BorderBrush}" BorderThickness="1">
                        <Grid x:Name="LayoutRoot">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Background="{StaticResource K2SurfaceDarkBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            Margin="11,0,0,0" VerticalAlignment="Center">
                                    <Image Source="{TemplateBinding Icon}"
                                           Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{TemplateBinding Title}" Margin="9,0,0,0"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{StaticResource K2TextBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button x:Name="MinButton" Style="{StaticResource K2CaptionButton}"
                                            Content="&#xE921;" Click="OnMinimize"/>
                                    <Button x:Name="MaxButton" Style="{StaticResource K2CaptionButton}"
                                            Content="&#xE922;" Click="OnMaximizeRestore"/>
                                    <Button x:Name="CloseButton" Style="{StaticResource K2CaptionCloseButton}"
                                            Content="&#xE8BB;" Click="OnClose"/>
                                </StackPanel>
                            </Grid>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="LayoutRoot" Property="Margin" Value="7"/>
                            <Setter TargetName="MaxButton" Property="Content" Value="&#xE923;"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
