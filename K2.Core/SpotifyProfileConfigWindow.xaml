<Window x:Class="K2.Core.SpotifyProfileConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core"
        Title="{loc:Get spotify_profile_config_title}"
        Width="780" Height="620"
        MinWidth="740" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{DynamicResource K2WindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- content (two columns) -->
            <RowDefinition Height="Auto"/>   <!-- buttons -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>    <!-- 0 left: source / device / return -->
            <ColumnDefinition Width="24"/>   <!-- 1 gutter -->
            <ColumnDefinition Width="300"/>  <!-- 2 right: cover layout / position / long text -->
        </Grid.ColumnDefinitions>

        <!-- ===== LEFT COLUMN ===== -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0  title -->
                <RowDefinition Height="Auto"/>   <!-- 1  hint -->
                <RowDefinition Height="Auto"/>   <!-- 2  account button -->
                <RowDefinition Height="Auto"/>   <!-- 3  source label + hint icon -->
                <RowDefinition Height="Auto"/>   <!-- 4  source radios -->
                <RowDefinition Height="Auto"/>   <!-- 5  device label + hint icon -->
                <RowDefinition Height="Auto"/>   <!-- 6  device combo -->
                <RowDefinition Height="Auto"/>   <!-- 7  (spacer) -->
                <RowDefinition Height="Auto"/>   <!-- 8  return-to-profile row -->
                <RowDefinition Height="Auto"/>   <!-- 9  return-condition label + hint -->
                <RowDefinition Height="Auto"/>   <!-- 10 return-condition combo -->
                <RowDefinition Height="Auto"/>   <!-- 11 foreground-only row -->
                <RowDefinition Height="Auto"/>   <!-- 12 show-back-arrow row -->
                <RowDefinition Height="*"/>      <!-- 13 filler -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:Get spotify_profile_config_title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="{loc:Get spotify_profile_config_hint}" TextWrapping="Wrap" Foreground="#9A9AA2" Margin="0,0,0,12"/>

            <!-- Activation mode + account button. "On launch" keeps today's behaviour (the
                 foreground-only / return-timer sub-options below apply); "on select" makes the
                 Spotify profile an ordinary pick from the Dedicated list and hides those. -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <RadioButton x:Name="RbModeLaunch" GroupName="spmode" Margin="0,2"
                             Content="{loc:Get profile_mode_on_launch}" Checked="Mode_Changed"/>
                <RadioButton x:Name="RbModeSelect" GroupName="spmode" Margin="0,2"
                             Content="{loc:Get profile_mode_on_select}" Checked="Mode_Changed"/>
                <!-- Same window the "spotify" action combo opens: Client ID/Secret, Connect/Disconnect. -->
                <Button x:Name="BtnSpotifyAccount" Content="{loc:Get spotify_account_button}"
                        HorizontalAlignment="Left" Padding="12,5" Margin="0,4,0,0" Click="BtnSpotifyAccount_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{loc:Get spotify_source_label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Path Style="{DynamicResource K2HintIcon}" ToolTip="{loc:Get spotify_source_webapi_hint}"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Margin="0,0,0,4">
                <RadioButton x:Name="RbSourceLocal" GroupName="src" Content="{loc:Get spotify_source_local}" Margin="0,2"
                             Checked="Source_Changed"/>
                <RadioButton x:Name="RbSourceWebApi" GroupName="src" Content="{loc:Get spotify_source_webapi}" Margin="0,2"
                             Checked="Source_Changed"/>
            </StackPanel>

            <!-- Device picker: same combo/refresh pattern as a single key's own "spotify" action
                 (ButtonActionDialog), meaningful only for Web API — a "media" key has no device
                 concept at all, so this whole row hides while Source=Local. -->
            <StackPanel Grid.Row="5" x:Name="PnlSpotifyDevice" Orientation="Horizontal" Margin="0,14,0,4">
                <TextBlock Text="{loc:Get spotify_device_label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Path Style="{DynamicResource K2HintIcon}" ToolTip="{loc:Get spotify_device_hint}"/>
            </StackPanel>
            <StackPanel Grid.Row="6" x:Name="RowSpotifyDevice" Orientation="Horizontal" Margin="0,0,0,4">
                <ComboBox x:Name="CbSpotifyDevice" Width="260"/>
                <Button x:Name="BtnSpotifyDeviceRefresh" Content="{loc:Get refresh}"
                        Padding="10,2" Margin="6,0,0,0" Click="BtnSpotifyDeviceRefresh_Click"/>
            </StackPanel>
            <Border Grid.Row="7" Height="14"/>

            <!-- Same "come back on its own" pair the Discord voice page has, but per pad: it is the
                 cover tile's back arrow (DpSpotifyLeave) that arms it. -->
            <StackPanel Grid.Row="8" x:Name="PnlSpotifyReturn" Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="CkSpotifyReturn" Content="{loc:Get spotify_return_label}"
                          VerticalAlignment="Center" Checked="ReturnEnabled_Changed" Unchecked="ReturnEnabled_Changed"/>
                <TextBox x:Name="TxtSpotifyReturnSec" Width="52" Height="23" Margin="8,0,6,0"
                         VerticalContentAlignment="Center" TextAlignment="Center"
                         MaxLength="4" PreviewTextInput="DigitsOnly_PreviewTextInput"/>
                <TextBlock Text="{loc:Get unit_seconds}" VerticalAlignment="Center" Foreground="#9A9AA2"/>
                <Path Style="{DynamicResource K2HintIcon}" ToolTip="{loc:Get spotify_return_hint}"/>
            </StackPanel>

            <!-- Sub-condition of the return timer above: WHEN it's allowed to actually switch back,
                 not whether it counts down at all (user request 2026-09-01). -->
            <StackPanel Grid.Row="9" x:Name="PnlSpotifyReturnCond" Orientation="Horizontal" Margin="0,10,0,4">
                <TextBlock x:Name="LblSpotifyReturnCondition" Text="{loc:Get spotify_return_condition_label}"
                           FontSize="11" Foreground="#9A9AA2" VerticalAlignment="Center"/>
                <Path Style="{DynamicResource K2HintIcon}" ToolTip="{loc:Get spotify_return_condition_hint}"/>
            </StackPanel>
            <ComboBox Grid.Row="10" x:Name="CbSpotifyReturnCondition" Width="260" HorizontalAlignment="Left" Margin="0,0,0,4">
                <ComboBoxItem Content="{loc:Get spotify_return_condition_always}"/>
                <ComboBoxItem Content="{loc:Get spotify_return_condition_running}"/>
                <ComboBoxItem x:Name="CbiSpotifyReturnConditionReachable" Content="{loc:Get spotify_return_condition_reachable}"/>
            </ComboBox>

            <!-- Order swapped 2026-09-01 (user request) — Foreground-only now sits between the two
                 return-related toggles instead of after Show back arrow. -->
            <StackPanel Grid.Row="11" x:Name="PnlSpotifyForeground" Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="CkSpotifyForeground" Content="{loc:Get spotify_foreground_only_label}"
                          VerticalAlignment="Center"/>
                <Path Style="{DynamicResource K2HintIcon}" ToolTip="{loc:Get spotify_foreground_only_hint}"/>
            </StackPanel>

            <StackPanel Grid.Row="12" Orientation="Horizontal" Margin="0,14,0,0">
                <CheckBox x:Name="CkSpotifyBackArrow" Content="{loc:Get show_back_arrow_label}"
                          VerticalAlignment="Center"/>
                <Path Style="{DynamicResource K2HintIcon}" ToolTip="{loc:Get show_back_arrow_hint}"/>
            </StackPanel>
        </Grid>

        <!-- ===== RIGHT COLUMN ===== -->
        <StackPanel Grid.Row="0" Grid.Column="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="{loc:Get spotify_cover_layout_label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Path Style="{DynamicResource K2HintIcon}" ToolTip="{loc:Get spotify_cover_layout_single_hint}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,4">
                <RadioButton x:Name="RbLayoutQuad" GroupName="lay" Content="{loc:Get spotify_cover_layout_quad}" Margin="0,2"
                             Checked="Layout_Changed"/>
                <RadioButton x:Name="RbLayoutSingle" GroupName="lay" Content="{loc:Get spotify_cover_layout_single}" Margin="0,2"
                             Checked="Layout_Changed"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                <TextBlock Text="{loc:Get spotify_position_label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Path Style="{DynamicResource K2HintIcon}" ToolTip="{loc:Get spotify_position_hint}"/>
            </StackPanel>
            <ComboBox x:Name="CbSpotifyPosition" Width="160" HorizontalAlignment="Left" Margin="0,0,0,4">
                <ComboBoxItem Content="{loc:Get spotify_position_left}"/>
                <ComboBoxItem Content="{loc:Get spotify_position_center}"/>
                <ComboBoxItem Content="{loc:Get spotify_position_right}"/>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
                <TextBlock x:Name="LblTextMode" Text="{loc:Get spotify_text_mode_label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Path Style="{DynamicResource K2HintIcon}" ToolTip="{loc:Get spotify_text_mode_hint}"/>
            </StackPanel>
            <StackPanel x:Name="PnlTextMode" Margin="0,0,0,4">
                <RadioButton x:Name="RbTextStatic" GroupName="txt" Content="{loc:Get spotify_text_mode_static}" Margin="0,2"/>
                <RadioButton x:Name="RbTextMarquee" GroupName="txt" Content="{loc:Get spotify_text_mode_marquee}" Margin="0,2"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Button Style="{DynamicResource GuideBarButton}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Content="{loc:Get guide_button}" ToolTip="{loc:Get guide_tooltip}" Click="BtnGuide_Click"/>
            <Button Content="{loc:Get save}" Width="90" Padding="6,2" IsDefault="True"
                    HorizontalAlignment="Right" Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</Window>
