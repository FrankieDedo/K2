<Window x:Class="K2.Core.YouTubeSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core"
        Title="{loc:Get youtube_settings_title}"
        Width="460" Height="560"
        MinWidth="380" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{DynamicResource K2WindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Get youtube_settings_title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1" Text="{loc:Get youtube_hint}" TextWrapping="Wrap" Foreground="#9A9AA2" Margin="0,0,0,8"/>

        <!-- RichTextBox, not a TextBlock: the setup guide must be selectable/copyable AND
             carry clickable links to the developer portal (a WPF TextBlock can do neither).
             Read-only + transparent + borderless so it still reads as plain text. The document
             is built in code-behind (SetupGuide.BuildDocument) from the localized string. -->
        <Border Grid.Row="2" Background="#14FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <RichTextBox x:Name="RtbYtGuide" IsReadOnly="True" IsDocumentEnabled="True"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="#C7C7CE" FontSize="12"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
        </Border>

        <TextBlock Grid.Row="3" Text="{loc:Get youtube_client_id_label}" Margin="0,0,0,4"/>
        <TextBox   x:Name="TxtYtClientId" Grid.Row="4" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="5" Text="{loc:Get youtube_client_secret_label}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PwdYtClientSecret" Grid.Row="6" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="TxtYtStatus" Grid.Row="7" TextWrapping="Wrap" Foreground="#9A9AA2" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Get twitch_disconnect}" Padding="10,4" Margin="0,0,8,0" Click="BtnYtDisconnect_Click"/>
            <Button Content="{loc:Get twitch_connect}" Padding="10,4" Margin="0,0,8,0" Click="BtnYtConnect_Click"/>
            <Button Content="{loc:Get save}" Width="90" Padding="6,2" IsDefault="True" Click="BtnYtSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
