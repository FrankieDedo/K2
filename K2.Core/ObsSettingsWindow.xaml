<Window x:Class="K2.Core.ObsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core"
        Title="{loc:Get obs_settings_title}"
        Width="420" Height="440"
        MinWidth="360" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Style="{DynamicResource K2WindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Get obs_settings_title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- RichTextBox, not a TextBlock: the setup guide must be selectable/copyable
             (a WPF TextBlock cannot). Read-only + transparent + borderless so it still
             reads as plain text. Built in code-behind (SetupGuide.BuildDocument). -->
        <Border Grid.Row="1" Background="#14FFFFFF" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <RichTextBox x:Name="RtbObsGuide" IsReadOnly="True" IsDocumentEnabled="True"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="#C7C7CE" FontSize="12"
                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/>
        </Border>

        <TextBlock Grid.Row="2" Text="{loc:Get obs_host_label}" Margin="0,0,0,4"/>
        <TextBox   x:Name="TxtObsHost" Grid.Row="3" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="4" Text="{loc:Get obs_port_label}" Margin="0,0,0,4"/>
        <TextBox   x:Name="TxtObsPort" Grid.Row="5" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="6" Text="{loc:Get obs_password_label}" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PwdObsPassword" Grid.Row="7" Height="25" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="TxtObsStatus" Grid.Row="8" TextWrapping="Wrap" Foreground="#9A9AA2" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Get obs_test_connection}" Padding="10,4" Margin="0,0,8,0" Click="BtnObsTest_Click"/>
            <Button Content="{loc:Get save}" Width="90" Padding="6,2" IsDefault="True" Click="BtnObsSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
