<Window x:Class="K2.App.SpeedTestConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core"
        Title="{loc:Get speedtest_config_title}"
        Width="500" SizeToContent="Height"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{DynamicResource K2WindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0  title -->
            <RowDefinition Height="Auto"/>   <!-- 1  hint -->
            <RowDefinition Height="Auto"/>   <!-- 2  provider label -->
            <RowDefinition Height="Auto"/>   <!-- 3  provider combo -->
            <RowDefinition Height="Auto"/>   <!-- 4  custom URLs -->
            <RowDefinition Height="Auto"/>   <!-- 5  sizes + timeout -->
            <RowDefinition Height="Auto"/>   <!-- 6  sources hint -->
            <RowDefinition Height="Auto"/>   <!-- 7  test row -->
            <RowDefinition Height="Auto"/>   <!-- 8  buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Get speedtest_config_title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="{loc:Get speedtest_config_hint}" TextWrapping="Wrap" Foreground="#9A9AA2" Margin="0,0,0,14"/>

        <TextBlock Grid.Row="2" Text="{loc:Get speedtest_provider_label}" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox Grid.Row="3" x:Name="CbProvider" Width="260" HorizontalAlignment="Left" Margin="0,0,0,4"
                  SelectionChanged="CbProvider_SelectionChanged">
            <ComboBoxItem Content="{loc:Get speedtest_provider_cloudflare}"/>
            <ComboBoxItem Content="{loc:Get speedtest_provider_librespeed}"/>
            <ComboBoxItem Content="{loc:Get speedtest_provider_ookla}"/>
            <ComboBoxItem Content="{loc:Get speedtest_provider_testfile}"/>
            <ComboBoxItem Content="{loc:Get speedtest_provider_custom}"/>
        </ComboBox>

        <StackPanel Grid.Row="4" x:Name="PnlCustom" Margin="0,10,0,0">
            <TextBlock Text="{loc:Get speedtest_down_url_label}" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtDownUrl" Height="23" VerticalContentAlignment="Center"/>
            <TextBlock Text="{loc:Get speedtest_down_url_hint}" TextWrapping="Wrap" FontSize="11"
                       Foreground="#9A9AA2" Margin="0,3,0,10"/>

            <TextBlock Text="{loc:Get speedtest_up_url_label}" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtUpUrl" Height="23" VerticalContentAlignment="Center"/>
            <TextBlock Text="{loc:Get speedtest_up_url_hint}" TextWrapping="Wrap" FontSize="11"
                       Foreground="#9A9AA2" Margin="0,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" x:Name="PnlNumbers" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{loc:Get speedtest_down_size_label}" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtDownMb" Width="52" Height="23" Margin="6,0,4,0" MaxLength="4"
                     VerticalContentAlignment="Center" TextAlignment="Center"
                     PreviewTextInput="DigitsOnly_PreviewTextInput"/>
            <TextBlock Text="{loc:Get unit_megabytes}" VerticalAlignment="Center" Foreground="#9A9AA2" Margin="0,0,16,0"/>

            <TextBlock Text="{loc:Get speedtest_up_size_label}" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtUpMb" Width="52" Height="23" Margin="6,0,4,0" MaxLength="4"
                     VerticalContentAlignment="Center" TextAlignment="Center"
                     PreviewTextInput="DigitsOnly_PreviewTextInput"/>
            <TextBlock Text="{loc:Get unit_megabytes}" VerticalAlignment="Center" Foreground="#9A9AA2" Margin="0,0,16,0"/>

            <TextBlock Text="{loc:Get speedtest_timeout_label}" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtTimeout" Width="46" Height="23" Margin="6,0,4,0" MaxLength="3"
                     VerticalContentAlignment="Center" TextAlignment="Center"
                     PreviewTextInput="DigitsOnly_PreviewTextInput"/>
            <TextBlock Text="{loc:Get unit_seconds}" VerticalAlignment="Center" Foreground="#9A9AA2"/>
        </StackPanel>

        <TextBlock Grid.Row="6" x:Name="LblSources" Text="{loc:Get speedtest_sources_hint}" TextWrapping="Wrap"
                   FontSize="11" Foreground="#9A9AA2" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="7" Margin="0,14,0,0">
            <Button x:Name="BtnTest" Content="{loc:Get speedtest_test_now}" HorizontalAlignment="Left"
                    Padding="12,4" Click="BtnTest_Click"/>
            <TextBox x:Name="TxtProbe" IsReadOnly="True" Margin="0,8,0,0" MinHeight="46" MaxHeight="90"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#1C1C22"
                     Foreground="#CCC" BorderBrush="#333" Visibility="Collapsed"/>
        </StackPanel>

        <Grid Grid.Row="8" Margin="0,16,0,0">
            <Button Content="{loc:Get cancel}" Width="90" Padding="6,2" IsCancel="True" HorizontalAlignment="Right"
                    Margin="0,0,98,0"/>
            <Button Content="{loc:Get save}" Width="90" Padding="6,2" IsDefault="True"
                    HorizontalAlignment="Right" Click="BtnSave_Click"/>
        </Grid>
    </Grid>
</Window>
