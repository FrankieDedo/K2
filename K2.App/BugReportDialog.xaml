<Window x:Class="K2.App.BugReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core"
        Title="{loc:Get bugreport_title}"
        Width="640" Height="740"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Style="{DynamicResource K2WindowStyle}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Get bugreport_describe}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBox Grid.Row="1" x:Name="TxtDescription" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" MinHeight="120"/>

        <TextBlock Grid.Row="2" Text="{loc:Get bugreport_contact}" Margin="0,12,0,6"/>
        <TextBox Grid.Row="3" x:Name="TxtContact"/>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="{loc:Get bugreport_files}" Margin="0,0,0,4"/>
            <Border Background="{StaticResource K2SurfaceDarkBrush}" BorderBrush="{StaticResource K2BorderBrush}"
                    BorderThickness="1" CornerRadius="4" MaxHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,4">
                    <ItemsControl x:Name="LstFiles">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Display}" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Button Content="{loc:Get bugreport_add_files}" HorizontalAlignment="Left" Margin="0,6,0,0"
                    Padding="12,2" Click="BtnAddFiles_Click"/>
            <CheckBox x:Name="CkProfiles" IsChecked="True" Margin="0,8,0,0">
                <TextBlock Text="{loc:Get bugreport_include_profiles}" TextWrapping="Wrap"/>
            </CheckBox>
            <TextBlock x:Name="TxtNoFiles" Text="{loc:Get bugreport_no_files}" Foreground="#AAA" FontSize="11"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,4,0,0"/>
            <TextBlock Text="{loc:Get bugreport_sysinfo}" Margin="0,10,0,4"/>
            <TextBlock x:Name="TxtSysInfo" Foreground="#AAA" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Get bugreport_privacy}" Foreground="#AAA" FontSize="11"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnSend" Content="{loc:Get bugreport_send}" IsDefault="True" MinWidth="72"
                    Style="{StaticResource K2IconAccentButton}" Click="BtnSend_Click"
                    Margin="0,0,8,0" Padding="0,0,7,0"/>
            <Button Content="{loc:Get cancel}" IsCancel="True" MinWidth="72" Padding="12,0,12,0"/>
        </StackPanel>
    </Grid>
</Window>
