<Window x:Class="K2.App.DpKeyConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core"
        Title="Configure key"
        Width="520" SizeToContent="Height"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{DynamicResource K2WindowStyle}">

    <!-- Layout (reworked 2026-08-24 on user request): the dialog now reads top-down as
         "what does this key DO" then "what does it LOOK like", instead of the old two
         side-by-side columns.
           1. Action  — summary box across the full width, its two (half-width) buttons
                        left-aligned underneath;
           2. Icon    — "Default icon" checkbox, the preview below it, and every remaining
                        image control in a column to their right. -->
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- header -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- action section -->
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>  <!-- separator -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>  <!-- icon section -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- OK / Cancel -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblHeader" Grid.Row="0"
                   FontSize="16" FontWeight="Bold"/>

        <!-- ───────────────── Action ───────────────── -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="{loc:Get dp_action_section}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <Border Background="#1C1C22"
                    BorderBrush="#333" BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,6"
                    Margin="0,0,0,8">
                <TextBlock x:Name="LblActionSummary"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#CCC"/>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Content="{loc:Get dp_configure_action}"
                        Width="150"
                        Click="BtnConfigureAction_Click"
                        Margin="0,0,8,0"/>
                <Button Content="{loc:Get dp_remove_action}"
                        Width="150"
                        Click="BtnRemoveAction_Click"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="4" Height="1" Background="#2E2E36"/>

        <!-- ───────────────── Icon ───────────────── -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- checkbox + preview -->
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>      <!-- every other image control -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>     <!-- section label -->
                <RowDefinition Height="Auto"/>     <!-- "Default icon" checkbox -->
                <RowDefinition Height="Auto"/>     <!-- preview -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="{loc:Get dp_icon_section}"
                       FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                <CheckBox x:Name="ChkDefaultIcon"
                          Content="{loc:Get dp_gallery_icon}"
                          IsChecked="True"
                          Checked="ChkDefaultIcon_Changed" Unchecked="ChkDefaultIcon_Changed"/>
                <!-- "spotify" action only: overlay the live album cover; visibility is set in
                     code-behind (UpdateIconControlsAvailability). -->
                <CheckBox x:Name="ChkSpotifyCover"
                          Content="{loc:Get dp_spotify_cover_icon}"
                          Visibility="Collapsed" Margin="0,6,0,0"
                          Checked="ChkSpotifyCover_Changed" Unchecked="ChkSpotifyCover_Changed"/>
            </StackPanel>

            <!-- Preview host: populated in code-behind — "No image" placeholder, or the
                 inline CropEditor (static images AND animated GIFs; crop/zoom stays in THIS
                 window). See DpKeyConfigDialog.xaml.cs RefreshImagePreview(). -->
            <StackPanel Grid.Row="2" Grid.Column="0" Width="210">
                <TextBlock x:Name="LblNoImage"
                           Text="No image"
                           HorizontalAlignment="Center"
                           Margin="0,30"
                           Foreground="#555" FontSize="12"/>
                <StackPanel x:Name="PreviewHost" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Right column: every remaining image control, spanning checkbox + preview. -->
            <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" VerticalAlignment="Top">

                <Button x:Name="BtnLoadImage"
                        Content="{loc:Get dp_load_image}"
                        Click="BtnLoadImage_Click"/>

                <Button x:Name="BtnRemoveImage"
                        Content="{loc:Get dp_remove_image}"
                        Margin="0,6,0,0"
                        Click="BtnRemoveImage_Click"/>

                <Button x:Name="BtnEditIcon"
                        Content="{loc:Get dp_add_text}"
                        Margin="0,6,0,0"
                        Click="BtnAddText_Click"/>
            </StackPanel>
        </Grid>

        <!-- OK / Cancel -->
        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{loc:Get ok}"
                    IsDefault="True"
                    MinWidth="72"
                    Style="{StaticResource K2IconAccentButton}"
                    Click="BtnOk_Click"
                    Margin="0,0,8,0"/>
            <Button Content="{loc:Get cancel}"
                    IsCancel="True"
                    MinWidth="72"/>
        </StackPanel>
    </Grid>
</Window>
