<Window x:Class="K2.App.TelemachusPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core"
        Title="{loc:Get tmpick_title}"
        Width="620" Height="600" MinWidth="460" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource K2AppFontFamily}"
        Style="{DynamicResource K2WindowStyle}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TxtSearch" Height="28" VerticalContentAlignment="Center"
                     ToolTip="{loc:Get tmpick_search_tip}" TextChanged="TxtSearch_TextChanged"/>
            <Button Grid.Column="1" x:Name="BtnRefresh" Margin="8,0,0,0"
                    Style="{StaticResource K2IconButton}" Tag="&#xE72C;"
                    Content="{loc:Get tmpick_refresh}" Click="BtnRefresh_Click"/>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="LblStatus" Margin="0,8,0,8" TextWrapping="Wrap"
                   Foreground="{DynamicResource K2TextMutedBrush}"/>

        <ListBox Grid.Row="2" x:Name="LstEntries" MouseDoubleClick="LstEntries_MouseDoubleClick"
                 SelectionChanged="LstEntries_SelectionChanged"
                 VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource K2SurfaceAltBrush}"
                 Foreground="{DynamicResource K2TextBrush}"
                 BorderBrush="{DynamicResource K2BorderBrush}" BorderThickness="1">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,10,0,2"
                                       Foreground="{DynamicResource K2AccentBrush}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Api}" FontSize="11"
                                       Foreground="{DynamicResource K2TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="12,0,4,0" MaxWidth="160"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource K2TextMutedBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Get cancel}" MinWidth="90" IsCancel="True"/>
            <Button x:Name="BtnOk" Content="{loc:Get ok}" MinWidth="90" Margin="8,0,0,0"
                    IsDefault="True" Style="{StaticResource K2IconAccentButton}" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
