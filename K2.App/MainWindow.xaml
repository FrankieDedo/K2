            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRealProfile}" Value="True"/>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="BtnGear" Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="PathGear" Property="Fill" Value="{DynamicResource K2AccentTextBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Keycap-type ComboBox item template: the open dropdown shows the full localized
             label ("Normal (halo around the key)", …); the collapsed selection box shows
             only the style name ("Normal" / "Pudding" / "Reverse pudding"). When rendered
             in the selection box there is no ComboBoxItem ancestor, so the trigger swaps
             Text to ShortLabel. Shared by CbEvKeycapStyle / CbEv60KeycapStyle /
             CbMpKeycapStyle (wired in code-behind). -->
        <DataTemplate x:Key="KeycapStyleItemTemplate">
            <TextBlock x:Name="KeycapStyleText" Text="{Binding Label}" VerticalAlignment="Center"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}" Value="{x:Null}">
                    <Setter TargetName="KeycapStyleText" Property="Text" Value="{Binding ShortLabel}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="K2SideProfileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="ProfileItem_PreviewRightClick"/>
            <EventSetter Event="ContextMenuOpening" Handler="ProfileItem_ContextMenuOpening"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <!-- Stretch (not Left): K2ProfileItemTemplate's Grid needs the full row
                                 width so its "*" name column can actually push the gear button's
                                 Auto column to the row's right edge — Left-aligning the
                                 ContentPresenter sized the Grid down to its content's natural width
                                 instead, leaving the gear stuck right after the label text. -->
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E26"/>
                                <Setter Property="Foreground" Value="#DCDCE0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource K2AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="K2SideProfileList" TargetType="ListBox">
            <Setter Property="Width" Value="190"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Background" Value="#111115"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource K2SideProfileItemStyle}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource K2ProfileItemTemplate}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="4">
                            <ScrollViewer Background="Transparent" CanContentScroll="False">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="K2SideGroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#4A4A58"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- Macro editor: block-style RadioButton for mutually-exclusive
             option rows (Delay / Playback) — same accent-highlight look
             as SectionTabStyle, but a full pill row instead of a tab. -->
        <Style x:Key="MacroOptionRowStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B8C0"/>
            <Setter Property="Background" Value="#1E1E22"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A30"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource K2AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Macro editor: small icon-only button for per-row input actions
             (move up/down, delete) — same glyph-in-Tag convention as
             K2IconButton, but compact and with no text label. -->
        <Style x:Key="MacroRowIconButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#808088"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333338"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Macro editor: library list item, styled like the device "SECTIONS"
             sidebar (accent-highlight-when-selected) instead of a plain ListBox. -->
        <Style x:Key="MacroLibraryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#9A9AA2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                CornerRadius="0,4,4,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E1E26"/>
                                <Setter Property="Foreground" Value="#DCDCE0"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource K2AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Macro editor: press/release chevron indicator on each input row -->
        <Style x:Key="MacroPressIndicatorStyle" TargetType="TextBlock">
            <Setter Property="Text" Value=""/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowIndicator}" Value="True"/>
                        <Condition Binding="{Binding IsPress}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="&#x25B2;"/>
                    <Setter Property="Foreground" Value="#4CAF50"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ShowIndicator}" Value="True"/>
                        <Condition Binding="{Binding IsPress}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="&#x25BC;"/>
                    <Setter Property="Foreground" Value="#E05252"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- K2SyncCheckBox ("Sync across profiles" checkbox positioning) moved to
             K2.Core/Themes/K2Theme.xaml 2026-08-28 so the Everest 60 Lighting
             UserControl can reference it too. -->

        <!-- "Guide" button: bottom-right of every device panel (and, relabelled
             "Highlights" via Content, the Home tab). Icon + label, same
             muted-gray / hover-bg treatment as BtnMacroTab. The icon is an
             alpha silhouette (K2.Core Assets/guide.png) tinted via OpacityMask
             so it follows the button's Foreground, like the traced gear/nav icons.
             Label = Content (defaults to "Guide"); the Home instance overrides
             Content + ToolTip. Click handlers: MainWindow.Guide.cs. -->
        <Style x:Key="K2GuideButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource K2TextMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,4,2"/>
            <Setter Property="Panel.ZIndex" Value="60"/>
            <Setter Property="Content" Value="{loc:Get guide_button}"/>
            <Setter Property="ToolTip" Value="{loc:Get guide_tooltip}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                                <Rectangle Width="19" Height="19" VerticalAlignment="Center"
                                           Fill="{TemplateBinding Foreground}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://application:,,,/K2.Core;component/Assets/guide.png"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="{TemplateBinding Content}" Margin="7,0,0,0"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource K2TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Outer grid: top tab strip + brightness bar + content panels -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- device tab strip -->
                <RowDefinition Height="Auto"/>
                <!-- brightness bar (shared, one control per device type) -->
                <RowDefinition Height="*"/>
                <!-- content panels -->
            </Grid.RowDefinitions>

            <!-- Top-level device tab strip (Everest static; MacroPad/DP added dynamically)
                 + Macro / gear-only Settings buttons, right-aligned on the same row. -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TabControl x:Name="TcDevices" Grid.Column="0"
                            SelectionChanged="TcDevices_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <TabPanel IsItemsHost="True" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </ControlTemplate>
                    </TabControl.Template>
                    <!-- Home: icon-only tab, always present (not gated by any device connection) —
                         the app's landing tab, always first regardless of what's plugged in. -->
                    <TabItem x:Name="TabHome" Tag="home" ToolTip="{loc:Get tab_home}">
                        <TabItem.Header>
                            <Image Source="Assets/K2_logo.png" Width="40" Height="40" Stretch="Uniform"/>
                        </TabItem.Header>
                    </TabItem>
                    <!-- Fixed device order: Everest Max > Everest 60 > Makalu > DisplayPad > MacroPad
                         (DisplayPad tabs inserted dynamically after TabMakalu by DpRefreshDevices).
                         Every tab starts Collapsed and is only made Visible once its device is
                         confirmed connected (see SetDeviceTabVisible in MainWindow.xaml.cs) — a
                         disconnected device must never show a tab. -->
                    <TabItem x:Name="TabEverest"   Tag="everest"   Header="{loc:Get tab_everest}"   Visibility="Collapsed"/>
                    <TabItem x:Name="TabEverest60" Tag="everest60" Header="{loc:Get tab_everest60}" Visibility="Collapsed"/>
                    <TabItem x:Name="TabMakalu"    Tag="makalu"    Header="{loc:Get tab_makalu}"    Visibility="Collapsed"/>
                    <!-- DisplayPad tabs added dynamically by DpRefreshDevices -->
                    <TabItem x:Name="TabMacroPad" Tag="macropad" Header="{loc:Get tab_macropad}" Visibility="Collapsed"/>
                </TabControl>

                <!-- Macro: same card look as the device tabs (K2Theme TabItem template) —
                     K2SurfaceAltBrush tile, decorative bottom-right corner triangle,
                     bold+italic+uppercase title pinned top-left. Height/MinWidth/Padding
                     mirror the TabItem style so it lines up with the tab strip. -->
                <Button x:Name="BtnMacroTab" Grid.Column="1"
                        Height="62" MinWidth="140" Margin="8,0,0,0" Padding="12,10"
                        VerticalAlignment="Center"
                        Content="{loc:Get tab_macro}"
                        Background="Transparent" Foreground="{StaticResource K2TextMutedBrush}"
                        FontWeight="Bold" FontStyle="Italic"
                        Cursor="Hand" Click="BtnMacroTab_Click"
                        ToolTip="{loc:Get tab_macro}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{StaticResource K2SurfaceAltBrush}" CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Polygon x:Name="CornerTriangle"
                                             Points="14,0 14,14 0,14"
                                             Fill="#54545E"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Margin="0,0,-2,-2"/>
                                    <TextBlock x:Name="Txt"
                                               Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, Converter={StaticResource UpperCaseConverter}}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               FontStyle="{TemplateBinding FontStyle}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                                </Trigger>
                                <!-- Active (Macro section open): identical to the device
                                     tabs' IsSelected state — accent-red tile, white title,
                                     zoomed white corner triangle. Driven by Tag="active"
                                     from SetMacroTabActive in MainWindow.xaml.cs. -->
                                <Trigger Property="Tag" Value="active">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource K2AccentTextBrush}"/>
                                    <Setter TargetName="CornerTriangle" Property="Points" Value="26,0 26,26 0,26"/>
                                    <Setter TargetName="CornerTriangle" Property="Fill" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Settings: gear-icon-only button, always right-aligned. Square card
                     (62x62) matching the Home tab (K2Theme TabItem "home" trigger) — same
                     K2SurfaceAltBrush tile + CornerRadius, gear centered, no corner
                     triangle. Same traced vector gear as the per-profile gear
                     (K2ProfileItemTemplate — see its doc comment for how the Path Data was
                     produced) — Fill stays bound to the button's own Foreground
                     (TemplateBinding), same "contextual color" approach: whatever color
                     this button is themed with (muted gray, matching the profile gear)
                     drives the icon. -->
                <Button x:Name="BtnSettingsTab" Grid.Column="2"
                        Width="62" Height="62" Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        Background="Transparent" Foreground="{StaticResource K2TextMutedBrush}"
                        Cursor="Hand" Click="BtnSettingsTab_Click"
                        ToolTip="{loc:Get tab_settings}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{StaticResource K2SurfaceAltBrush}" CornerRadius="7">
                                <Path x:Name="Gear" Width="24" Height="24" Stretch="Uniform" Fill="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 11.06,4.64 L 13.17,4.64 L 13.55,6.33 L 15.00,6.98 L 16.59,6.05 L 18.05,7.50 L 17.11,9.05 L 17.67,10.45 L 19.45,10.92 L 19.45,13.03 L 17.72,13.45 L 17.11,14.86 L 18.00,16.50 L 16.59,17.91 L 15.05,17.02 L 13.64,17.53 L 13.17,19.31 L 11.06,19.31 L 10.69,17.67 L 9.28,17.02 L 7.64,17.91 L 6.19,16.45 L 7.12,14.91 L 6.52,13.45 L 4.78,13.03 L 4.78,10.88 L 6.47,10.50 L 7.12,9.05 L 6.19,7.50 L 7.64,6.05 L 9.23,6.98 L 10.59,6.42 Z M 11.81,9.33 L 12.80,9.42 L 13.88,9.98 L 14.39,10.64 L 14.77,11.72 L 14.67,12.66 L 14.11,13.73 L 13.69,14.11 L 13.08,14.44 L 12.19,14.67 L 11.02,14.39 L 10.22,13.88 L 9.66,12.98 L 9.42,12.09 L 9.61,11.11 L 10.08,10.27 L 10.92,9.61 Z"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource K2HoverBrush}"/>
                                </Trigger>
                                <!-- Active (Settings section open): same accent-red tile +
                                     white icon as a selected device tab (square Home-style
                                     card, so no corner triangle). Driven by Tag="active"
                                     from SetSettingsTabActive in MainWindow.xaml.cs. -->
                                <Trigger Property="Tag" Value="active">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                                    <Setter TargetName="Gear" Property="Fill" Value="{DynamicResource K2AccentTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- "Update available" badge: an accent dot over the gear's top-right
                     corner, toggled by MainWindow.Settings.cs (SetUpdateBadge) when the
                     startup check finds a newer release. Same cell as BtnSettingsTab so
                     it overlays it; IsHitTestVisible=False so the gear still takes the
                     click. DynamicResource, not Static: the accent brush is re-set live
                     by Settings > Accent color. -->
                <Ellipse x:Name="DotUpdateBadge" Grid.Column="2" Visibility="Collapsed"
                         Width="9" Height="9" Margin="0,-24,15,0"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Fill="{DynamicResource K2AccentBrush}"
                         Stroke="{DynamicResource K2BgBrush}" StrokeThickness="1.5"/>
            </Grid>

            <!-- Brightness bar: top-right, below the settings icon + divider.
                 One StackPanel per device type; only the active device's is
                 shown (toggled in TcDevices_SelectionChanged / BtnSettingsTab_Click,
                 same as the Pnl* content panels below). -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,4,6">
                <StackPanel x:Name="BrEverest" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="{loc:Get brightness}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SldEvBrightness" Minimum="0" Maximum="100" Value="100"
                            Width="140" TickFrequency="25" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
                            ValueChanged="SldEvBrightness_ValueChanged"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblEvBrightness" Text="100%"
                               VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="40"/>
                </StackPanel>
                <StackPanel x:Name="BrMacroPad" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="{loc:Get brightness}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SldMacroBrightness" Minimum="0" Maximum="100" Value="100"
                            Width="140" TickFrequency="25" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
                            ValueChanged="SldMacroBrightness_ValueChanged"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblMacroBrightness" Text="100%"
                               VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="40"/>
                </StackPanel>
                <StackPanel x:Name="BrDisplayPad" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="{loc:Get brightness}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SldDpBrightness" Minimum="0" Maximum="100" Value="100"
                            Width="140" TickFrequency="25" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
                            ValueChanged="SldDpBrightness_ValueChanged"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblDpBrightness" Text="100%" VerticalAlignment="Center"
                               Margin="6,0,0,0" MinWidth="40"/>
                </StackPanel>
                <StackPanel x:Name="BrEverest60" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="{loc:Get brightness}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SldEv60Brightness" Minimum="0" Maximum="100" Value="100"
                            Width="140" TickFrequency="25" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
                            ValueChanged="SldEv60Brightness_ValueChanged"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblEv60Brightness" Text="100%" VerticalAlignment="Center"
                               Margin="6,0,0,0" MinWidth="40"/>
                </StackPanel>
                <StackPanel x:Name="BrMakalu" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="{loc:Get brightness}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="SldMkBrightness" Minimum="0" Maximum="100" Value="100"
                            Width="140" TickFrequency="25" IsSnapToTickEnabled="True"
                            TickPlacement="BottomRight"
                            ValueChanged="SldMkBrightness_ValueChanged"
                            VerticalAlignment="Center"/>
                    <TextBlock x:Name="LblMkBrightness" Text="100%" VerticalAlignment="Center"
                               Margin="6,0,0,0" MinWidth="40"/>
                </StackPanel>
            </StackPanel>

            <!-- Loading overlay — covers tab strip + content while AutoOpenDrivers runs.
                 Collapsed by code once all drivers are open. -->
            <Grid x:Name="PnlLoading" Grid.RowSpan="3" Panel.ZIndex="10" Background="#1A1A1E">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="Assets/K2_logo.png" Width="96" Height="96"
                           HorizontalAlignment="Center" Margin="0,0,0,16"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{loc:Get loading_drivers}"
                               FontSize="15" Foreground="{DynamicResource K2AccentBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="280" Height="3"
                                 Margin="0,14,0,0" Foreground="{DynamicResource K2AccentBrush}" Background="#2A2A32"/>
                </StackPanel>
            </Grid>

            <!-- Content panels: one visible at a time -->
            <Grid Grid.Row="2">

                <!-- ==================== Home ====================
                 Grid of cards, one per currently connected device (RefreshHomeTiles in
                 MainWindow.Home.cs) — inspired by Base Camp's own device picker. Only one
                 of PnlHomeEmpty/IcHomeTiles is visible at a time (nothing connected yet vs.
                 at least one tile), toggled by RefreshHomeTiles itself. -->
                <Grid x:Name="PnlHome">
                    <Button Style="{StaticResource K2GuideButton}"
                            Content="{loc:Get highlights_button}" ToolTip="{loc:Get highlights_tooltip}"
                            Click="BtnHighlights_Click"/>
                    <StackPanel x:Name="PnlHomeEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="Assets/K2_logo.png" Width="96" Height="96"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{loc:Get home_no_device}" FontSize="15"
                               Foreground="{StaticResource K2TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>

                    <ScrollViewer x:Name="ScrHomeTiles" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="24">
                            <TextBlock Text="{loc:Get home_heading}" FontSize="15" FontWeight="SemiBold"
                                   Margin="4,0,0,14"/>
                            <ItemsControl x:Name="IcHomeTiles">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="HomeTile_Click" Cursor="Hand" Margin="0,0,21,21"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            Height="Auto" Width="Auto"
                                            HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Card" Width="351" Height="247" CornerRadius="13"
                                                        Background="#221F26" BorderBrush="#2A2A32"
                                                        BorderThickness="1" ClipToBounds="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="9"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                Background="{DynamicResource K2AccentBrush}"
                                                                CornerRadius="13,0,0,13"/>
                                                            <Image Grid.Column="1" Source="{Binding ImagePath}"
                                                               Stretch="Uniform" HorizontalAlignment="Right"
                                                               VerticalAlignment="Bottom"
                                                               Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                                               Margin="0,0,-13,-13"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            <TextBlock x:Name="TxtCardName" Grid.Column="1"
                                                                   Text="{Binding Name, Converter={StaticResource UpperCaseConverter}}"
                                                                   FontSize="29" FontWeight="Bold" FontStyle="Italic"
                                                                   Foreground="{StaticResource K2TextBrush}"
                                                                   Margin="23,23,13,13" TextWrapping="Wrap"
                                                                   VerticalAlignment="Top"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush"
                                                                Value="{DynamicResource K2AccentBrush}"/>
                                                            <Setter TargetName="Card" Property="Background"
                                                                Value="{DynamicResource K2AccentBrush}"/>
                                                            <Setter TargetName="TxtCardName" Property="Foreground"
                                                                Value="White"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ==================== Everest Max ==================== -->
                <Grid x:Name="PnlEverest" Visibility="Collapsed">
                    <Button Style="{StaticResource K2GuideButton}" Click="BtnGuide_Click"/>
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <!-- Fixed (not Auto): keeps the sidebar/content start position
                             identical across devices regardless of which toolbar
                             buttons/breadcrumb happen to be visible for this device. -->
                            <RowDefinition Height="32"/>
                            <!-- toolbar -->
                            <RowDefinition Height="*"/>
                            <!-- 3-pane main -->
                        </Grid.RowDefinitions>

                        <!-- ── Toolbar ── -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- Debug-only: open/close driver manually -->
                            <Button x:Name="BtnEvOpen"    Content="{loc:Get open_driver}"   Click="BtnEvOpen_Click"
                                Style="{StaticResource K2IconAccentButton}" Tag="&#xE768;" Visibility="Collapsed"/>
                            <Button x:Name="BtnEvClose"   Content="{loc:Get close_driver}"  Margin="8,0,0,0" Click="BtnEvClose_Click"
                                Style="{StaticResource K2IconButton}" Tag="&#xE711;" Visibility="Collapsed"/>
                            <!-- Debug-only: AP controls -->
                            <Separator x:Name="SepEvApDbg" Margin="10,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnEvApOn"  Content="AP ON"  Padding="10,4"
                                Click="BtnEvApOn_Click"  Visibility="Collapsed"/>
                            <Button x:Name="BtnEvApOff" Content="AP OFF" Padding="10,4" Margin="6,0,0,0"
                                Click="BtnEvApOff_Click" Visibility="Collapsed"/>
                            <Separator x:Name="SepEvSdkDbg" Margin="10,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="LblEvSdk" Margin="16,6,0,0" FontStyle="Italic" Foreground="#9A9AA2" Visibility="Collapsed"/>
                        </WrapPanel>

                        <!-- ── 3-pane: sidebar | device-image + bottom-panel ── -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <!-- sidebar -->
                                <ColumnDefinition Width="*"/>
                                <!-- right side -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- common actions (all devices) -->
                            </Grid.ColumnDefinitions>

                            <!-- Left sidebar: section navigation -->
                            <Border Grid.Column="0" Background="#111115" CornerRadius="6"
                                Margin="0,0,8,0" Padding="4">
                                <StackPanel>
                                    <RadioButton x:Name="RbSecKeyMapping"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get ev_key_binding}" GroupName="EvSections"
                                             IsChecked="True" Checked="EvSection_Changed"/>
                                    <RadioButton x:Name="RbSecRgb"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get rgb_lighting}" GroupName="EvSections"
                                             Checked="EvSection_Changed"/>
                                    <RadioButton x:Name="RbSecDial"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="Display Dial" GroupName="EvSections"
                                             Checked="EvSection_Changed"/>
                                    <RadioButton x:Name="RbSecAppearance"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get appearance}" GroupName="EvSections"
                                             Checked="EvSection_Changed"/>
                                    <RadioButton x:Name="RbSecSettings"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get ev_settings}" GroupName="EvSections"
                                             Checked="EvSection_Changed"/>
                                    <!-- Debug-only sections -->
                                    <Separator x:Name="SepSectionDbg" Style="{StaticResource K2SideSeparator}"
                                           Margin="8,8" Visibility="Collapsed"/>
                                    <RadioButton x:Name="RbSecUsb"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get usb_recorder}" GroupName="EvSections"
                                             Visibility="Collapsed" Checked="EvSection_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- Right: device image (top, fixed height) + settings panel (bottom, grows) -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <!-- Fixed height across all devices, matching MacroPad's box height
                                     when rotated to vertical orientation (Positioning section,
                                     90°/270°): the canvas is 510x370, but RotateTransform swaps its
                                     rendered footprint to 370x510, so 510 + 8px padding each side = 526
                                     is the tallest a device box needs to be. -->
                                    <RowDefinition Height="526"/>
                                    <!-- device -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- HW capture bar (media dock / crown only) -->
                                    <RowDefinition Height="*"/>
                                    <!-- settings: grows with window height -->
                                </Grid.RowDefinitions>

                                <!-- Device image with interactive overlay. The Preview mouse handlers +
                                 CvsEvRubberBand implement Custom Lighting's rectangular multi-LED
                                 selection (drag a square over keys/border squares to paint them all —
                                 see EvDeviceBox_* in MainWindow.CustomLighting.cs). Preview (tunnel)
                                 events so a drag can START on a key Button without the Button
                                 swallowing the gesture; a plain click still reaches the Button
                                 normally because the rubber band only engages past a small drag
                                 threshold. -->
                                <Border Grid.Row="0" Background="#18181C" CornerRadius="6" Padding="8"
                                    x:Name="BdrEvDeviceBox"
                                    PreviewMouseLeftButtonDown="EvDeviceBox_MouseDown"
                                    PreviewMouseMove="EvDeviceBox_MouseMove"
                                    PreviewMouseLeftButtonUp="EvDeviceBox_MouseUp">
                                    <Grid>
                                        <DockPanel>
                                            <StackPanel x:Name="SpEvLayout" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- +20% zoom on request: LayoutTransform (not RenderTransform)
                                             so the Grid/Border around it re-measures at the scaled size
                                             and WPF's hit-testing keeps mapping clicks to the right Button
                                             automatically — no changes needed to KeyDef X/Y/W/H math. -->
                                                <StackPanel.LayoutTransform>
                                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                                </StackPanel.LayoutTransform>
                                                <!-- Left column: dock overlay + keyboard body -->
                                                <Grid x:Name="GrdEvKeyColumn">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Canvas x:Name="CvsEvKeyboard" Grid.Row="1"
                                                    Width="642" Height="260" ClipToBounds="True">
                                                        <Canvas.Background>
                                                            <ImageBrush x:Name="BrushEvKeyBg" ImageSource="Assets/keybg.png" Stretch="Fill"/>
                                                        </Canvas.Background>
                                                    </Canvas>
                                                    <!-- Border/side-LED paint overlay (Custom Lighting only): 31
                                                 small squares around the main board's bezel, built in code
                                                 (BuildBorderSquares/PlaceEdge, MainWindow.CustomLighting.cs).
                                                 SAME Grid.Row + SAME Width/Height as CvsEvKeyboard (not
                                                 bigger — a same-size sibling in the same cell overlaps it
                                                 exactly with zero extra alignment math and, critically,
                                                 doesn't grow the row / shift CvsEvKeyboard's own position the
                                                 way a larger centered sibling would). No ClipToBounds, so
                                                 squares positioned via negative/overflowing Canvas.Left/Top
                                                 in code render outside the nominal 642x260 rect just fine.
                                                 Declared AFTER CvsEvKeyboard (+ explicit ZIndex) to paint on
                                                 top of it. -->
                                                    <!-- NO Background here: a Transparent background would be
                                                 hit-testable and, sitting at ZIndex 2 over the whole board,
                                                 swallowed every key click while paint mode was on (root cause
                                                 of "keys won't paint on single click", 2026-07-22). A null
                                                 background lets clicks fall through to the keys while the
                                                 border squares (children with their own background) stay
                                                 clickable. -->
                                                    <Canvas x:Name="CvsEvBorderMain" Grid.Row="1"
                                                    Width="642" Height="260"
                                                    Panel.ZIndex="2"
                                                    Visibility="Collapsed"/>
                                                    <!-- Dock overlay: keytop art + a transparent Canvas holding the
                                                 clickable hotspots (4 media buttons + 2 crown rotation buttons,
                                                 the latter positioned above the artwork via negative Canvas.Top).
                                                 GrdEvDock keeps the Left/Right alignment toggle previously on
                                                 ImgEvDock (see UpdateKeyboardLayout), so the hotspots follow it. -->
                                                    <Grid x:Name="GrdEvDock" Grid.Row="0" Width="200"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,-32" Panel.ZIndex="1"
                                                  Visibility="Collapsed">
                                                        <Image x:Name="ImgEvDock" Source="Assets/keytop.png" Stretch="Uniform"/>
                                                        <Canvas x:Name="CvsEvDock" Width="200" Height="64"/>
                                                    </Grid>
                                                </Grid>
                                                <!-- Numpad + display keys, wrapped in a Grid (was a bare Canvas)
                                             so a same-size border overlay can share its cell — same reasoning
                                             as CvsEvBorderMain above. The Margin/VerticalAlignment that used
                                             to live on CvsEvNumpad itself move to the wrapping Grid so the
                                             pair positions identically to before. -->
                                                <Grid x:Name="GrdEvNumpadColumn" Margin="6,0,0,0" VerticalAlignment="Bottom">
                                                    <Canvas x:Name="CvsEvNumpad" Width="166" Height="260"
                                                    ClipToBounds="True">
                                                        <Canvas.Background>
                                                            <ImageBrush x:Name="BrushEvBoardRight" ImageSource="Assets/board_right.png" Stretch="Fill"/>
                                                        </Canvas.Background>
                                                    </Canvas>
                                                    <!-- Same null-background reasoning as CvsEvBorderMain above. -->
                                                    <Canvas x:Name="CvsEvBorderNumpad" Width="166" Height="260"
                                                    Panel.ZIndex="2"
                                                    Visibility="Collapsed"/>
                                                </Grid>
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- Rubber-band overlay for rectangular multi-LED selection: same
                                     Grid cell as the DockPanel so it covers the whole device box;
                                     IsHitTestVisible=False so it never steals clicks — the Border's
                                     Preview handlers drive it. -->
                                        <Canvas x:Name="CvsEvRubberBand" IsHitTestVisible="False">
                                            <Rectangle x:Name="RectEvRubberBand" Visibility="Collapsed"
                                               Stroke="#5BBEC3" StrokeThickness="1"
                                               StrokeDashArray="3 2" Fill="#335BBEC3"/>
                                        </Canvas>
                                    </Grid>
                                </Border>

                                <!-- HW capture bar: feedback-only text for the media dock / crown "Capture
                                 matrixId…" context-menu action (MainWindow.DockActions.cs) — no button
                                 here anymore (the old standalone "Capture HW Key" trigger was removed;
                                 the only way to start a capture now is that per-slot context-menu item).
                                 Only relevant when a dock is physically attached, so it mirrors
                                 GrdEvDock's visibility (see MainWindow.Layout.cs). -->
                                <WrapPanel x:Name="PnlHwCaptureBar" Grid.Row="1" Orientation="Horizontal"
                                       Margin="0,8,0,0" Visibility="Collapsed">
                                    <TextBlock x:Name="LblCapturedKey" Text=""
                                           VerticalAlignment="Center" Foreground="{DynamicResource K2AccentBrush}"/>
                                </WrapPanel>

                                <!-- Bottom settings panel: grows with the window (Row="*" above); MinHeight
                                 keeps its old fixed size as a floor so it doesn't collapse below the
                                 tallest section (Key Binding/RGB vs. Display Dial vs. USB Recorder).
                                 NOTE: no outer ScrollViewer anymore — that used to wrap ALL sections,
                                 but a ScrollViewer gives its content infinite available height, so
                                 nothing inside it can ever "fill remaining space" (a plain
                                 MaxHeight/Height-binding on LvEvKeys below either stayed too small or,
                                 worse, could compute TALLER than what's actually visible and silently
                                 render past the bottom of the window — exactly the "disappears below"
                                 bug this replaced). Each section now owns its own overflow behavior
                                 instead: Key Binding's Grid+ListView genuinely stretch (Grid.Row="0"
                                 below is "*", a real bounded size once nothing wraps it in a
                                 ScrollViewer); RGB/Dial/Settings/USB Recorder each have their own
                                 ScrollViewer (RGB already did; the other three were wrapped to match).
                                 MinHeight=220 (not 270, the value from the very first pass of this
                                 fix): the fixed chrome above this Border (tab strip + brightness bar +
                                 toolbar + status bar + margins, ~145px) plus the fixed 526px device row
                                 plus this floor must all fit inside the window's default Height (see
                                 Window.Height below) — 270 pushed that sum ~44px past 897, so on launch
                                 the bottom of the key list/buttons rendered past the window's bottom
                                 edge (Border doesn't clip by default, same root cause as the bug
                                 described above, just reintroduced via the floor value instead of a
                                 converter). Ev60(150)/Makalu(180)/MacroPad(130)/DisplayPad(90) all stay
                                 under that budget, which is why only Everest Max showed it. -->
                                <Border x:Name="BdrEvSettingsPanel" Grid.Row="1" Background="#14141A"
                                    BorderBrush="#2A2A32" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                                    MinHeight="220" Grid.RowSpan="2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <!-- active section content: fills the Border -->
                                            <RowDefinition Height="Auto"/>
                                            <!-- debug SDK log -->
                                        </Grid.RowDefinitions>

                                        <!-- ─── All section panels (one visible at a time) ─── -->
                                        <Grid Grid.Row="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="151*"/>
                                                <RowDefinition Height="9*"/>
                                            </Grid.RowDefinitions>

                                            <!-- ── KEY BINDING (mapped keys — click a key on the device
                                             graphic above to configure its action). A Grid (not
                                             StackPanel): StackPanel always sizes
                                             children to their natural/desired height regardless of
                                             available space, so it can never stretch a child to fill —
                                             only a Grid cell (default child alignment = Stretch)
                                             actually lets LvEvKeys grow with the window. Same
                                             hint-row + list/buttons layout as MacroPad's
                                             PnlMpSecKeyBinding (shared "key_binding_hint" string) — kept
                                             in sync across every device's Key Binding section, including
                                             Makalu's (MakaluDpiRemapPanel's SecRemap, aligned 2026-07-27 —
                                             previously the one deliberate exception, per an earlier user
                                             request that was superseded). ── -->
                                            <Grid x:Name="PnlSecKeyMapping" Grid.RowSpan="2" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <!-- hint text -->
                                                    <RowDefinition Height="*"/>
                                                    <!-- list + buttons: fills remaining height -->
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{loc:Get key_binding_hint}" Foreground="#9A9AA2"
                                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="170"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ListView Grid.Column="0" x:Name="LvEvKeys" Margin="0,0,8,0"
                                                          SelectionChanged="LvEvKeys_SelectionChanged">
                                                        <ListView.ItemContainerStyle>
                                                            <Style TargetType="ListViewItem">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                                                                        <Setter Property="Foreground" Value="#10302F"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ListView.ItemContainerStyle>
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Display}" Padding="2"/>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                        <Button x:Name="BtnEvMapKeys" Content="{loc:Get remap_keys}"
                                                            Click="BtnEvMapKeys_Click"
                                                            Style="{StaticResource K2IconButton}" Tag="&#xE8CB;"
                                                            HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                                            Visibility="Collapsed"/>
                                                        <Separator x:Name="SepEvMapKeysDbg" Style="{StaticResource K2SideSeparator}"
                                                               Margin="0,0,0,10" Visibility="Collapsed"/>
                                                        <Button x:Name="BtnEvConfig" Content="{loc:Get ev_configure}"
                                                            Padding="8,4" Click="BtnEvConfig_Click"
                                                            HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                                            IsEnabled="False"/>
                                                        <Button x:Name="BtnEvRemove" Content="{loc:Get ev_remove}"
                                                            Padding="8,4" Click="BtnEvRemove_Click"
                                                            HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                                            IsEnabled="False"/>
                                                        <Button x:Name="BtnEvCopy" Content="{loc:Get act_copy_action}"
                                                            Padding="8,4" Click="BtnEvCopy_Click"
                                                            HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                                            IsEnabled="False"/>
                                                        <Button x:Name="BtnEvCut" Content="{loc:Get act_cut_action}"
                                                            Padding="8,4" Click="BtnEvCut_Click"
                                                            HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                                            IsEnabled="False"/>
                                                        <Button x:Name="BtnEvPaste" Content="{loc:Get act_paste_action}"
                                                            Padding="8,4" Click="BtnEvPaste_Click"
                                                            HorizontalAlignment="Stretch"
                                                            IsEnabled="False"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>

                                            <!-- ── RGB & LIGHTING ── -->
                                            <!-- No MaxHeight: the old 220 cap forced a scrollbar as soon as the
                                                 window grew past the panel's MinHeight, and made this section the
                                                 only one whose right edge was shifted by a scrollbar (which in turn
                                                 misaligned CkEvSync vs. the other sections' sync checkbox). The
                                                 panel itself is already bounded (Grid row, see BdrEvSettingsPanel). -->
                                            <ScrollViewer x:Name="PnlSecRgb" Grid.RowSpan="2"
                                                      VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Visibility="Collapsed">
                                                <StackPanel>
                                                    <!-- Preset effects row 1: effect/speed/on-off (left) + sync (right) —
                                                     same Grid layout as MacroPad's PnlMpSecLed. -->
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{loc:Get rgb_effect}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <ComboBox x:Name="CbEvEffect" Width="140" Margin="0,0,12,0"
                                                                  SelectionChanged="CbEvEffect_SelectionChanged"
                                                                  DropDownOpened="CbEvEffect_DropDownOpened"
                                                                  DropDownClosed="CbEvEffect_DropDownClosed"/>
                                                            <StackPanel x:Name="PnlEvSpeed" Orientation="Horizontal" Margin="0,0,12,0">
                                                                <TextBlock Text="{loc:Get rgb_speed}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <Slider x:Name="SldEvSpeed" Minimum="0" Maximum="100" Width="110"
                                                                    TickFrequency="25" SmallChange="1" LargeChange="5" TickPlacement="BottomRight"
                                                                    ValueChanged="SldEvSpeed_ValueChanged" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="LblEvSpeed" Text="50%" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="36"/>
                                                            </StackPanel>
                                                            <TextBlock Text="{loc:Get led_backlight_label}" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                                            <CheckBox x:Name="CkEvBacklight" Style="{StaticResource K2InlineSwitch}"
                                                                VerticalAlignment="Center" IsChecked="True" Click="CkEvBacklight_Click"/>
                                                            <!-- Auto-off row, moved here 2026-07-25 (user request: "accanto
                                                             allo switch della backlight") from its old spot at the bottom
                                                             of this section — same controls/handlers, just relocated. -->
                                                            <CheckBox x:Name="CkEvAutoOffEnable" Content="{loc:Get backlight_auto_off_enable}"
                                                                Click="CkEvAutoOffEnable_Click" VerticalAlignment="Center" Margin="16,0,10,0"/>
                                                            <TextBlock Text="{loc:Get backlight_auto_off_seconds}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                            <TextBox x:Name="TxtEvAutoOffSeconds" Width="60" TextAlignment="Center"
                                                                LostFocus="TxtEvAutoOffSeconds_LostFocus" VerticalAlignment="Center" Height="25" Padding="3,2,3,0" TextChanged="TxtEvAutoOffSeconds_TextChanged"/>
                                                            <TextBlock Text="{loc:Get unit_seconds}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <!-- Position comes entirely from K2SyncCheckBox (see
                                                         Window.Resources) so it matches CkDialSync/CkSettingsSync
                                                         exactly — no local alignment/margin here. -->
                                                        <CheckBox x:Name="CkEvSync" Content="{loc:Get rgb_sync_profiles}"
                                                              Style="{StaticResource K2SyncCheckBox}"
                                                              Click="CkEvSync_Click" Grid.ColumnSpan="2"/>
                                                    </Grid>
                                                    <!-- Backlight auto-off — moved here from Settings (user request
                                                     2026-07-21): lives next to the backlight switch above, sized
                                                     like everything else in this panel (no Height/Padding override,
                                                     unlike the Settings-panel version this replaced). -->

                                                    <!-- Normal-effect controls (Row 2 direction + Row 3 color mode) vs.
                                                     Custom Lighting — mutually exclusive, toggled by CbEvEffect's
                                                     selection (UpdateEvCapabilities): only one is ever Visible, so
                                                     they're just two overlapping children of the same Grid cell
                                                     (no ColumnDefinitions needed — a 2-column split was tried first
                                                     but left a stray unnecessary scrollbar in PnlSecRgb, root cause
                                                     not pinned down; removed 2026-07-22 rather than chase it further
                                                     since the columns were never really needed once Custom moved to
                                                     the left/full-width per the same day's follow-up request). -->
                                                    <Grid Margin="0,0,0,10">
                                                        <StackPanel x:Name="PnlEvNormalControls">
                                                            <!-- Row 2: direction (only when the effect supports it) -->
                                                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                                <StackPanel x:Name="PnlEvDirection" Orientation="Horizontal">
                                                                    <TextBlock Text="{loc:Get rgb_direction}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <Border Style="{StaticResource K2SegmentedGroupBorder}">
                                                                        <UniformGrid x:Name="GridEvDirection" Rows="1"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </WrapPanel>
                                                            <!-- Row 3: color mode (Single/Double/Rainbow, one mutually-exclusive
                                                             vertical radio group) + swatches. -->
                                                            <WrapPanel Orientation="Horizontal">
                                                                <StackPanel Orientation="Vertical" Margin="0,0,20,0" VerticalAlignment="Center">
                                                                    <RadioButton x:Name="RbEvColorSingle" Content="{loc:Get rgb_single}" GroupName="EvColorMode"
                                                                        Margin="0,0,0,6" Checked="RbEvColorMode_Checked" ToolTip="{loc:Get rgb_single_tip}"/>
                                                                    <RadioButton x:Name="RbEvColorDouble" Content="{loc:Get rgb_double}" GroupName="EvColorMode"
                                                                        Margin="0,0,0,6" Checked="RbEvColorMode_Checked" ToolTip="{loc:Get rgb_double_tip}"/>
                                                                    <RadioButton x:Name="RbEvRainbow" Content="{loc:Get rgb_rainbow}" GroupName="EvColorMode"
                                                                        Checked="RbEvColorMode_Checked" ToolTip="{loc:Get rgb_rainbow_tip}"/>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PnlEvColor1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <TextBlock Text="{loc:Get rgb_primary}" VerticalAlignment="Center" Margin="0,0,4,0" Padding="0,0,5,0"/>
                                                                    <Button x:Name="BtnEvColor1" Width="30" Height="30"
                                                                        Background="#900000" BorderThickness="2"
                                                                        BorderBrush="#3A3A40" Click="BtnEvColor_Click" Tag="1"/>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PnlEvColor2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{loc:Get rgb_secondary}" VerticalAlignment="Center" Margin="0,0,4,0" Padding="0,0,5,0"/>
                                                                    <Button x:Name="BtnEvColor2" Width="30" Height="30"
                                                                        Background="#1A1A1E" BorderThickness="2"
                                                                        BorderBrush="#3A3A40" Click="BtnEvColor_Click" Tag="2" Padding="12,6,12,6"/>
                                                                </StackPanel>
                                                                <StackPanel x:Name="PnlEvColor3" Orientation="Horizontal"
                                                                        Margin="20,0,0,0" Visibility="Collapsed">
                                                                    <TextBlock Text="{loc:Get rgb_tertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <Button x:Name="BtnEvColor3" Width="30" Height="30"
                                                                        Background="#1A1A1E" BorderThickness="2"
                                                                        BorderBrush="#3A3A40" Click="BtnEvColor_Click" Tag="3"/>
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>

                                                        <!-- Per-key custom lighting section — was hidden 2026-07-14 (user
                                                         request at the time: hide LED painting/ring sections on every
                                                         device with a Lighting section), re-enabled 2026-07-22 (explicit
                                                         user request: full LED-painting system with border LEDs,
                                                         emulating Base Camp's own Custom section — see
                                                         MainWindow.CustomLighting.cs and CHANGELOG). Moved to the right
                                                         column + shown only for CbEvEffect="Custom" same session. -->
                                                        <StackPanel x:Name="PnlEvCustomLighting" Visibility="Collapsed">
                                                            <TextBlock Text="{loc:Get custom_lighting}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                            <TextBlock Text="{loc:Get custom_paint_hint}"
                                                               Foreground="#9A9AA2" FontStyle="Italic"
                                                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                            <!-- Paint effect: which effect newly-painted keys get. Wired
                                                             to the real per-region dynamic-effect protocol 2026-07-22
                                                             (see EverestSideLedProtocol's per-region-effects section +
                                                             CHANGELOG for the capture trace) — Static (plain color, the
                                                             LED-index-keyed static pages), Wave/Tornado/Breathing/
                                                             Reactive/Matrix/Yeti (raw 14 A0 region bitmap + 14 2C
                                                             effect-code param packet) and Off (paints black, same
                                                             channel as Static) are all live. Border squares stay
                                                             Static-only (matches Base Camp: "con gli effetti dinamici
                                                             si possono dipingere solo i led dei keycap"). -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <TextBlock Text="{loc:Get custom_paint_effect}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <ComboBox x:Name="CbCustomPaintEffect" Width="130"
                                                                      SelectionChanged="CbCustomPaintEffect_SelectionChanged"/>
                                                                <TextBlock x:Name="LblCustomColorStatic" Text="{loc:Get custom_color}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                                                <Button x:Name="BtnCustomBrushColor" Width="30" Height="30"
                                                                Background="#FF0000" BorderThickness="2"
                                                                BorderBrush="#3A3A40" Click="BtnCustomBrushColor_Click"/>
                                                            </StackPanel>

                                                            <!-- Contextual parameters for the SELECTED dynamic effect
                                                             (hidden under Static/Off, which just use the brush color
                                                             above) — mirrors PnlEvNormalControls' direction/color-mode/
                                                             swatches pattern but scoped to Custom Lighting's own paint
                                                             effect, since each dynamic effect keeps its OWN params
                                                             (speed/brightness/direction/colors), shared by every key
                                                             currently painted with it (one param packet per effect
                                                             code on the wire — see BuildCustomEffectParamPacket's doc).
                                                             brightness reuses SldEvBrightness (top of the Everest tab,
                                                             one brightness for the whole device regardless of effect,
                                                             same as the global RGB panel). -->
                                                            <StackPanel x:Name="PnlCustomFxParams" Visibility="Collapsed" Margin="0,0,0,6">
                                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                    <StackPanel x:Name="PnlCustomFxDirection" Orientation="Horizontal" Margin="0,0,16,0">
                                                                        <TextBlock Text="{loc:Get rgb_direction}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <Border Style="{StaticResource K2SegmentedGroupBorder}">
                                                                            <UniformGrid x:Name="GridCustomFxDirection" Rows="1"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{loc:Get rgb_speed}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                        <Slider x:Name="SldCustomFxSpeed" Minimum="0" Maximum="100" Width="100"
                                                                            TickFrequency="25" SmallChange="1" LargeChange="5" TickPlacement="BottomRight"
                                                                            ValueChanged="SldCustomFxSpeed_ValueChanged" VerticalAlignment="Center"/>
                                                                        <TextBlock x:Name="LblCustomFxSpeed" Text="50%" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="36"/>
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                                <WrapPanel Orientation="Horizontal">
                                                                    <StackPanel x:Name="PnlCustomFxColorMode" Orientation="Vertical" Margin="0,0,20,0" VerticalAlignment="Center">
                                                                        <RadioButton x:Name="RbCustomFxSingle" Content="{loc:Get rgb_single}" GroupName="CustomFxColorMode"
                                                                            Margin="0,0,0,6" Checked="RbCustomFxColorMode_Checked"/>
                                                                        <RadioButton x:Name="RbCustomFxDual" Content="{loc:Get rgb_double}" GroupName="CustomFxColorMode"
                                                                            Margin="0,0,0,6" Checked="RbCustomFxColorMode_Checked"/>
                                                                        <RadioButton x:Name="RbCustomFxRainbow" Content="{loc:Get rgb_rainbow}" GroupName="CustomFxColorMode"
                                                                            Checked="RbCustomFxColorMode_Checked"/>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PnlCustomFxColor1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                        <TextBlock Text="{loc:Get rgb_primary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                        <Button x:Name="BtnCustomFxColor1" Width="30" Height="30"
                                                                            Background="#FF0000" BorderThickness="2"
                                                                            BorderBrush="#3A3A40" Click="BtnCustomFxColor_Click" Tag="1"/>
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PnlCustomFxColor2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <TextBlock Text="{loc:Get rgb_secondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                        <Button x:Name="BtnCustomFxColor2" Width="30" Height="30"
                                                                            Background="#0000FF" BorderThickness="2"
                                                                            BorderBrush="#3A3A40" Click="BtnCustomFxColor_Click" Tag="2"/>
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                            </StackPanel>

                                                            <WrapPanel Orientation="Horizontal">
                                                                <Button x:Name="BtnCustomApply"   Content="{loc:Get apply}"           Padding="8,2" Margin="0,0,4,0" Click="BtnCustomApply_Click"  Style="{StaticResource K2IconAccentButton}" Tag="&#xE73E;"/>
                                                                <Button x:Name="BtnCustomFillAll" Content="{loc:Get custom_fill_all}" Padding="8,2" Margin="0,0,4,0" Click="BtnCustomFillAll_Click" Style="{StaticResource K2IconButton}"       Tag="&#xE771;"/>
                                                                <Button x:Name="BtnCustomClear"   Content="{loc:Get custom_clear}"    Padding="8,2"                   Click="BtnCustomClear_Click"   Style="{StaticResource K2IconButton}"       Tag="&#xE74D;"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <!-- ── DISPLAY DIAL ── (own ScrollViewer: no outer one anymore, see
                                             the comment on BdrEvSettingsPanel above) -->
                                            <ScrollViewer x:Name="PnlSecDial"
                                                      VerticalScrollBarVisibility="Auto" Grid.RowSpan="2" Visibility="Collapsed">
                                                <StackPanel>
                                                    <!-- Mirrors CkEvSync/CkSettingsSync — same underlying device flag,
                                                     see EvDialPrefix's doc comment (MainWindow.DisplayDial.cs). -->

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="20"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Spacer column reserving room for the top-right sync
                                                                 checkbox so it never overlaps the screensaver block. -->
                                                            <ColumnDefinition Width="170"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Spans every column and takes its position from
                                                         K2SyncCheckBox, like CkEvSync/CkSettingsSync. It used to be
                                                         pinned inside the fixed 150px column 3 with Width=110, which
                                                         both clipped the label and put it ~40px off the other
                                                         sections' checkbox. -->
                                                        <CheckBox x:Name="CkDialSync" Grid.ColumnSpan="4"
                                                              Content="{loc:Get rgb_sync_profiles}"
                                                              Style="{StaticResource K2SyncCheckBox}"
                                                              Click="CkDialSync_Click"/>

                                                        <!-- Left: show/hide menu pages — 2 columns x 4 rows, toggle-switch rows -->
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{loc:Get dial_pages_visible}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                            <!-- Padding="0,3" on every toggle row (style default is
                                                                 0,6): 8 rows x 6px is exactly what pushed this section
                                                                 past the panel height and made it scroll. -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="14"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0">
                                                                    <CheckBox x:Name="CkDialClock"    Style="{StaticResource K2ToggleRow}" Padding="0,3" Tag="&#xEC92;" Content="{loc:Get dial_clock}"      Click="CkDial_Click"/>
                                                                    <CheckBox x:Name="CkDialProfile"  Style="{StaticResource K2ToggleRow}" Padding="0,3" Tag="&#xE77B;" Content="{loc:Get dial_profile}"    Click="CkDial_Click"/>
                                                                    <CheckBox x:Name="CkDialLighting" Style="{StaticResource K2ToggleRow}" Padding="0,3" Tag="&#xEA80;" Content="{loc:Get dial_lighting}"   Click="CkDial_Click"/>
                                                                    <CheckBox x:Name="CkDialVolume"   Style="{StaticResource K2ToggleRow}" Padding="0,3" Tag="&#xE994;" Content="{loc:Get dial_volume}"     Click="CkDial_Click"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2">
                                                                    <CheckBox x:Name="CkDialBright"   Style="{StaticResource K2ToggleRow}" Padding="0,3" Tag="&#xE706;" Content="{loc:Get dial_brightness}" Click="CkDial_Click"/>
                                                                    <CheckBox x:Name="CkDialPCInfo"   Style="{StaticResource K2ToggleRow}" Padding="0,3" Tag="&#xE977;" Content="{loc:Get dial_pcinfo}"     Click="CkDial_Click"/>
                                                                    <CheckBox x:Name="CkDialAPM"      Style="{StaticResource K2ToggleRow}" Padding="0,3" Tag="&#xE916;" Content="{loc:Get dial_apm}"        Click="CkDial_Click"/>
                                                                    <CheckBox x:Name="CkDialCustom"   Style="{StaticResource K2ToggleRow}" Padding="0,3" Tag="&#xE765;" Content="{loc:Get dial_custom}"     Click="CkDial_Click"/>
                                                                </StackPanel>
                                                            </Grid>

                                                            <WrapPanel Orientation="Horizontal" Margin="0,16,0,-30" HorizontalAlignment="Right">
                                                                <TextBlock Text="{loc:Get dial_menu_color}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                <Button x:Name="BtnDialMenuColor" Width="28" Height="28"
                                                                Background="#F3CC23" BorderThickness="2"
                                                                BorderBrush="#3A3A40" Click="BtnDialMenuColor_Click"/>
                                                            </WrapPanel>

                                                            <TextBlock Text="{loc:Get dial_clock_section}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="{loc:Get dial_clock_style_label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <Border Style="{StaticResource K2SegmentedGroupBorder}" Width="140" Margin="0,0,16,0">
                                                                    <UniformGrid Rows="1">
                                                                        <RadioButton x:Name="RbDialClockDigital" Content="{loc:Get dial_clock_digital}" GroupName="DialClockStyle" Style="{StaticResource K2SegmentedButton}" Checked="RbDialClockStyle_Checked" themes:K2Segment.CornerRadius="6,0,0,6"/>
                                                                        <RadioButton x:Name="RbDialClockAnalog" Content="{loc:Get dial_clock_analog}" GroupName="DialClockStyle" Style="{StaticResource K2SegmentedButton}" Checked="RbDialClockStyle_Checked" themes:K2Segment.CornerRadius="0,6,6,0"/>
                                                                    </UniformGrid>
                                                                </Border>
                                                                <StackPanel x:Name="PnlDialClockFormat" Orientation="Horizontal">
                                                                    <TextBlock Text="{loc:Get dial_clock_label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                    <Border Style="{StaticResource K2SegmentedGroupBorder}" Width="90">
                                                                        <UniformGrid Rows="1">
                                                                            <RadioButton x:Name="RbDialClock24h" Content="24h" GroupName="DialClockType" Style="{StaticResource K2SegmentedButton}" Checked="RbDialClockType_Checked" themes:K2Segment.CornerRadius="6,0,0,6"/>
                                                                            <RadioButton x:Name="RbDialClock12h" Content="12h" GroupName="DialClockType" Style="{StaticResource K2SegmentedButton}" Checked="RbDialClockType_Checked" themes:K2Segment.CornerRadius="0,6,6,0"/>
                                                                        </UniformGrid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </WrapPanel>
                                                        </StackPanel>

                                                        <!-- Right: clock type, screensaver, turn-off, menu color, actions -->
                                                        <StackPanel Grid.Column="2">


                                                            <TextBlock Text="{loc:Get dial_screensaver_section}" FontWeight="SemiBold"/>
                                                            <Grid Margin="0,6,0,12">
                                                                <Grid.ColumnDefinitions>
                                                                    <!-- Fixed-width label column so both rows' entries share the same left edge -->
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="50"/>
                                                                    <ColumnDefinition Width="20"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <CheckBox Grid.Row="0" Grid.Column="0" x:Name="CkDialScreenSaverEnable"
                                                                  Content="{loc:Get dial_screensaver}" VerticalAlignment="Center"
                                                                  ToolTip="{loc:Get dial_screensaver_enable_tip}"
                                                                  Click="CkDialScreenSaverEnable_Click" HorizontalAlignment="Left"/>
                                                                <TextBox  Grid.Row="0" Grid.Column="1" x:Name="TxtDialScreenSaver" Width="38" Height="25" Padding="3,0,3,0" VerticalContentAlignment="Center"
                                                                  TextChanged="TxtDialScreenSaver_TextChanged" TextAlignment="Center" Text="5"/>
                                                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Get unit_seconds}" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                                                <CheckBox Grid.Row="1" Grid.Column="0" x:Name="CkDialTurnOffEnable"
                                                                  Content="{loc:Get dial_autooff}" VerticalAlignment="Center"
                                                                  ToolTip="{loc:Get dial_turnoff_enable_tip}"
                                                                  Click="CkDialTurnOffEnable_Click" HorizontalAlignment="Left"/>
                                                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDialTurnOff" Width="38" Height="25" Padding="3,0,3,0" VerticalContentAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  TextChanged="TxtDialTurnOff_TextChanged"  HorizontalAlignment="Center" TextAlignment="Center"/>
                                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{loc:Get unit_seconds}"
                                                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>


                                                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{loc:Get dial_screensaver_function_label}" Margin="6,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Top">

                                                                    <ComboBox x:Name="CbDialScreenSaverFunction" Width="180"
                                                                      SelectionChanged="CbDialScreenSaverFunction_SelectionChanged" Margin="5,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                                                    <Button x:Name="BtnDialLoadImage" Content="{loc:Get dial_load_image}"
                                                                    Padding="8,2" Margin="5,10,0,0" Click="BtnDialLoadImage_Click"
                                                                    Style="{StaticResource K2IconButton}" Tag="&#xE91B;" Height="25" Width="180" VerticalAlignment="Top" HorizontalAlignment="Center"/>

                                                                </StackPanel>

                                                                <!-- No "Apply to device" button any more: every Display Dial
                                                                     control applies on change (SaveAndApplyDial). Reset is
                                                                     pushed down so it lines up with the "menu color" row in
                                                                     the left column (user request 2026-08-28). -->
                                                                <StackPanel Grid.Row="2" Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" Width="180" Margin="5,70,0,0">
                                                                    <!-- Debug-only, see AppSettings.DebugMode / ApplyDebugMode -->
                                                                    <Button x:Name="BtnDialRead" Content="{loc:Get read_from_device}" Padding="8,2" Click="BtnDialRead_Click" Style="{StaticResource K2IconButton}" Tag="&#xE72C;" Height="25" Margin="0,0,0,10" Width="180" Visibility="Collapsed"/>
                                                                    <Button x:Name="BtnDialReset" Content="{loc:Get reset_display_dial}" Padding="8,2" Click="BtnDialReset_Click" Style="{StaticResource K2IconButton}" Tag="&#xE777;" Height="25" Width="180"/>
                                                                </StackPanel>

                                                            </Grid>


                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>

                                            <!-- ── SETTINGS ── (own ScrollViewer, same reason as Display Dial above).
                                             VerticalAlignment="Top" (not "Center", the original value): Center
                                             left a large empty strip above the content whenever this section is
                                             shorter than the tallest section (Key Binding/RGB) sharing the same
                                             Border — flagged by user (screenshot, 2026-07-21). -->
                                            <!-- ── APPEARANCE ── Keycap appearance + Keyboard color: purely
                                                 cosmetic on-screen preview options, global (not per-profile —
                                                 same as settings.keyboard_color always was), split out of
                                                 Settings into their own section per user request 2026-08-22. -->
                                            <ScrollViewer x:Name="PnlSecAppearance"
                                                      VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Grid.RowSpan="2" Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="440"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Get settings_keycap_group}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <TextBlock Text="{loc:Get settings_keycap_color}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <RadioButton x:Name="RbEvKeycapBlack" Content="{loc:Get settings_keycap_black}"
                                                                 GroupName="EvKeycapColor" VerticalAlignment="Center"
                                                                 Margin="0,0,10,0" Checked="RbEvKeycapColor_Checked"/>
                                                            <RadioButton x:Name="RbEvKeycapWhite" Content="{loc:Get settings_keycap_white}"
                                                                 GroupName="EvKeycapColor" VerticalAlignment="Center"
                                                                 Margin="0,0,10,0" Checked="RbEvKeycapColor_Checked"/>
                                                            <RadioButton x:Name="RbEvKeycapCustom" Content="{loc:Get settings_keycap_custom}"
                                                                 GroupName="EvKeycapColor" VerticalAlignment="Center"
                                                                 Margin="0,0,6,0" Checked="RbEvKeycapColor_Checked"/>
                                                            <Button x:Name="BtnEvKeycapCustomColor" Width="30" Height="30"
                                                            Background="#404040" BorderThickness="2" BorderBrush="#3A3A40"
                                                            Click="BtnEvKeycapCustomColor_Click" Margin="5,0,0,0"/>
                                                        </WrapPanel>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <TextBlock Text="{loc:Get settings_keycap_text_color}" VerticalAlignment="Center" Margin="0,0,6,0" Padding="0,0,18,0"/>
                                                            <RadioButton x:Name="RbEvKeycapTextBlack" Content="{loc:Get settings_keycap_black}"
                                                                 GroupName="EvKeycapTextColor" VerticalAlignment="Center"
                                                                 Margin="0,0,10,0" Checked="RbEvKeycapTextColor_Checked"/>
                                                            <RadioButton x:Name="RbEvKeycapTextWhite" Content="{loc:Get settings_keycap_white}"
                                                                 GroupName="EvKeycapTextColor" VerticalAlignment="Center"
                                                                 Margin="0,0,10,0" Checked="RbEvKeycapTextColor_Checked"/>
                                                            <RadioButton x:Name="RbEvKeycapTextCustom" Content="{loc:Get settings_keycap_custom}"
                                                                 GroupName="EvKeycapTextColor" VerticalAlignment="Center"
                                                                 Margin="0,0,6,0" Checked="RbEvKeycapTextColor_Checked"/>
                                                            <Button x:Name="BtnEvKeycapTextColor" Width="30" Height="30"
                                                            Background="White" BorderThickness="2" BorderBrush="#3A3A40"
                                                            Click="BtnEvKeycapTextColor_Click" Margin="5,0,0,0"/>
                                                        </WrapPanel>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                            <TextBlock Text="{loc:Get settings_keycap_style}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <ComboBox x:Name="CbEvKeycapStyle" Width="240"
                                                              SelectionChanged="CbEvKeycapStyle_SelectionChanged" Margin="4,3,0,0"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                    <!-- Keyboard color + the two keycap toggles. The toggles and their
                                                         hint used to sit at the bottom of column 0, which made that
                                                         column ~250px tall — past the settings panel's height, so this
                                                         section always showed a scrollbar. Moved here to balance the
                                                         two columns (user request 2026-08-22: everything must fit
                                                         without vertical scrolling). -->
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{loc:Get settings_keyboard_color}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <Border Style="{StaticResource K2SegmentedGroupBorder}" Width="140"
                                                                HorizontalAlignment="Left" Margin="0,0,0,10">
                                                            <UniformGrid Rows="1">
                                                                <RadioButton x:Name="RbEvKbColorSilver" Content="{loc:Get color_silver}" GroupName="EvKbColor" Style="{StaticResource K2SegmentedButton}" Checked="RbEvKbColor_Checked" themes:K2Segment.CornerRadius="6,0,0,6"/>
                                                                <RadioButton x:Name="RbEvKbColorBlack" Content="{loc:Get color_black}" GroupName="EvKbColor" Style="{StaticResource K2SegmentedButton}" Checked="RbEvKbColor_Checked" themes:K2Segment.CornerRadius="0,6,6,0"/>
                                                            </UniformGrid>
                                                        </Border>
                                                        <CheckBox x:Name="CkEvKeycapTranslucentLegend" Content="{loc:Get settings_keycap_translucent_legend}"
                                                              Click="CkEvKeycapTranslucentLegend_Click" Margin="0,0,0,6"/>
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox x:Name="CkEvKeycapEditMode" Content="{loc:Get settings_keycap_edit_individual}"
                                                                  Click="CkEvKeycapEditMode_Click"/>
                                                            <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_keycap_edit_individual_hint}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </ScrollViewer>

                                            <ScrollViewer x:Name="PnlSecSettings"
                                                      VerticalScrollBarVisibility="Auto" VerticalAlignment="Top" Grid.RowSpan="2" Visibility="Collapsed">
                                                <!-- Two columns (same 440/* split as Appearance above): stacked in a
                                                     single column the four groups + the factory-reset button ran
                                                     ~290px tall and this section always scrolled. -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="440"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.ColumnSpan="2"
                                                      x:Name="CkSettingsSync" Content="{loc:Get settings_sync_profiles}"
                                                      Style="{StaticResource K2SyncCheckBox}"
                                                      Click="CkSettingsSync_Click"
                                                      Checked="CkSettingsSync_Checked"/>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Get keyboard_language_layout}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                            <TextBlock Text="{loc:Get ev_layout}" VerticalAlignment="Center"
                                                           FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                            <ComboBox x:Name="CbEvKeyboardLayout" Width="200" Height="25" VerticalAlignment="Center"/>
                                                        </WrapPanel>

                                                        <TextBlock Text="{loc:Get settings_indicator_leds}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <CheckBox x:Name="CkCoreIndicatorLed" Height="25" Content="{loc:Get settings_enable_core_led}"
                                                      Click="CkCoreIndicatorLed_Click"/>
                                                        </WrapPanel>

                                                        <!-- Hardware factory reset — bare button, no Danger-zone box
                                                         (user request 2026-08-22: "lascia solo il bottone"), hint
                                                         moved to ToolTip. Wipes both the keyboard's own flash memory
                                                         AND K2's saved configuration for it — see
                                                         BtnSettingsFactoryReset_Click's doc comment. Distinct from the
                                                         sidebar's "Restore defaults", which only resets K2's profiles. -->
                                                        <Button x:Name="BtnSettingsFactoryReset" Content="{loc:Get settings_factory_reset}"
                                                            ToolTip="{loc:Get settings_factory_reset_hint}"
                                                            Padding="8,4" HorizontalAlignment="Left" Margin="0,16,0,0"
                                                            Click="BtnSettingsFactoryReset_Click"
                                                            Style="{StaticResource K2IconButton}" Tag="&#xE777;"/>
                                                    </StackPanel>

                                                    <!-- Right column: Game Mode. Sits below the sync checkbox's line
                                                         (Margin top) so the two never collide. -->
                                                    <StackPanel Grid.Column="1" Margin="0,28,0,0">
                                                        <TextBlock Text="{loc:Get settings_game_mode}" FontWeight="SemiBold" Margin="0,0,0,6"
                                                           ToolTip="{loc:Get settings_game_mode_tip}"/>
                                                        <CheckBox x:Name="CkGameModeMaster" Content="{loc:Get settings_game_mode_master}"
                                                          Click="CkGameModeMaster_Click" Height="25" Margin="0,0,0,2" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{loc:Get settings_game_mode_master_hint_ev}" Opacity="0.6"
                                                           TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11"/>
                                                        <WrapPanel Orientation="Horizontal">
                                                            <CheckBox x:Name="CkGameModeShiftTab" Content="{loc:Get settings_disable_shift_tab}" Click="CkGameMode_Click" Height="25" Margin="0,0,10,4"/>
                                                            <CheckBox x:Name="CkGameModeAltF4" Content="{loc:Get settings_disable_alt_f4}" Click="CkGameMode_Click" Height="25" Margin="0,0,10,4"/>
                                                            <CheckBox x:Name="CkGameModeWinKey" Content="{loc:Get settings_disable_win_key}" Click="CkGameMode_Click" Height="25" Margin="0,0,10,4"/>
                                                            <CheckBox x:Name="CkGameModeAltTab" Content="{loc:Get settings_disable_alt_tab}" Click="CkGameMode_Click" Height="25" Margin="0,0,0,4"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </ScrollViewer>

                                            <!-- ── USB RECORDER (debug only) ── (own ScrollViewer, same reason
                                             as Display Dial/Settings above) -->
                                            <ScrollViewer x:Name="PnlSecUsb" Visibility="Collapsed"
                                                      VerticalScrollBarVisibility="Auto" Grid.RowSpan="2">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{loc:Get usb_interface}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <ComboBox x:Name="CbUsbInterface" Width="200" Margin="0,0,8,0"/>
                                                        <Button x:Name="BtnUsbRefresh" Content="{loc:Get usb_detect}" Padding="6,2"
                                                        Margin="0,0,8,0" Click="BtnUsbRefresh_Click"
                                                        Style="{StaticResource K2IconButton}" Tag="&#xE72C;"/>
                                                        <TextBlock Text="{loc:Get usb_label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox x:Name="TxtUsbLabel" Width="120" Height="25" Margin="0,0,8,0" Text="basecamp"/>
                                                        <Button x:Name="BtnUsbRecord" Content="Start" Padding="8,2"
                                                        Click="BtnUsbRecord_Click"
                                                        Style="{StaticResource K2IconAccentButton}" Tag="&#xE7C8;"/>
                                                    </WrapPanel>
                                                    <TextBlock Grid.Row="1" x:Name="LblUsbStatus" Margin="0,0,0,4"
                                                       FontStyle="Italic" Foreground="#9A9AA2"
                                                       Text="{loc:Get usb_ready}"/>
                                                    <Expander Grid.Row="2" Header="{loc:Get usb_results}" IsExpanded="False"
                                                      x:Name="ExpUsbResults" Visibility="Collapsed">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="100"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <TextBox Grid.Row="0" x:Name="TxtUsbResults"
                                                             IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                                             VerticalScrollBarVisibility="Auto"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             TextWrapping="NoWrap" AcceptsReturn="True"/>
                                                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                                <Button x:Name="BtnUsbSave"       Content="{loc:Get usb_save_report}" Padding="6,2" Margin="0,0,6,0" Click="BtnUsbSave_Click"/>
                                                                <Button x:Name="BtnUsbOpenFolder" Content="{loc:Get act_folder}"      Padding="6,2"                   Click="BtnUsbOpenFolder_Click"/>
                                                            </WrapPanel>
                                                        </Grid>
                                                    </Expander>
                                                </Grid>
                                            </ScrollViewer>

                                        </Grid>
                                        <!-- end section panels grid -->

                                        <!-- SDK Log: debug only, always at bottom of settings panel -->
                                        <GroupBox Grid.Row="1" x:Name="GbEvLog" Header="{loc:Get ev_sdk_log}"
                                              Visibility="Collapsed" Margin="0,10,0,0">
                                            <TextBox x:Name="TxtEvLog"
                                                 IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Auto"
                                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                                 MaxHeight="100"/>
                                        </GroupBox>
                                    </Grid>
                                </Border>
                                <!-- end settings panel -->

                            </Grid>
                            <!-- end right column -->

                            <!-- Common actions (same rule for all devices): uniform width/height,
                             vertical stack, grouped Profile / Import / Device -->
                            <Border Grid.Column="2" Background="#111115" CornerRadius="6"
                                Margin="8,0,0,0" Padding="10" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Get profile}"
                                               Style="{StaticResource K2SideGroupHeader}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="BtnEvProfileMenu"
                                            Style="{StaticResource MacroRowIconButton}" Tag="&#xE712;"
                                            ToolTip="{loc:Get profile}" Click="BtnEvProfileMenu_Click"/>
                                    </Grid>
                                    <ListBox x:Name="LstEvProfile" Style="{StaticResource K2SideProfileList}"
                                         SelectionChanged="LstEvProfile_SelectionChanged"/>

                                    <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                    <TextBlock Text="{loc:Get device}" Style="{StaticResource K2SideGroupHeader}"/>
                                    <Button x:Name="BtnEvRename" Content="{loc:Get rename_device}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE8D3;"
                                        Click="BtnEvRename_Click"/>
                                    <Button x:Name="BtnEvRestoreDefaults" Content="{loc:Get restore_defaults}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE777;"
                                        Click="BtnEvRestoreDefaults_Click"/>

                                    <StackPanel x:Name="PnlEvDebugGroup" Visibility="Collapsed">
                                        <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                        <TextBlock Text="{loc:Get debug_group}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <Button x:Name="BtnEvRefresh" Content="{loc:Get refresh}"
                                            Style="{StaticResource K2SideActionButton}" Tag="&#xE72C;"
                                            Click="BtnEvRefresh_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <!-- end 3-pane -->
                    </Grid>
                </Grid>
                <!-- end PnlEverest -->

                <!-- ==================== Everest 60 (raw-HID lighting only) ==================== -->
                <!-- ==================== Everest 60 ====================
                 Same 3-column pattern as Makalu (see MainWindow.Makalu.cs
                 for the lessons learned about XAML-load-time event firing —
                 RbEv60SecRgb.IsChecked is set in InitEv60SectionNav, not
                 XAML). Device image is decorative only (no clickable
                 hotspots): unlike Makalu, no per-key/per-button remap
                 protocol exists for this device (raw-HID, firmware remap
                 never reverse-engineered — see architectural note above). -->
                <Grid x:Name="PnlEverest60" Visibility="Collapsed">
                    <Button Style="{StaticResource K2GuideButton}" Click="BtnGuide_Click"/>
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <!-- Fixed (not Auto): keeps the sidebar/content start position
                             identical across devices — same rule as PnlEverest. Connected
                             status + Refresh moved to the common-actions Debug group (see
                             PnlEv60DebugGroup below); this toolbar is debug-only like the
                             other devices', just with nothing to show yet for this one. -->
                            <RowDefinition Height="32"/>
                            <!-- toolbar -->
                            <RowDefinition Height="*"/>
                            <!-- sections/image/common columns -->
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <!-- sidebar -->
                                <ColumnDefinition Width="*"/>
                                <!-- image + section content -->
                                <!-- Fixed at 218, NOT Auto: Auto let a NoWrap log TextBox (now removed)
                                 drive the column's width to whatever its longest line needed, so it
                                 kept growing as new log lines came in. 218 = the Border's own
                                 Margin.Left="8" + its 210px desired width (190px buttons + 10px
                                 padding each side) — same effective pixel width Everest Max/MacroPad/
                                 DisplayPad's Auto column resolves to (safe there only because none of
                                 their common-actions content is unbounded-width). -->
                                <ColumnDefinition Width="218"/>
                                <!-- common actions -->
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: specific sections -->
                            <Border Grid.Column="0" Background="#111115" CornerRadius="6"
                                Margin="0,0,8,0" Padding="4">
                                <StackPanel>
                                    <RadioButton x:Name="RbEv60SecKeyBinding"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get ev60_key_binding}" GroupName="Ev60Sections"
                                             Checked="Ev60Section_Changed"/>
                                    <RadioButton x:Name="RbEv60SecLighting"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get rgb_lighting}" GroupName="Ev60Sections"
                                             Checked="Ev60Section_Changed"/>
                                    <RadioButton x:Name="RbEv60SecAppearance"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get appearance}" GroupName="Ev60Sections"
                                             Checked="Ev60Section_Changed"/>
                                    <RadioButton x:Name="RbEv60SecSettings"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get ev_settings}" GroupName="Ev60Sections"
                                             Checked="Ev60Section_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- CENTER: device image (top, fixed height) + selected section content (bottom, grows) -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <!-- Fixed height across all devices, matching MacroPad's box height
                                     when rotated to vertical orientation (Positioning section,
                                     90°/270°): the canvas is 510x370, but RotateTransform swaps its
                                     rendered footprint to 370x510, so 510 + 8px padding each side = 526
                                     is the tallest a device box needs to be. -->
                                    <RowDefinition Height="526"/>
                                    <!-- device -->
                                    <RowDefinition Height="*"/>
                                    <!-- section content: grows with window height -->
                                </Grid.RowDefinitions>

                                <!-- Interactive keyboard overlay: 64 paintable main-board keys (Key
                                 Lighting section, per-key custom color) over the flat everest60_board.png
                                 panel — same technique as Everest Max's CvsEvKeyboard/keybg.png. The
                                 numpad accessory is decorative-only (no known LED/remap protocol for
                                 it — see Everest60KeyboardLayout.Numpad); presence and side (left/right)
                                 are auto-detected via Everest60SdkNative.GetSubDeviceInfo and polled by
                                 Ev60RefreshStatus (MainWindow.Everest60.cs) — CvsEv60Numpad is moved to
                                 either side of SpEv60Layout and BrushEv60NumpadBg mirrored for "right"
                                 (no separate right-side art exists — see EV60_NumpadLeft.png, no
                                 EV60_NumpadRight.png in Base Camp's own assets). -->
                                <!-- BdrEv60DeviceBox + CvsEv60RubberBand implement Key Lighting's
                                 rectangular multi-LED selection (drag a square over keys/numpad/border
                                 squares to paint them all at once) — ported from Everest Max's
                                 BdrEvDeviceBox/CvsEvRubberBand (MainWindow.CustomLighting.cs's
                                 EvDeviceBox_* is the pattern Ev60DeviceBox_* in
                                 MainWindow.Everest60.cs mirrors), user request 2026-07-25. Preview
                                 (tunnel) events so a drag can START on a key Button without the Button
                                 swallowing the gesture; a plain click still reaches the Button normally
                                 because the rubber band only engages past a small drag threshold. -->
                                <Border Grid.Row="0" Background="#18181C" CornerRadius="6" Padding="8"
                                    x:Name="BdrEv60DeviceBox"
                                    PreviewMouseLeftButtonDown="Ev60DeviceBox_MouseDown"
                                    PreviewMouseMove="Ev60DeviceBox_MouseMove"
                                    PreviewMouseLeftButtonUp="Ev60DeviceBox_MouseUp">
                                    <Grid>
                                        <StackPanel x:Name="SpEv60Layout" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- +20% zoom on request, same as Everest Max's SpEvLayout:
                                         LayoutTransform (not RenderTransform) so the Grid/Border
                                         re-measures at the scaled size and WPF's hit-testing keeps
                                         mapping clicks to the right Button automatically — no changes
                                         needed to Everest60KeyboardLayout's X/Y/W/H math. -->
                                            <StackPanel.LayoutTransform>
                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                            </StackPanel.LayoutTransform>
                                            <!-- Wrapped in a Grid (was a bare Canvas) so a same-size border
                                         overlay can share its cell — same technique as GrdEv60KeyColumn
                                         below/Everest Max's GrdEvNumpadColumn (MainWindow.xaml). Margin
                                         moved here from the bare Canvas (MainWindow.Everest60.cs's
                                         ApplyEv60NumpadGap sets it, since this Grid — not the Canvas — is
                                         SpEv60Layout's actual child now). -->
                                            <Grid x:Name="GrdEv60NumpadColumn" Margin="0,0,6,0">
                                                <Canvas x:Name="CvsEv60Numpad" Width="154" Height="186"
                                                ClipToBounds="True"
                                                Visibility="Collapsed">
                                                    <Canvas.Background>
                                                        <ImageBrush x:Name="BrushEv60NumpadBg"
                                                            ImageSource="Assets/everest60_numpad.png" Stretch="Fill"/>
                                                    </Canvas.Background>
                                                </Canvas>
                                                <!-- Numpad-ring paint overlay (Key Lighting's paint mode only):
                                             22 small squares around the numpad accessory's bezel, built in
                                             code (BuildEv60NumpadBorderSquares, MainWindow.Everest60.cs) —
                                             mirrors CvsEv60BorderMain below. Gated on numpad presence too
                                             (there's nothing to draw a ring around when it's unplugged), see
                                             UpdateEv60BorderOverlayVisibility. Same NO-Background reasoning as
                                             CvsEv60BorderMain. -->
                                                <Canvas x:Name="CvsEv60BorderNumpad" Width="154" Height="186"
                                                Panel.ZIndex="2"
                                                Visibility="Collapsed"/>
                                            </Grid>
                                            <!-- Wrapped in a Grid (was a bare Canvas) so a same-size border
                                         overlay can share its cell — same technique as Everest Max's
                                         GrdEvKeyColumn/CvsEvBorderMain (MainWindow.xaml). -->
                                            <Grid x:Name="GrdEv60KeyColumn">
                                                <Canvas x:Name="CvsEv60Keyboard" Width="504" Height="186"
                                                ClipToBounds="True">
                                                    <Canvas.Background>
                                                        <ImageBrush ImageSource="Assets/everest60_board.png" Stretch="Fill"/>
                                                    </Canvas.Background>
                                                </Canvas>
                                                <!-- Border/side-LED paint overlay (Key Lighting's paint mode only):
                                             44 small squares around the main board's bezel, built in code
                                             (BuildEv60BorderSquares, MainWindow.Everest60.cs) — mirrors
                                             Everest Max's CvsEvBorderMain. NO Background (see that comment for
                                             why: a hit-testable Transparent background at ZIndex 2 would
                                             swallow every key click while paint mode is on). -->
                                                <Canvas x:Name="CvsEv60BorderMain" Width="504" Height="186"
                                                Panel.ZIndex="2"
                                                Visibility="Collapsed"/>
                                            </Grid>
                                        </StackPanel>
                                        <!-- Rubber-band overlay for rectangular multi-LED selection: same
                                     Grid cell as SpEv60Layout so it covers the whole device box;
                                     IsHitTestVisible=False so it never steals clicks — the Border's
                                     Preview handlers drive it. -->
                                        <Canvas x:Name="CvsEv60RubberBand" IsHitTestVisible="False">
                                            <Rectangle x:Name="RectEv60RubberBand" Visibility="Collapsed"
                                               Stroke="#5BBEC3" StrokeThickness="1"
                                               StrokeDashArray="3 2" Fill="#335BBEC3"/>
                                        </Canvas>
                                    </Grid>
                                </Border>

                                <!-- Bottom section panel: grows with the window (Row="*" above); MinHeight
                                 keeps its old fixed size as a floor so it doesn't collapse below the
                                 tallest section (RGB Lighting / Side Ring). -->
                                <Border Grid.Row="1" Background="#14141A"
                                    BorderBrush="#2A2A32" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,8,0,0"
                                    MinHeight="150">
                                    <!-- 2026-07-14: no more shared ScrollViewer wrapping all three
                                         sections — same reasoning as Everest Max's BdrEvSettingsPanel
                                         (see its comment): a ScrollViewer gives its content infinite
                                         available height, so Ev60KeyBindingPanel's Grid "*" row could
                                         never actually stretch LvEv60Keys to fill this Border (user
                                         request: "make the mapped-keys box exactly like Everest Max").
                                         Each section now owns its own overflow instead: Ev60RgbPanel
                                         already had its own internal ScrollViewer (MaxHeight=260);
                                         PnlEv60Settings gets one here, on the section root itself, same
                                         pattern as Everest Max's PnlSecRgb/PnlSecDial/PnlSecSettings
                                         (ScrollViewer IS the named/toggled element). -->
                                    <Grid>
                                        <!-- All three default Collapsed: InitEv60SectionNav (code-behind)
                                             sets RbEv60SecKeyBinding.IsChecked=true at startup, which fires
                                             Ev60Section_Changed -> ShowEv60Section(Ev60KeyBindingPanel) —
                                             but ShowEv60Section only COLLAPSES the previously active panel
                                             (none yet, on first run), it never assumes the others start
                                             hidden. Ev60RgbPanel previously had no explicit Visibility here
                                             (implicit default = Visible), so it stayed visible underneath
                                             Ev60KeyBindingPanel until the user manually clicked into
                                             Lighting once — visible as both sections' content overlapping
                                             on first opening the Everest 60 tab. -->
                                        <local:Everest60RgbPanel x:Name="Ev60RgbPanel" Loaded="Ev60RgbPanel_Loaded" Visibility="Collapsed"/>
                                        <local:Everest60KeyBindingPanel x:Name="Ev60KeyBindingPanel" Visibility="Collapsed"/>

                                        <!-- ── SETTINGS ── Keycap Appearance: purely cosmetic, same
                                             on-screen-only semantics as MainWindow.KeycapAppearance.cs
                                             for Everest Max (no live LED tick blend modes here, since
                                             this raw-HID board has no GetColorData-equivalent readback
                                             to blend with — just a static base/text color choice).
                                             Layout: locale legend selector (Everest60KeyboardLayout.GetMainBoard),
                                             same physical 64-key board for every locale (no ISO variant on this
                                             hardware — confirmed no backtick/ISO-102 key) — only the printed
                                             legends change, LED index/physical position stays fixed. -->
                                        <!-- ── APPEARANCE ── Keycap appearance: purely cosmetic, global
                                             (not per-profile — split out of Settings per user request
                                             2026-08-22, same reasoning as Everest Max's PnlSecAppearance). -->
                                        <ScrollViewer x:Name="PnlEv60Appearance"
                                                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Get settings_keycap_group}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="{loc:Get settings_keycap_color}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <RadioButton x:Name="RbEv60KeycapBlack" Content="{loc:Get settings_keycap_black}"
                                                         GroupName="Ev60KeycapColor" VerticalAlignment="Center"
                                                         Margin="0,0,10,0" Checked="RbEv60KeycapColor_Checked"/>
                                                    <RadioButton x:Name="RbEv60KeycapWhite" Content="{loc:Get settings_keycap_white}"
                                                         GroupName="Ev60KeycapColor" VerticalAlignment="Center"
                                                         Margin="0,0,10,0" Checked="RbEv60KeycapColor_Checked"/>
                                                    <RadioButton x:Name="RbEv60KeycapCustom" Content="{loc:Get settings_keycap_custom}"
                                                         GroupName="Ev60KeycapColor" VerticalAlignment="Center"
                                                         Margin="0,0,6,0" Checked="RbEv60KeycapColor_Checked"/>
                                                    <Button x:Name="BtnEv60KeycapCustomColor" Width="30" Height="30"
                                                    Background="#404040" BorderThickness="2" BorderBrush="#3A3A40"
                                                    Click="BtnEv60KeycapCustomColor_Click" Margin="5,0,0,0"/>
                                                </WrapPanel>
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="{loc:Get settings_keycap_text_color}" VerticalAlignment="Center" Margin="0,0,6,0" Padding="0,0,18,0"/>
                                                    <RadioButton x:Name="RbEv60KeycapTextBlack" Content="{loc:Get settings_keycap_black}"
                                                         GroupName="Ev60KeycapTextColor" VerticalAlignment="Center"
                                                         Margin="0,0,10,0" Checked="RbEv60KeycapTextColor_Checked"/>
                                                    <RadioButton x:Name="RbEv60KeycapTextWhite" Content="{loc:Get settings_keycap_white}"
                                                         GroupName="Ev60KeycapTextColor" VerticalAlignment="Center"
                                                         Margin="0,0,10,0" Checked="RbEv60KeycapTextColor_Checked"/>
                                                    <RadioButton x:Name="RbEv60KeycapTextCustom" Content="{loc:Get settings_keycap_custom}"
                                                         GroupName="Ev60KeycapTextColor" VerticalAlignment="Center"
                                                         Margin="0,0,6,0" Checked="RbEv60KeycapTextColor_Checked"/>
                                                    <Button x:Name="BtnEv60KeycapTextColor" Width="30" Height="30"
                                                    Background="White" BorderThickness="2" BorderBrush="#3A3A40"
                                                    Click="BtnEv60KeycapTextColor_Click" Margin="5,0,0,0"/>
                                                </WrapPanel>
                                                <!-- Keycap style: imported from Everest Max's Settings section
                                             (settings_keycap_style/CbEvKeycapStyle). No live LED tick to
                                             blend with on this raw-HID board, so the "live" signal each
                                             style blends with is the Key Lighting section's painted
                                             per-key color instead (see ApplyEv60KeycapAppearanceToAllKeys) —
                                             applies to the numpad too (always the "off" baseline there,
                                             since it's never painted). -->
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="{loc:Get settings_keycap_style}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox x:Name="CbEv60KeycapStyle" Width="240"
                                                      SelectionChanged="CbEv60KeycapStyle_SelectionChanged" Margin="4,0,0,0"/>
                                                </WrapPanel>
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <CheckBox x:Name="CkEv60KeycapTranslucentLegend" Content="{loc:Get settings_keycap_translucent_legend}"
                                                      Click="CkEv60KeycapTranslucentLegend_Click"/>
                                                </WrapPanel>

                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <CheckBox x:Name="CkEv60KeycapEditMode" Content="{loc:Get settings_keycap_edit_individual}"
                                                      Click="CkEv60KeycapEditMode_Click" Margin="0,5,0,0"/>
                                                    <Path Style="{StaticResource K2HintIcon}" Margin="8,5,0,0"
                                                          ToolTip="{loc:Get settings_keycap_edit_individual_hint}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <ScrollViewer x:Name="PnlEv60Settings"
                                                      VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                                <!-- 2026-08-28: brought to full parity with Everest Max's PnlSecSettings
                                                     (user request "la sezione settings di Everest 60 ... uguale a everest
                                                     max"): same two-column 440/* split, the top-right "sync across
                                                     profiles" checkbox, and a hardware factory-reset button.
                                                     Everest 60 ships a single body art (everest60_board.png, no
                                                     black/silver variant), so the keyboard-body-colour radios Everest
                                                     Max has in this section have no equivalent here and are omitted. -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="440"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Grid.ColumnSpan="2"
                                                      x:Name="CkEv60SettingsSync" Content="{loc:Get settings_sync_profiles}"
                                                      Style="{StaticResource K2SyncCheckBox}"
                                                      Click="CkEv60SettingsSync_Click"/>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{loc:Get keyboard_language_layout}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                            <TextBlock Text="{loc:Get ev_layout}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                            <ComboBox x:Name="CbEv60KeyboardLayout" Width="200" Height="25" VerticalAlignment="Center"/>
                                                        </WrapPanel>

                                                        <TextBlock Text="{loc:Get settings_indicator_leds}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <CheckBox x:Name="CkEv60CoreIndicatorLed" Height="25" Content="{loc:Get settings_enable_core_led}"
                                                      Click="CkEv60CoreIndicatorLed_Click"/>
                                                        </WrapPanel>

                                                        <!-- Hardware factory reset — mirrors Everest Max's
                                                         BtnSettingsFactoryReset (bare button, hint in ToolTip). Puts the
                                                         keyboard's key bindings back to factory (Everest60SdkService.ResetKeys —
                                                         the deepest reset this raw-HID board exposes, there is no LED-flash
                                                         wipe) AND wipes K2's saved configuration for it. -->
                                                        <Button x:Name="BtnEv60SettingsFactoryReset" Content="{loc:Get settings_factory_reset}"
                                                            ToolTip="{loc:Get settings_factory_reset_hint}"
                                                            Padding="8,4" HorizontalAlignment="Left" Margin="0,16,0,0"
                                                            Click="BtnEv60SettingsFactoryReset_Click"
                                                            Style="{StaticResource K2IconButton}" Tag="&#xE777;"/>
                                                    </StackPanel>

                                                    <!-- Right column: Game Mode. Ported from Everest Max 2026-07-26;
                                                     same fields (Everest60Settings table DisableShift/DisableAltF4/
                                                     DisableWin/DisableAltTab), no raw-HID/SDK command to apply them has
                                                     been reverse-engineered for this device yet — persisted + imported
                                                     like every other Ev60 setting, not yet sent to the device. -->
                                                    <StackPanel Grid.Column="1" Margin="0,28,0,0">
                                                        <TextBlock Text="{loc:Get settings_game_mode}" FontWeight="SemiBold" Margin="0,0,0,6"
                                                           ToolTip="{loc:Get settings_game_mode_tip}"/>
                                                        <CheckBox x:Name="CkEv60GameModeMaster" Content="{loc:Get settings_game_mode_master}"
                                                          Click="CkEv60GameModeMaster_Click" Height="25" Margin="0,0,0,2" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{loc:Get settings_game_mode_master_hint_ev60}" Opacity="0.6"
                                                           TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11"/>
                                                        <WrapPanel Orientation="Horizontal">
                                                            <CheckBox x:Name="CkEv60GameModeShiftTab" Content="{loc:Get settings_disable_shift_tab}" Click="CkEv60GameMode_Click" Height="25" Margin="0,0,10,4"/>
                                                            <CheckBox x:Name="CkEv60GameModeAltF4" Content="{loc:Get settings_disable_alt_f4}" Click="CkEv60GameMode_Click" Height="25" Margin="0,0,10,4"/>
                                                            <CheckBox x:Name="CkEv60GameModeWinKey" Content="{loc:Get settings_disable_win_key}" Click="CkEv60GameMode_Click" Height="25" Margin="0,0,10,4"/>
                                                            <CheckBox x:Name="CkEv60GameModeAltTab" Content="{loc:Get settings_disable_alt_tab}" Click="CkEv60GameMode_Click" Height="25" Margin="0,0,0,4"/>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Grid>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- RIGHT: generic settings — Profile/Import/Export now backed by
                             Everest60Store (see MainWindow.Everest60.cs), same pattern as
                             Everest Max's LstEvProfile block. Device rename via AppSettings unchanged. -->
                            <Border Grid.Column="2" Background="#111115" CornerRadius="6"
                                Margin="8,0,0,0" Padding="10" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Get profile}"
                                               Style="{StaticResource K2SideGroupHeader}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="BtnEv60ProfileMenu"
                                            Style="{StaticResource MacroRowIconButton}" Tag="&#xE712;"
                                            ToolTip="{loc:Get profile}" Click="BtnEv60ProfileMenu_Click"/>
                                    </Grid>
                                    <ListBox x:Name="LstEv60Profile" Style="{StaticResource K2SideProfileList}"
                                         SelectionChanged="LstEv60Profile_SelectionChanged"/>

                                    <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                    <TextBlock Text="{loc:Get device}" Style="{StaticResource K2SideGroupHeader}"/>
                                    <Button x:Name="BtnEv60Rename" Content="{loc:Get rename_device}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE8AC;"
                                        Click="BtnEv60Rename_Click"/>
                                    <Button x:Name="BtnEv60RestoreDefaults" Content="{loc:Get restore_defaults}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE777;"
                                        Click="BtnEv60RestoreDefaults_Click"/>

                                    <!-- Debug group: same position/pattern as PnlEvDebugGroup/PnlMpDebugGroup/
                                     PnlDpDebugGroup (right after Device, toggled by ApplyEv60DebugMode).
                                     Connected status + manual Refresh moved here from the toolbar above —
                                     the 3s poll (Ev60RefreshStatus) keeps updating LblEv60Status regardless
                                     of whether this group is visible. -->
                                    <StackPanel x:Name="PnlEv60DebugGroup" Visibility="Collapsed">
                                        <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                        <TextBlock Text="{loc:Get debug_group}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <TextBlock x:Name="LblEv60Status" Text="{loc:Get ev60_status_disconnected}"
                                               FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Button x:Name="BtnEv60Refresh" Content="{loc:Get ev60_refresh}"
                                            Style="{StaticResource K2SideActionButton}" Tag="&#xE72C;"
                                            Click="BtnEv60Refresh_Click"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- end PnlEverest60 -->

                <!-- ==================== Makalu (mouse) ====================
                 Sections (RGB Lighting/DPI/Remap/Settings) at left, device
                 image with clickable remap hotspots + selected section
                 content in the middle, generic Profile/Import/Export/Device
                 column at right — same pattern as MacroPad/Everest/
                 DisplayPad. Section content is split into two UserControls
                 (MakaluRgbSettingsPanel, MakaluDpiRemapPanel), kept as
                 DIRECT MainWindow children (not nested inside another
                 custom control — see MakaluDpiRemapPanel.xaml for why that
                 specific nesting is unsafe).

                 The "Invalid Program: attempted to call a UnmanagedCallersOnly
                 method from managed code" crash this layout used to trigger
                 (2026-07-10, root-caused with WinDbg+SOS) was NOT a JIT/CLR
                 bug: it was RbMkSecRgb's IsChecked="True" firing Checked
                 synchronously mid-InitializeComponent(), before MkRgbSettings
                 (declared later in this file) was assigned — a plain null
                 ref that .NET's crash reporter mislabeled with that generic
                 message. Fixed by setting IsChecked in code (see
                 InitMkSectionNav in MainWindow.Makalu.cs) instead of XAML.
                 A second instance of the same pattern (Slider.Minimum
                 coercing Value during load, firing ValueChanged before a
                 later-declared TextBox was assigned) was found and fixed in
                 MakaluDpiRemapPanel. See CHANGELOG.md 2026-07-10 for the
                 full WinDbg session — any new event handler wired to a
                 property that gets a literal value in XAML needs to guard
                 against firing before InitializeComponent() finishes. -->
                <Grid x:Name="PnlMakalu" Visibility="Collapsed">
                    <Button Style="{StaticResource K2GuideButton}" Click="BtnGuide_Click"/>
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <!-- Fixed (not Auto): keeps the sidebar/content start position
                             identical across devices — same rule as PnlEverest. Connected
                             status + Refresh moved to the common-actions Debug group (see
                             PnlMkDebugGroup below); this toolbar is debug-only like the
                             other devices', just with nothing to show yet for this one. -->
                            <RowDefinition Height="32"/>
                            <!-- toolbar -->
                            <RowDefinition Height="*"/>
                            <!-- sections/image/common columns -->
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <!-- sidebar -->
                                <ColumnDefinition Width="*"/>
                                <!-- image + section content -->
                                <!-- Fixed at 218, NOT Auto: a NoWrap log TextBox lives in this column
                                 (TxtMkLog) — Auto would let it drive the column's width to whatever
                                 its longest line needs, growing further with every new log line (the
                                 exact bug hit on Everest 60's identical column, see MainWindow.xaml's
                                 Everest 60 grid). 218 = the Border's own Margin.Left="8" + its 210px
                                 desired width (190px buttons + 10px padding each side) — same
                                 effective pixel width Everest Max/MacroPad/DisplayPad's Auto column
                                 resolves to (safe there only because none of their common-actions
                                 content is unbounded-width). -->
                                <ColumnDefinition Width="218"/>
                                <!-- common actions -->
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: specific sections -->
                            <Border Grid.Column="0" Background="#111115" CornerRadius="6"
                                Margin="0,0,8,0" Padding="4">
                                <StackPanel>
                                    <!-- Order matches MacroPad/DisplayPad/Everest 60: Key Binding
                                     first (also the default section, see InitMkSectionNav),
                                     device-specific Lighting in the middle, Settings last. DPI
                                     is no longer a section of its own — its levels list now
                                     lives inside Settings (right column), same as Base Camp's
                                     own Makalu Settings page.
                                     IsChecked is set in code (InitMkSectionNav), not here: WPF fires
                                     Checked synchronously the moment BAML sets IsChecked="True", i.e.
                                     mid-way through InitializeComponent() — MkRgbSettings/MkDpiRemap
                                     (declared later in this file) aren't assigned yet at that point,
                                     so MkSection_Changed would null-ref. Root-caused via WinDbg+SOS,
                                     see CHANGELOG.md 2026-07-10. -->
                                    <RadioButton x:Name="RbMkSecRemap"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get ev_key_binding}" GroupName="MkSections"
                                             Checked="MkSection_Changed"/>
                                    <RadioButton x:Name="RbMkSecRgb"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get rgb_lighting}" GroupName="MkSections"
                                             Checked="MkSection_Changed"/>
                                    <RadioButton x:Name="RbMkSecSettings"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get makalu_settings_title}" GroupName="MkSections"
                                             Checked="MkSection_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- CENTER: interactive device image (top, fixed height) + selected section content (bottom, grows) -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <!-- Fixed height across all devices, matching MacroPad's box height
                                     when rotated to vertical orientation (Positioning section,
                                     90°/270°): the canvas is 510x370, but RotateTransform swaps its
                                     rendered footprint to 370x510, so 510 + 8px padding each side = 526
                                     is the tallest a device box needs to be — comfortably fits the
                                     mouse image's 422px height too. -->
                                    <RowDefinition Height="526"/>
                                    <!-- device -->
                                    <RowDefinition Height="*"/>
                                    <!-- section content: grows with window height -->
                                </Grid.RowDefinitions>

                                <!-- Preview (tunnel) mouse events on THIS Border (not on CvsMkCustomSquares
                                 itself) so a rubber-band drag started over EMPTY space between squares is
                                 still caught: a Canvas with no Background isn't hit-testable on its empty
                                 area (only its children are), so attaching the handlers there missed any
                                 drag that didn't start exactly on a square — this Border has a real opaque
                                 Background, so it's hit-testable everywhere within the device box, same
                                 reasoning as Everest Max/60's BdrEvDeviceBox (MainWindow.CustomLighting.cs).
                                 The handlers themselves no-op unless Custom Lighting is active. -->
                                <Border Grid.Row="0" Background="#18181C" CornerRadius="6" Padding="8"
                                        x:Name="BdrMkDeviceBox"
                                        PreviewMouseLeftButtonDown="BdrMkDeviceBox_MouseDown"
                                        PreviewMouseMove="BdrMkDeviceBox_MouseMove"
                                        PreviewMouseLeftButtonUp="BdrMkDeviceBox_MouseUp">
                                    <!-- A Canvas (not a Grid) so the 190px-wide mouse image can sit
                                     offset within a wider host, leaving flanking columns for the
                                     Custom Lighting square overlay below (MkDeviceImageOffsetX in
                                     MainWindow.Makalu.cs) — same width/height numbers duplicated there
                                     for square/leader-line placement, see that file's geometry consts. -->
                                    <Canvas x:Name="CvsMkDeviceHost" Width="330" Height="422"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- LED ring preview host — BEHIND the Image on purpose: the ring
                                         area in makalu_mouse.png is a genuinely TRANSPARENT cutout (not
                                         painted pixels, confirmed 2026-07-12), so the colored ring is
                                         rendered underneath and shows through the gap, same as how the
                                         real backlit ring/Base Camp's own overlay works. See
                                         BuildMkLedRing in MainWindow.Makalu.cs. Only relevant while the
                                         Lighting section is active — ImgMkMouse switches back to the
                                         opaque makalu_mouse_rainbow.png (no cutout) for every other
                                         section, see MkSection_Changed/MkUpdateMouseImage. -->
                                        <Canvas x:Name="CvsMkRingBack" Width="190" Height="422" Canvas.Left="70"/>
                                        <Image x:Name="ImgMkMouse" Source="Assets/makalu_mouse.png" Width="190" Stretch="Uniform" Canvas.Left="70"/>
                                        <!-- Hotspots positioned in BuildMkHotspots (Canvas coords match
                                         the Image's rendered 190×422 size at Stretch=Uniform, offset by
                                         the same Canvas.Left as the image itself). -->
                                        <Canvas x:Name="CvsMkHotspots" Width="190" Height="422" Canvas.Left="70"/>
                                        <!-- 8 Custom Lighting squares + leader lines pointing at their LED's
                                         ring sector (user request 2026-07-27, matches Base Camp's own
                                         reference photo) — topmost so the lines draw over the mouse body.
                                         Built/positioned by MainWindow.Makalu.cs's BuildMkCustomSquares;
                                         visible only while Custom is the active Lighting effect. -->
                                        <Canvas x:Name="CvsMkCustomSquares" Width="330" Height="422" Visibility="Collapsed"/>
                                        <!-- Rubber-band rectangle — a SEPARATE sibling, not a child of
                                         CvsMkCustomSquares: BuildMkCustomSquares calls
                                         CvsMkCustomSquares.Children.Clear() every rebuild, which would
                                         silently rip this out of the tree too (2026-07-27 bug: the drag
                                         worked — squares got painted — but the rectangle itself never
                                         rendered, because Visibility/Canvas.Left/Top were being set on an
                                         element no longer attached to anything). Declared LAST so it draws
                                         on top of the squares. -->
                                        <Rectangle x:Name="RectMkRubberBand" Visibility="Collapsed" IsHitTestVisible="False"
                                           Stroke="#5BBEC3" StrokeThickness="1"
                                           StrokeDashArray="3 2" Fill="#335BBEC3"/>
                                    </Canvas>
                                </Border>

                                <!-- Bottom section panel: grows with the window (Row="*" above); MinHeight
                                 keeps its old fixed size as a floor so it doesn't collapse below the
                                 tallest section (RGB / DPI / Remap / Settings). Both controls are
                                 ALWAYS present (siblings in the same cell); each toggles its own
                                 SecXxx children's Visibility, so only the active section is ever painted.
                                 MkDpiRemap sits OUTSIDE the ScrollViewer (2026-07-27, user report: its
                                 Key Binding list rendered as an unreadable 2-3px sliver) — a ScrollViewer
                                 measures its content with infinite available height, so SecRemap's own
                                 Grid.RowDefinition Height="*" list row had nothing real to stretch
                                 against and collapsed to its minimum. Same fix Everest 60's own Key
                                 Binding panel already needed (see Everest60KeyBindingPanel.xaml's
                                 2026-07-14 doc comment) — MkRgbSettings keeps the ScrollViewer since its
                                 Settings section (DPI levels + device settings) has enough content to
                                 occasionally need it on a short window. -->
                                <Border Grid.Row="1" Background="#14141A"
                                    BorderBrush="#2A2A32" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,8,0,0"
                                    MinHeight="180">
                                    <Grid>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <local:MakaluRgbSettingsPanel x:Name="MkRgbSettings"/>
                                        </ScrollViewer>
                                        <local:MakaluDpiRemapPanel x:Name="MkDpiRemap"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- RIGHT: generic settings — Profile/Import/Export now backed by
                             MakaluStore (see MainWindow.Makalu.cs), same pattern as Everest Max's
                             LstEvProfile block. Device rename via AppSettings unchanged. -->
                            <Border Grid.Column="2" Background="#111115" CornerRadius="6"
                                Margin="8,0,0,0" Padding="10" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Get profile}"
                                               Style="{StaticResource K2SideGroupHeader}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="BtnMkProfileMenu"
                                            Style="{StaticResource MacroRowIconButton}" Tag="&#xE712;"
                                            ToolTip="{loc:Get profile}" Click="BtnMkProfileMenu_Click"/>
                                    </Grid>
                                    <ListBox x:Name="LstMkProfile" Style="{StaticResource K2SideProfileList}"
                                         SelectionChanged="LstMkProfile_SelectionChanged"/>

                                    <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                    <TextBlock Text="{loc:Get device}" Style="{StaticResource K2SideGroupHeader}"/>
                                    <Button x:Name="BtnMkRename" Content="{loc:Get rename_device}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE8AC;"
                                        Click="BtnMkRename_Click"/>
                                    <Button x:Name="BtnMkRestoreDefaults" Content="{loc:Get restore_defaults}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE777;"
                                        Click="BtnMkRestoreDefaults_Click"/>

                                    <!-- Debug group: same position/pattern as PnlEvDebugGroup/PnlMpDebugGroup/
                                     PnlDpDebugGroup (right after Device, toggled by ApplyMkDebugMode).
                                     Connected status + manual Refresh moved here from the toolbar above —
                                     the 3s poll (MkRefreshStatus) keeps updating LblMkStatus regardless
                                     of whether this group is visible. -->
                                    <StackPanel x:Name="PnlMkDebugGroup" Visibility="Collapsed">
                                        <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                        <TextBlock Text="{loc:Get debug_group}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <TextBlock x:Name="LblMkStatus" Text="{loc:Get makalu_status_disconnected}"
                                               FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Button x:Name="BtnMkRefresh" Content="{loc:Get makalu_refresh}"
                                            Style="{StaticResource K2SideActionButton}" Tag="&#xE72C;"
                                            Click="BtnMkRefresh_Click"/>
                                    </StackPanel>

                                    <!-- Log: debug only, same gating as GbEvLog (Everest) — toggled by
                                     ApplyMkDebugMode, see MainWindow.Makalu.cs. -->
                                    <StackPanel x:Name="PnlMkLog" Visibility="Collapsed">
                                        <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                        <TextBlock Text="{loc:Get makalu_log}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <Border Background="#0F0F13" BorderBrush="#2A2A32" BorderThickness="1"
                                            CornerRadius="6" Padding="6" Height="110">
                                            <TextBox x:Name="TxtMkLog" IsReadOnly="True" FontFamily="Consolas" FontSize="10"
                                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                                 Background="Transparent" BorderThickness="0"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- end PnlMakalu -->

                <!-- ==================== MacroPad ==================== -->
                <Grid x:Name="PnlMacroPad" Visibility="Collapsed">
                    <Button Style="{StaticResource K2GuideButton}" Click="BtnGuide_Click"/>
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <!-- toolbar (fixed, see PnlEverest) -->
                            <RowDefinition Height="*"/>
                            <!-- main area -->
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- Debug-only: open/close driver manually -->
                            <Button x:Name="BtnOpen"    Content="{loc:Get open_driver}"     Click="BtnOpen_Click"
                                Style="{StaticResource K2IconAccentButton}" Tag="&#xE768;" Visibility="Collapsed"/>
                            <Button x:Name="BtnClose"   Content="{loc:Get close_driver}"    Margin="8,0,0,0" Click="BtnClose_Click"
                                Style="{StaticResource K2IconButton}" Tag="&#xE711;" Visibility="Collapsed"/>
                            <!-- Debug-only: AP controls -->
                            <Button x:Name="BtnApOn"   Content="AP Enable ON"  Padding="10,4" Visibility="Collapsed" Click="BtnApOn_Click"/>
                            <Button x:Name="BtnApOff"  Content="AP Enable OFF" Padding="10,4" Margin="6,0,0,0" Visibility="Collapsed" Click="BtnApOff_Click"/>
                            <Separator x:Name="SepMpApDbg" Margin="10,0" Visibility="Collapsed"/>
                            <!-- Debug-only: remap keys (see project rule) -->
                            <Button x:Name="BtnMapKeys" Content="{loc:Get remap_keys}" Click="BtnMapKeys_Click"
                                Style="{StaticResource K2IconButton}" Tag="&#xE765;" Visibility="Collapsed"/>
                            <TextBlock x:Name="LblSdk" Margin="16,6,0,0" FontStyle="Italic" Foreground="#9A9AA2" Visibility="Collapsed"/>
                        </WrapPanel>

                        <!-- ── sidebar (specific) | canvas + settings | common actions | debug ── -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <!-- sidebar -->
                                <ColumnDefinition Width="*"/>
                                <!-- canvas + settings -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- common actions (all devices) -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- debug -->
                            </Grid.ColumnDefinitions>

                            <!-- Left sidebar: device-specific section navigation -->
                            <Border Grid.Column="0" Background="#111115" CornerRadius="6"
                                Margin="0,0,8,0" Padding="4">
                                <StackPanel>
                                    <RadioButton x:Name="RbMpSecKeyBinding"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get ev_key_binding}" GroupName="MpSections"
                                             IsChecked="True" Checked="MpSection_Changed"/>
                                    <RadioButton x:Name="RbMpSecLed"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get rgb_lighting}" GroupName="MpSections"
                                             Checked="MpSection_Changed"/>
                                    <RadioButton x:Name="RbMpSecAppearance"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get appearance}" GroupName="MpSections"
                                             Checked="MpSection_Changed"/>
                                    <RadioButton x:Name="RbMpSecSettings"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get ev_settings}" GroupName="MpSections"
                                             Checked="MpSection_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- Middle: keys canvas (top) + settings panel (bottom).
                             No margin here (matches PnlEverest): the gap before the
                             common-actions column comes from that column's own left
                             margin, so this box is exactly as wide as Everest's. -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <!-- Fixed height across all devices: matches this canvas (510x370)
                                     rotated to vertical orientation (Positioning section, 90°/270°) —
                                     RotateTransform swaps its rendered footprint to 370x510, so
                                     510 + 8px padding each side = 526 is the tallest this box (and
                                     therefore every device's box) needs to be. -->
                                    <RowDefinition Height="526"/>
                                    <!-- device -->
                                    <RowDefinition Height="*"/>
                                    <!-- settings: grows with window height -->
                                </Grid.RowDefinitions>

                                <!-- BdrMpDeviceBox + CvsMpRubberBand: rectangular multi-key selection for
                                 Settings' "Edit individual keycaps" mode only (MacroPad has no per-key
                                 custom-lighting paint mode) — drag a square over multiple keys to open
                                 ONE KeycapCustomizeDialog for all of them, mirrors Everest/Everest 60's
                                 identical feature (MainWindow.CustomLighting.cs/MainWindow.Everest60.cs).
                                 User request 2026-07-26. -->
                                <Border Grid.Row="0" Background="#18181C" CornerRadius="6" Padding="8"
                                    x:Name="BdrMpDeviceBox"
                                    PreviewMouseLeftButtonDown="MpDeviceBox_MouseDown"
                                    PreviewMouseMove="MpDeviceBox_MouseMove"
                                    PreviewMouseLeftButtonUp="MpDeviceBox_MouseUp">
                                  <Grid>
                                    <Canvas x:Name="CvsMacroKeys" Width="510" Height="370" ClipToBounds="True"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas.Background>
                                            <ImageBrush ImageSource="Assets/mkd_bg.png" Stretch="Fill"/>
                                        </Canvas.Background>
                                    </Canvas>
                                    <Canvas x:Name="CvsMpRubberBand" IsHitTestVisible="False">
                                        <Rectangle x:Name="RectMpRubberBand" Visibility="Collapsed"
                                               Stroke="#5BBEC3" StrokeThickness="1"
                                               StrokeDashArray="3 2" Fill="#335BBEC3"/>
                                    </Canvas>
                                  </Grid>
                                </Border>

                                <!-- Bottom settings panel: grows with the window (Row="*" above); MinHeight
                                 keeps its old fixed size as a floor so it doesn't collapse below the
                                 tallest section (Key Binding / Orientation / LED Lighting). NOTE: no
                                 outer ScrollViewer anymore — see the matching comment on
                                 BdrEvSettingsPanel (Everest Max) for why; each section here now owns
                                 its own overflow behavior instead (Key Binding's Grid+ListView stretch
                                 for real; Orientation/LED Lighting/Settings each got their own
                                 ScrollViewer). -->
                                <Border x:Name="BdrMpSettingsPanel" Grid.Row="1" Background="#14141A"
                                    BorderBrush="#2A2A32" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,8,0,0"
                                    MinHeight="130">
                                    <Grid>

                                        <!-- ── KEY BINDING (keys are configured directly on the grid above;
                                         this list mirrors what's mapped, same list+column layout as
                                         Everest Max's Key Binding section — LvMpKeys only lists keys
                                         that HAVE an action, unlike the always-12 grid above). A Grid
                                         (not StackPanel) with an explicit Auto/* row split: StackPanel
                                         always sizes children to their natural height regardless of
                                         available space, so it can never stretch LvMpKeys to fill. ── -->
                                        <Grid x:Name="PnlMpSecKeyBinding" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <!-- hint text -->
                                                <RowDefinition Height="*"/>
                                                <!-- list + buttons: fills remaining height -->
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{loc:Get key_binding_hint}" Foreground="#9A9AA2"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>
                                                <ListView Grid.Column="0" x:Name="LvMpKeys" Margin="0,0,8,0"
                                                      SelectionChanged="LvMpKeys_SelectionChanged">
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                                                                    <Setter Property="Foreground" Value="#10302F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Display}" Padding="2"/>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                    <Button x:Name="BtnMpConfigure" Content="{loc:Get ev_configure}"
                                                        Padding="8,4" Click="BtnMpConfigure_Click"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                                        IsEnabled="False"/>
                                                    <Button x:Name="BtnMpRemoveAction" Content="{loc:Get ev_remove}"
                                                        Padding="8,4" Click="BtnMpRemoveAction_Click"
                                                        IsEnabled="False"
                                                        HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- ── LED LIGHTING ── (own ScrollViewer) -->
                                        <ScrollViewer x:Name="PnlMpSecLed"
                                                  VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                            <StackPanel>
                                                <!-- Preset effects row 1 (same grouping/order as Everest Max's
                                             PnlSecRgb: effect, speed, direction, rainbow, sync — see
                                             MainWindow.xaml PnlSecRgb) -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Height="27" Margin="0,0,0,15">
                                                        <TextBlock Text="{loc:Get rgb_effect}" VerticalAlignment="Center"/>
                                                        <ComboBox x:Name="CbMacroEffect" Width="140" Margin="26,0,12,0"
                                                      SelectionChanged="CbMacroEffect_SelectionChanged"
                                                      DropDownOpened="CbMacroEffect_DropDownOpened"
                                                      DropDownClosed="CbMacroEffect_DropDownClosed" Height="25"/>
                                                        <StackPanel x:Name="PnlMpSpeed" Orientation="Horizontal" >
                                                            <TextBlock Text="{loc:Get rgb_speed}" VerticalAlignment="Center" />
                                                            <Slider x:Name="SldMacroSpeed" Minimum="0" Maximum="100" Width="110"
                                                        TickFrequency="25" SmallChange="1" LargeChange="5" TickPlacement="BottomRight"
                                                        ValueChanged="SldMacroSpeed_ValueChanged" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                            <TextBlock x:Name="LblMacroSpeed" Text="50%" VerticalAlignment="Center"  MinWidth="36" Margin="10,0,0,0"/>
                                                        </StackPanel>




                                                        <TextBlock Text="{loc:Get led_backlight_label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <CheckBox x:Name="CkMacroBacklight" Style="{StaticResource K2InlineSwitch}"
                                                            VerticalAlignment="Center" IsChecked="True" Click="CkMacroBacklight_Click"/>
                                                        <!-- Auto-off row, moved here 2026-07-26 (user request: next to the
                                                     backlight switch, mirrors Everest Max's 2026-07-25 move) from its
                                                     old spot at the bottom of this section — same controls/handlers,
                                                     just relocated. -->
                                                        <CheckBox x:Name="CkMacroAutoOffEnable" Content="{loc:Get backlight_auto_off_enable}"
      Click="CkMacroAutoOffEnable_Click" VerticalAlignment="Center" Margin="16,0,10,0"/>
                                                        <TextBlock Text="{loc:Get backlight_auto_off_seconds}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBox x:Name="TxtMacroAutoOffSeconds" Width="60" TextAlignment="Center"
     LostFocus="TxtMacroAutoOffSeconds_LostFocus" Text="5" VerticalAlignment="Center" Height="25" Padding="3,2,3,0"/>
                                                        <TextBlock Text="{loc:Get unit_seconds}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Position comes entirely from K2SyncCheckBox (see Window.Resources)
                                                     so it lands in the exact same spot as Everest Max's CkEvSync /
                                                     CkSettingsSync / CkDialSync — no local alignment/margin here
                                                     (user request 2026-08-28: "allinea tutto"). -->
                                                    <CheckBox x:Name="CkMacroSync" Content="{loc:Get led_sync_profiles}"
                                                          Style="{StaticResource K2SyncCheckBox}"
                                                          Click="CkMacroSync_Click" Grid.ColumnSpan="2"/>

                                                </Grid>


                                                <!-- Whole-device preset controls (direction/color-mode/swatches) —
                                             hidden as a group when CbMacroEffect="Custom" (see UpdateMpCapabilities
                                             in MainWindow.MacroLed.cs), same pattern as Everest Max's
                                             PnlEvNormalControls/PnlEvCustomLighting swap. -->
                                                <StackPanel x:Name="PnlMpNormalControls">
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <StackPanel x:Name="PnlMpDirection" Orientation="Horizontal" Margin="0,0,12,0">
                                                            <TextBlock Text="{loc:Get rgb_direction}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <Border Style="{StaticResource K2SegmentedGroupBorder}">
                                                                <UniformGrid x:Name="GridMacroDirection" Rows="1"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <!-- Preset effects row 2: color mode (Single/Double/Rainbow, one
                                             mutually-exclusive vertical radio group) + swatches + on/off. -->
                                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <StackPanel Orientation="Vertical" Margin="0,0,20,0" VerticalAlignment="Center">
                                                            <RadioButton x:Name="RbMacroColorSingle" Content="{loc:Get rgb_single}" GroupName="MacroColorMode"
                                                                Margin="0,0,0,6" Checked="RbMacroColorMode_Checked" ToolTip="{loc:Get rgb_single_tip}"/>
                                                            <RadioButton x:Name="RbMacroColorDouble" Content="{loc:Get rgb_double}" GroupName="MacroColorMode"
                                                                Margin="0,0,0,6" Checked="RbMacroColorMode_Checked" ToolTip="{loc:Get rgb_double_tip}"/>
                                                            <RadioButton x:Name="RbMacroRainbow" Content="{loc:Get rgb_rainbow}" GroupName="MacroColorMode"
                                                                Checked="RbMacroColorMode_Checked" ToolTip="{loc:Get rgb_rainbow_tip}"/>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PnlMacroColor1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                                            <TextBlock Text="{loc:Get rgb_primary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <Button x:Name="BtnMacroColor1" Width="30" Height="30"
                                                        Background="#900000" BorderThickness="2"
                                                        BorderBrush="#3A3A40" Click="BtnMacroColor_Click" Tag="1"/>
                                                        </StackPanel>
                                                        <StackPanel x:Name="PnlMacroColor2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{loc:Get rgb_secondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                            <Button x:Name="BtnMacroColor2" Width="30" Height="30"
                                                        Background="#1A1A1E" BorderThickness="2"
                                                        BorderBrush="#3A3A40" Click="BtnMacroColor_Click" Tag="2"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- Per-key Custom lighting — shown only for CbMacroEffect="Custom".
                                             Mirrors Everest Max's PnlEvCustomLighting (MainWindow.CustomLighting.cs)
                                             adapted to the MacroPad's own verified protocol (12 physical keys,
                                             no LED subdivision) — see MainWindow.MpCustomLighting.cs. -->
                                                <StackPanel x:Name="PnlMpCustomLighting" Visibility="Collapsed">
                                                    <TextBlock Text="{loc:Get custom_lighting}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                    <TextBlock Text="{loc:Get custom_paint_hint}"
                                               Foreground="#9A9AA2" FontStyle="Italic"
                                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{loc:Get custom_paint_effect}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <ComboBox x:Name="CbMpCustomPaintEffect" Width="130"
                                                      SelectionChanged="CbMpCustomPaintEffect_SelectionChanged"/>
                                                        <TextBlock x:Name="LblMpCustomColorStatic" Text="{loc:Get custom_color}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                                        <Button x:Name="BtnMpCustomBrushColor" Width="30" Height="30"
                                                Background="#FF0000" BorderThickness="2"
                                                BorderBrush="#3A3A40" Click="BtnMpCustomBrushColor_Click"/>
                                                    </StackPanel>

                                                    <StackPanel x:Name="PnlMpCustomFxParams" Visibility="Collapsed" Margin="0,0,0,6">
                                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                            <StackPanel x:Name="PnlMpCustomFxDirection" Orientation="Horizontal" Margin="0,0,16,0">
                                                                <TextBlock Text="{loc:Get rgb_direction}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <Border Style="{StaticResource K2SegmentedGroupBorder}">
                                                                    <UniformGrid x:Name="GridMpCustomFxDirection" Rows="1"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{loc:Get rgb_speed}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                <Slider x:Name="SldMpCustomFxSpeed" Minimum="0" Maximum="100" Width="100"
                                                                TickFrequency="25" SmallChange="1" LargeChange="5" TickPlacement="BottomRight"
                                                                ValueChanged="SldMpCustomFxSpeed_ValueChanged" VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="LblMpCustomFxSpeed" Text="50%" VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="36"/>
                                                            </StackPanel>
                                                        </WrapPanel>
                                                        <WrapPanel Orientation="Horizontal">
                                                            <StackPanel x:Name="PnlMpCustomFxColorMode" Orientation="Vertical" Margin="0,0,20,0" VerticalAlignment="Center">
                                                                <RadioButton x:Name="RbMpCustomFxSingle" Content="{loc:Get rgb_single}" GroupName="MpCustomFxColorMode"
                                                                    Margin="0,0,0,6" Checked="RbMpCustomFxColorMode_Checked"/>
                                                                <RadioButton x:Name="RbMpCustomFxDual" Content="{loc:Get rgb_double}" GroupName="MpCustomFxColorMode"
                                                                    Margin="0,0,0,6" Checked="RbMpCustomFxColorMode_Checked"/>
                                                                <RadioButton x:Name="RbMpCustomFxRainbow" Content="{loc:Get rgb_rainbow}" GroupName="MpCustomFxColorMode"
                                                                    Checked="RbMpCustomFxColorMode_Checked"/>
                                                            </StackPanel>
                                                            <StackPanel x:Name="PnlMpCustomFxColor1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                <TextBlock Text="{loc:Get rgb_primary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <Button x:Name="BtnMpCustomFxColor1" Width="30" Height="30"
                                                                    Background="#FF0000" BorderThickness="2"
                                                                    BorderBrush="#3A3A40" Click="BtnMpCustomFxColor_Click" Tag="1"/>
                                                            </StackPanel>
                                                            <StackPanel x:Name="PnlMpCustomFxColor2" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{loc:Get rgb_secondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                <Button x:Name="BtnMpCustomFxColor2" Width="30" Height="30"
                                                                    Background="#0000FF" BorderThickness="2"
                                                                    BorderBrush="#3A3A40" Click="BtnMpCustomFxColor_Click" Tag="2"/>
                                                            </StackPanel>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <WrapPanel Orientation="Horizontal">
                                                        <Button x:Name="BtnMpCustomApply"   Content="{loc:Get apply}"           Padding="8,2" Margin="0,0,4,0" Click="BtnMpCustomApply_Click"  Style="{StaticResource K2IconAccentButton}" Tag="&#xE73E;"/>
                                                        <Button x:Name="BtnMpCustomFillAll" Content="{loc:Get custom_fill_all}" Padding="8,2" Margin="0,0,4,0" Click="BtnMpCustomFillAll_Click" Style="{StaticResource K2IconButton}"       Tag="&#xE771;"/>
                                                        <Button x:Name="BtnMpCustomClear"   Content="{loc:Get custom_clear}"    Padding="8,2"                   Click="BtnMpCustomClear_Click"   Style="{StaticResource K2IconButton}"       Tag="&#xE74D;"/>
                                                    </WrapPanel>
                                                </StackPanel>

                                            </StackPanel>
                                        </ScrollViewer>

                                        <!-- ── APPEARANCE ── Keycap appearance: purely cosmetic, global
                                             (not per-profile — split out of Settings per user request
                                             2026-08-22, same reasoning as Everest Max's PnlSecAppearance). -->
                                        <ScrollViewer x:Name="PnlMpSecAppearance" Visibility="Collapsed"
                                                  VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Get settings_keycap_group}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="{loc:Get settings_keycap_color}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <RadioButton x:Name="RbMpKeycapBlack" Content="{loc:Get settings_keycap_black}"
                                                         GroupName="MpKeycapColor" VerticalAlignment="Center"
                                                         Margin="0,0,10,0" Checked="RbMpKeycapColor_Checked"/>
                                                    <RadioButton x:Name="RbMpKeycapWhite" Content="{loc:Get settings_keycap_white}"
                                                         GroupName="MpKeycapColor" VerticalAlignment="Center"
                                                         Margin="0,0,10,0" Checked="RbMpKeycapColor_Checked"/>
                                                    <RadioButton x:Name="RbMpKeycapCustom" Content="{loc:Get settings_keycap_custom}"
                                                         GroupName="MpKeycapColor" VerticalAlignment="Center"
                                                         Margin="0,0,6,0" Checked="RbMpKeycapColor_Checked"/>
                                                    <Button x:Name="BtnMpKeycapCustomColor" Width="30" Height="30"
                                                    Background="#404040" BorderThickness="2" BorderBrush="#3A3A40"
                                                    Click="BtnMpKeycapCustomColor_Click"/>
                                                </WrapPanel>
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="{loc:Get settings_keycap_text_color}" VerticalAlignment="Center" Margin="0,0,6,0" Padding="0,0,18,0"/>
                                                    <RadioButton x:Name="RbMpKeycapTextBlack" Content="{loc:Get settings_keycap_black}"
                                                         GroupName="MpKeycapTextColor" VerticalAlignment="Center"
                                                         Margin="0,0,10,0" Checked="RbMpKeycapTextColor_Checked"/>
                                                    <RadioButton x:Name="RbMpKeycapTextWhite" Content="{loc:Get settings_keycap_white}"
                                                         GroupName="MpKeycapTextColor" VerticalAlignment="Center"
                                                         Margin="0,0,10,0" Checked="RbMpKeycapTextColor_Checked"/>
                                                    <RadioButton x:Name="RbMpKeycapTextCustom" Content="{loc:Get settings_keycap_custom}"
                                                         GroupName="MpKeycapTextColor" VerticalAlignment="Center"
                                                         Margin="0,0,6,0" Checked="RbMpKeycapTextColor_Checked"/>
                                                    <Button x:Name="BtnMpKeycapTextColor" Width="30" Height="30"
                                                    Background="White" BorderThickness="2" BorderBrush="#3A3A40"
                                                    Click="BtnMpKeycapTextColor_Click"/>
                                                </WrapPanel>
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="{loc:Get settings_keycap_style}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <ComboBox x:Name="CbMpKeycapStyle" Width="240"
                                                      SelectionChanged="CbMpKeycapStyle_SelectionChanged" Margin="4,0,0,0"/>
                                                </WrapPanel>
                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <CheckBox x:Name="CkMpKeycapTranslucentLegend" Content="{loc:Get settings_keycap_translucent_legend}"
                                                      Click="CkMpKeycapTranslucentLegend_Click"/>
                                                </WrapPanel>

                                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <CheckBox x:Name="CkMpKeycapEditMode" Content="{loc:Get settings_keycap_edit_individual}"
                                                      Click="CkMpKeycapEditMode_Click" Margin="0,5,0,0"/>
                                                    <Path Style="{StaticResource K2HintIcon}" Margin="8,5,0,0"
                                                          ToolTip="{loc:Get settings_keycap_edit_individual_hint}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <!-- ── SETTINGS (Positioning/rotation only — Keycap appearance
                                             moved to its own Appearance section above) ── -->
                                        <ScrollViewer x:Name="PnlMpSecSettings" Visibility="Collapsed"
                                                  VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Get positioning}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <WrapPanel Orientation="Horizontal">
                                                    <ComboBox x:Name="CbMacroRotation" Width="190"
                                                      SelectionChanged="CbMacroRotation_SelectionChanged"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Common actions (same rule for all devices): uniform width/height,
                             vertical stack, grouped Profile / Import / Device.
                             Left-only margin (not on the device box) mirrors PnlEverest exactly,
                             so column 1 keeps the same width in both. The gap before the (normally
                             collapsed) debug column lives on that column's own left margin instead,
                             so it doesn't cost width here in the common (non-debug) case. -->
                            <Border Grid.Column="2" Background="#111115" CornerRadius="6"
                                Margin="8,0,0,0" Padding="10" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Get profile}"
                                               Style="{StaticResource K2SideGroupHeader}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="BtnMpProfileMenu"
                                            Style="{StaticResource MacroRowIconButton}" Tag="&#xE712;"
                                            ToolTip="{loc:Get profile}" Click="BtnMpProfileMenu_Click"/>
                                    </Grid>
                                    <ListBox x:Name="LstMpProfile" Style="{StaticResource K2SideProfileList}"
                                         SelectionChanged="LstMpProfile_SelectionChanged"/>

                                    <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                    <TextBlock Text="{loc:Get device}" Style="{StaticResource K2SideGroupHeader}"/>
                                    <Button x:Name="BtnMpRename" Content="{loc:Get rename_device}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE8D3;"
                                        Click="BtnMpRename_Click"/>
                                    <Button x:Name="BtnMpRestoreDefaults" Content="{loc:Get restore_defaults}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE777;"
                                        Click="BtnMpRestoreDefaults_Click"/>

                                    <StackPanel x:Name="PnlMpDebugGroup" Visibility="Collapsed">
                                        <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                        <TextBlock Text="{loc:Get debug_group}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <Button x:Name="BtnRefresh" Content="{loc:Get refresh}"
                                            Style="{StaticResource K2SideActionButton}" Tag="&#xE72C;"
                                            Click="BtnRefresh_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Debug panel: visible only in debug mode -->
                            <Grid x:Name="PnlMpDebugRight" Grid.Column="3" Width="380" Visibility="Collapsed" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <GroupBox x:Name="GbMpDevices" Grid.Row="0" Header="{loc:Get mp_connected_devices}">
                                    <ListView x:Name="LvDevices" Height="120"
                                              ItemContainerStyle="{StaticResource K2GridViewListViewItem}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Device"  Width="90"  DisplayMemberBinding="{Binding Label}"/>
                                                <GridViewColumn Header="{loc:Get dp_fw}"    Width="55"  DisplayMemberBinding="{Binding FirmwareVersion}"/>
                                                <GridViewColumn Header="VID"     Width="60"  DisplayMemberBinding="{Binding Vid}"/>
                                                <GridViewColumn Header="PID"     Width="60"  DisplayMemberBinding="{Binding Pid}"/>
                                                <GridViewColumn Header="Prof."   Width="45"  DisplayMemberBinding="{Binding CurrentProfile}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </GroupBox>
                                <GroupBox x:Name="GbMpLog" Grid.Row="1" Header="{loc:Get mp_event_log}" Margin="0,8,0,0">
                                    <TextBox x:Name="TxtLog"
                                         IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap" AcceptsReturn="True"/>
                                </GroupBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- end PnlMacroPad -->

                <!-- ==================== DisplayPad ==================== -->
                <Grid x:Name="PnlDisplayPad" Visibility="Collapsed">
                    <Button Style="{StaticResource K2GuideButton}" Click="BtnGuide_Click"/>
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <!-- toolbar (fixed, see PnlEverest) -->
                            <RowDefinition Height="*"/>
                            <!-- main area -->
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <!-- Debug-only: open/close driver manually -->
                            <Button x:Name="BtnDpOpen"    Content="{loc:Get open_driver}"    Click="BtnDpOpen_Click"
                                Style="{StaticResource K2IconAccentButton}" Tag="&#xE768;" Visibility="Collapsed"/>
                            <Button x:Name="BtnDpClose"   Content="{loc:Get close_driver}"   Margin="8,0,0,0" Click="BtnDpClose_Click"
                                Style="{StaticResource K2IconButton}" Tag="&#xE711;" Visibility="Collapsed"/>
                            <Separator x:Name="SepDpOpenDbg" Margin="10,0" Visibility="Collapsed"/>
                            <!-- Folder navigation: interface-only, independent of any physical/software
                             key's "Back" action — always available to leave a sub-page even if the
                             user removes/never assigns a Back key inside it. Visible only when inside
                             a sub-page (toggled by UpdateDpBreadcrumb); accent-styled so it isn't missed. -->
                            <Button x:Name="BtnDpBack" Content="{loc:Get dp_back}"
                                Margin="0,0,0,0" Style="{StaticResource K2IconAccentButton}" Tag="&#xE72B;"
                                Click="BtnDpBack_Click" Visibility="Collapsed"/>
                            <TextBlock x:Name="LblDpBreadcrumb" Text="" VerticalAlignment="Center"
                                   Margin="6,0,0,0" Foreground="#9A9AA2" FontStyle="Italic"/>
                            <!-- Debug-only: remap/reset keys (see project rule) -->
                            <Separator x:Name="SepDpMapKeysDbg" Margin="10,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnDpMapKeys"  Content="{loc:Get remap_keys}"    Click="BtnDpMapKeys_Click"
                                Style="{StaticResource K2IconButton}" Tag="&#xE765;" Visibility="Collapsed"/>
                            <Button x:Name="BtnDpResetAll" Content="{loc:Get dp_reset_keys}" Margin="8,0,0,0" Click="BtnDpResetAll_Click"
                                Style="{StaticResource K2IconButton}" Tag="&#xE777;" Visibility="Collapsed"/>
                            <TextBlock x:Name="LblDpSdk" Margin="16,6,0,0" FontStyle="Italic" Foreground="#9A9AA2" Visibility="Collapsed"/>
                        </WrapPanel>

                        <!-- ── sidebar (specific) | canvas + settings | common actions | debug ── -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <!-- sidebar -->
                                <ColumnDefinition Width="*"/>
                                <!-- canvas + settings -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- common actions (all devices) -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- debug -->
                            </Grid.ColumnDefinitions>

                            <!-- Left sidebar: device-specific section navigation -->
                            <Border Grid.Column="0" Background="#111115" CornerRadius="6"
                                Margin="0,0,8,0" Padding="4">
                                <StackPanel>
                                    <RadioButton x:Name="RbDpSecKeyBinding"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get ev_key_binding}" GroupName="DpSections"
                                             IsChecked="True" Checked="DpSection_Changed"/>
                                    <!-- Visibility is driven by UpdateDpPagesTabVisibility: shown only
                                         when the selected device has at least one folder sub-page. -->
                                    <RadioButton x:Name="RbDpSecPages" Visibility="Collapsed"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get dp_pages}" GroupName="DpSections"
                                             Checked="DpSection_Changed"/>
                                    <RadioButton x:Name="RbDpSecSettings"
                                             Style="{StaticResource SectionTabStyle}"
                                             Content="{loc:Get ev_settings}" GroupName="DpSections"
                                             Checked="DpSection_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- Middle: keys canvas (top) + settings panel (bottom).
                             No margin here (matches PnlEverest): the gap before the
                             common-actions column comes from that column's own left
                             margin, so this box is exactly as wide as Everest's. -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <!-- Fixed height across all devices: matches MacroPad's identical
                                     510x370 canvas rotated to vertical orientation (Positioning
                                     section, 90°/270°) — RotateTransform swaps its rendered footprint
                                     to 370x510, so 510 + 8px padding each side = 526 is the tallest
                                     a device box needs to be. -->
                                    <RowDefinition Height="526"/>
                                    <!-- device -->
                                    <RowDefinition Height="*"/>
                                    <!-- settings: grows with window height -->
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#18181C" CornerRadius="6" Padding="8">
                                    <Canvas x:Name="CvsDpKeys" Width="510" Height="370" ClipToBounds="True"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas.Background>
                                            <ImageBrush ImageSource="Assets/mkd_bg.png" Stretch="Fill"/>
                                        </Canvas.Background>
                                    </Canvas>
                                </Border>

                                <!-- Bottom settings panel: grows with the window (Row="*" above); MinHeight
                                 keeps its old fixed size as a floor so it doesn't collapse below the
                                 tallest section (Key Binding / Rotation / Pages). NOTE: no outer
                                 ScrollViewer anymore — see the matching comment on BdrEvSettingsPanel
                                 (Everest Max)/BdrMpSettingsPanel (MacroPad) for why; each section now
                                 owns its own overflow behavior instead (Key Binding's Grid+ListView
                                 stretches for real, same disposition as every other device's Key
                                 Binding section except Makalu; Rotation/Pages each got their own
                                 ScrollViewer). -->
                                <Border Grid.Row="1" Background="#14141A"
                                    BorderBrush="#2A2A32" BorderThickness="1"
                                    CornerRadius="6" Padding="12,10" Margin="0,8,0,0"
                                    MinHeight="90">
                                    <Grid>

                                        <!-- ── KEY BINDING (keys are configured directly on the grid above;
                                         this list mirrors what's mapped, same list+column layout as
                                         Everest Max/MacroPad's Key Binding section — LvDpKeys only
                                         lists keys that HAVE an action, unlike the always-12 grid
                                         above). A Grid (not StackPanel) with an explicit Auto/* row
                                         split: StackPanel always sizes children to their natural
                                         height regardless of available space, so it can never stretch
                                         LvDpKeys to fill. ── -->
                                        <Grid x:Name="PnlDpSecKeyBinding" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <!-- hint text -->
                                                <RowDefinition Height="*"/>
                                                <!-- list + buttons: fills remaining height -->
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{loc:Get key_binding_hint}" Foreground="#9A9AA2"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="170"/>
                                                </Grid.ColumnDefinitions>
                                                <ListView Grid.Column="0" x:Name="LvDpKeys" Margin="0,0,8,0"
                                                      SelectionChanged="LvDpKeys_SelectionChanged">
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource K2AccentBrush}"/>
                                                                    <Setter Property="Foreground" Value="#10302F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding ListDisplay}" Padding="2"/>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                    <Button x:Name="BtnDpConfigure" Content="{loc:Get ev_configure}"
                                                        Padding="8,4" Click="BtnDpConfigure_Click"
                                                        HorizontalAlignment="Stretch" Margin="0,0,0,4"
                                                        IsEnabled="False"/>
                                                    <Button x:Name="BtnDpRemoveAction" Content="{loc:Get ev_remove}"
                                                        Padding="8,4" Click="BtnDpRemoveAction_Click"
                                                        HorizontalAlignment="Stretch"
                                                        IsEnabled="False"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <!-- ── SETTINGS (positioning/rotation — DisplayPad's only device
                                         setting so far) ── (own ScrollViewer, same reasoning as
                                         MacroPad's Settings) -->
                                        <ScrollViewer x:Name="PnlDpSecSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Get positioning}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <ComboBox x:Name="CbDpRotation" Width="190" Margin="0,0,12,0"
                                                      SelectionChanged="CbDpRotation_SelectionChanged"/>
                                                    <Button x:Name="BtnDpRotateCcw" Content="{loc:Get dp_rotate_icons_ccw}" Margin="0,0,6,0"
                                                    Style="{StaticResource K2IconButton}" Tag="&#xE14A;" Height="30"
                                                    Click="BtnDpRotateCcw_Click"/>
                                                    <Button x:Name="BtnDpRotateCw"  Content="{loc:Get dp_rotate_icons_cw}"
                                                    Style="{StaticResource K2IconButton}" Tag="&#xE14A;" Height="30"
                                                    Click="BtnDpRotateCw_Click"/>
                                                </StackPanel>

                                                <TextBlock Text="{loc:Get backlight_auto_off_group}" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                                <WrapPanel Orientation="Horizontal">
                                                    <CheckBox x:Name="CkDpAutoOffEnable" Height="25" Content="{loc:Get backlight_auto_off_enable}"
                                                      Click="CkDpAutoOffEnable_Click" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                                    <TextBlock Text="{loc:Get backlight_auto_off_seconds}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBox x:Name="TxtDpAutoOffSeconds" Width="70" TextAlignment="Center"
                                                     LostFocus="TxtDpAutoOffSeconds_LostFocus" Height="25" Text="5" VerticalAlignment="Center" Padding="5,2,5,0"/>
                                                    <TextBlock Text="{loc:Get unit_seconds}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </ScrollViewer>

                                        <!-- ── PAGES: two-level tree (profile node ▸ its pages), only profiles
                                             that actually contain a page; nodes expanded by default, collapsible.
                                             Clicking a node navigates (see TvDpPages_SelectedItemChanged). ── -->
                                        <ScrollViewer x:Name="PnlDpSecPages" Visibility="Collapsed"
                                                  VerticalScrollBarVisibility="Auto">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock x:Name="LblDpNoPages" Text="{loc:Get dp_no_pages}"
                                                   Foreground="#9A9AA2" TextWrapping="Wrap" Visibility="Collapsed"/>
                                                <TreeView x:Name="TvDpPages" Background="Transparent" BorderThickness="0"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                          SelectedItemChanged="TvDpPages_SelectedItemChanged">
                                                    <TreeView.Resources>
                                                        <!-- expander glyph (stock one is invisible on the dark panel) -->
                                                        <Style x:Key="DpTreeToggle" TargetType="ToggleButton">
                                                            <Setter Property="Focusable" Value="False"/>
                                                            <Setter Property="Width" Value="16"/>
                                                            <Setter Property="Height" Value="16"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="#14141A" Width="16" Height="16">
                                                                            <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                  Fill="#9A9AA2" Data="M 0 0 L 4 4 L 0 8 Z"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Arrow" Property="Data" Value="M 0 0 L 8 0 L 4 4 Z"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Arrow" Property="Fill" Value="#CCCCCC"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>

                                                        <!-- Retemplated TreeViewItem: every level starts expanded, plus the
                                                             connecting rails/elbows the stock TreeView doesn't draw. -->
                                                        <Style TargetType="TreeViewItem">
                                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                            <Setter Property="Foreground" Value="#CCCCCC"/>
                                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TreeViewItem">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="16"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition/>
                                                                            </Grid.RowDefinitions>

                                                                            <!-- vertical rail: this node down to its siblings -->
                                                                            <Rectangle x:Name="VLine" Grid.Column="0" Grid.RowSpan="2"
                                                                                       Width="1" HorizontalAlignment="Center"
                                                                                       Fill="#3A3A44" SnapsToDevicePixels="True"/>
                                                                            <!-- horizontal elbow: rail across to the header -->
                                                                            <Rectangle x:Name="HLine" Grid.Column="0" Grid.Row="0"
                                                                                       Height="1" Width="7" VerticalAlignment="Center"
                                                                                       HorizontalAlignment="Right"
                                                                                       Fill="#3A3A44" SnapsToDevicePixels="True"/>

                                                                            <ToggleButton x:Name="Expander" Grid.Column="0" Grid.Row="0"
                                                                                          Style="{StaticResource DpTreeToggle}"
                                                                                          ClickMode="Press"
                                                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>

                                                                            <Border x:Name="Bd" Grid.Column="1" Grid.Row="0"
                                                                                    Background="{TemplateBinding Background}"
                                                                                    Padding="4,2" CornerRadius="3">
                                                                                <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                                                                            </Border>

                                                                            <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.ColumnSpan="2"
                                                                                            Grid.Row="1"/>
                                                                        </Grid>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsExpanded" Value="False">
                                                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                            <Trigger Property="HasItems" Value="False">
                                                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#2A2A32"/>
                                                                            </Trigger>
                                                                            <!-- top-level node: nothing to connect to -->
                                                                            <DataTrigger Value="root"
                                                                                Binding="{Binding RelativeSource={RelativeSource Self},
                                                                                          Converter={StaticResource TreeLinePositionConverter}}">
                                                                                <Setter TargetName="VLine" Property="Visibility" Value="Collapsed"/>
                                                                                <Setter TargetName="HLine" Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <!-- last child: rail stops at the elbow -->
                                                                            <DataTrigger Value="last"
                                                                                Binding="{Binding RelativeSource={RelativeSource Self},
                                                                                          Converter={StaticResource TreeLinePositionConverter}}">
                                                                                <Setter TargetName="VLine" Property="Grid.RowSpan" Value="1"/>
                                                                                <Setter TargetName="VLine" Property="VerticalAlignment" Value="Top"/>
                                                                                <Setter TargetName="VLine" Property="Height" Value="11"/>
                                                                            </DataTrigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>

                                                        <!-- profile node: its pages are the children -->
                                                        <HierarchicalDataTemplate DataType="{x:Type local:DpPageProfileGroup}"
                                                                                  ItemsSource="{Binding Pages}">
                                                            <TextBlock Text="{Binding Name}" Foreground="#9A9AA2"
                                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </HierarchicalDataTemplate>
                                                        <!-- page node (its own nested sub-pages are the children) -->
                                                        <HierarchicalDataTemplate DataType="{x:Type local:DpPageRow}"
                                                                                  ItemsSource="{Binding Children}">
                                                            <Border x:Name="RowBorder" Padding="6,3" CornerRadius="4"
                                                            Background="Transparent">
                                                                <Grid MinWidth="200">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                       Foreground="#CCCCCC" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                                    <Button x:Name="BtnRowDelete" Grid.Column="1"
                                                                    Content="{loc:Get dp_delete_page}"
                                                                    Style="{StaticResource K2IconButton}" Tag="&#xE74D;"
                                                                    Visibility="Collapsed" Margin="8,0,0,0"
                                                                    CommandParameter="{Binding}"
                                                                    Click="BtnDpDeletePage_Click"/>
                                                                </Grid>
                                                            </Border>
                                                            <HierarchicalDataTemplate.Triggers>
                                                                <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="BtnRowDelete" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="RowBorder" Property="Background" Value="#1E1E24"/>
                                                                </Trigger>
                                                            </HierarchicalDataTemplate.Triggers>
                                                        </HierarchicalDataTemplate>
                                                    </TreeView.Resources>
                                                </TreeView>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Common actions (same rule for all devices): uniform width/height,
                             vertical stack, grouped Profile / Import / Device.
                             Left-only margin (not on the device box) mirrors PnlEverest exactly,
                             so column 1 keeps the same width in both. The gap before the (normally
                             collapsed) debug column lives on that column's own left margin instead,
                             so it doesn't cost width here in the common (non-debug) case. -->
                            <Border Grid.Column="2" Background="#111115" CornerRadius="6"
                                Margin="8,0,0,0" Padding="10" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{loc:Get profile}"
                                               Style="{StaticResource K2SideGroupHeader}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" x:Name="BtnDpProfileMenu"
                                            Style="{StaticResource MacroRowIconButton}" Tag="&#xE712;"
                                            ToolTip="{loc:Get profile}" Click="BtnDpProfileMenu_Click"/>
                                    </Grid>
                                    <ListBox x:Name="LstDpProfile" Style="{StaticResource K2SideProfileList}"
                                         SelectionChanged="LstDpProfile_SelectionChanged"/>

                                    <!-- Dedicated profiles: the alternative panels that TAKE THE
                                         PAD OVER on their own trigger (Spotify's now-playing
                                         layout, the live Discord voice page) and hand it back to
                                         the normal profile when they're done — see
                                         MainWindow.DisplayPad.Dedicated.cs. Created from the
                                         "+ New profile" dialog like any other profile, but listed
                                         apart from (and filtered out of) the profile list above:
                                         picking one is not "switch profile", it's "arm this
                                         takeover". The whole block stays collapsed until this
                                         device actually has one. -->
                                    <StackPanel x:Name="PnlDpDedicated" Visibility="Collapsed">
                                        <TextBlock Text="{loc:Get dp_dedicated_profiles}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <ListBox x:Name="LstDpDedicated" Style="{StaticResource K2SideProfileList}"
                                             Height="64" SelectionChanged="LstDpDedicated_SelectionChanged"/>
                                    </StackPanel>

                                    <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                    <TextBlock Text="{loc:Get dp_fullscreen_group}" Style="{StaticResource K2SideGroupHeader}"/>
                                    <Button x:Name="BtnDpFullscreen" Content="{loc:Get dp_fullscreen_set}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE91B;"
                                        Click="BtnDpFullscreen_Click"/>
                                    <Button x:Name="BtnDpFullscreenClear" Content="{loc:Get dp_fullscreen_clear}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE74D;"
                                        Click="BtnDpFullscreenClear_Click"/>

                                    <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                    <TextBlock Text="{loc:Get device}" Style="{StaticResource K2SideGroupHeader}"/>
                                    <Button x:Name="BtnDpRename" Content="{loc:Get rename_device}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE8D3;"
                                        Click="BtnDpRename_Click"/>
                                    <Button x:Name="BtnDpRestoreDefaults" Content="{loc:Get restore_defaults}"
                                        Style="{StaticResource K2SideActionButton}" Tag="&#xE777;"
                                        Click="BtnDpRestoreDefaults_Click"/>

                                    <StackPanel x:Name="PnlDpDebugGroup" Visibility="Collapsed">
                                        <Separator Style="{StaticResource K2SideSeparator}" Margin="0,4,0,10"/>
                                        <TextBlock Text="{loc:Get debug_group}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <Button x:Name="BtnDpRefresh" Content="{loc:Get refresh}"
                                            Style="{StaticResource K2SideActionButton}" Tag="&#xE72C;"
                                            Click="BtnDpRefresh_Click"/>
                                        <Button x:Name="BtnDpLiveTest" Content="{loc:Get dp_live_test}"
                                            Style="{StaticResource K2SideActionButton}" Tag="&#xE768;"
                                            Click="BtnDpLiveTest_Click"/>
                                        <Button x:Name="BtnDpLiveTestIcon" Content="{loc:Get dp_live_test_icon}"
                                            Style="{StaticResource K2SideActionButton}" Tag="&#xE768;"
                                            Click="BtnDpLiveTestIcon_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Debug panel: visible only in debug mode -->
                            <Grid x:Name="PnlDpDebugRight" Grid.Column="3" Width="380" Visibility="Collapsed" Margin="8,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <GroupBox x:Name="GbDpDevices" Grid.Row="0" Header="{loc:Get dp_connected_devices}">
                                    <ListView x:Name="LvDpDevices" Height="120"
                                              ItemContainerStyle="{StaticResource K2GridViewListViewItem}">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Device"         Width="100" DisplayMemberBinding="{Binding Label}"/>
                                                <GridViewColumn Header="{loc:Get dp_fw}" Width="80"  DisplayMemberBinding="{Binding FirmwareVersion}"/>
                                                <GridViewColumn Header="{loc:Get dp_lum}" Width="60" DisplayMemberBinding="{Binding Brightness}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </GroupBox>
                                <GroupBox x:Name="GbDpLog" Grid.Row="1" Header="{loc:Get dp_log}" Margin="0,8,0,0">
                                    <TextBox x:Name="TxtDpLog"
                                         IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap" AcceptsReturn="True"/>
                                </GroupBox>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- end PnlDisplayPad -->

                <!-- ==================== Macro (top-level section) ==================== -->
                <Grid x:Name="PnlMacro" Visibility="Collapsed">
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{loc:Get keyboard_macro}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Macro library (always visible) — same look as the device
                             "SECTIONS" sidebar: dark rounded card, accent-highlighted
                             selection, stretching to fill the column's full height.
                             New/Delete above the card, Import below it. -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{loc:Get macro_library}" Style="{StaticResource K2SideGroupHeader}"/>
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button x:Name="BtnMacroNew"       Content="{loc:Get macro_new}"       Padding="8,2" Margin="0,0,4,0" Click="BtnMacroNew_Click"       Style="{StaticResource K2IconButton}" Tag="&#xE710;"/>
                                    <Button x:Name="BtnMacroDuplicate" Content="{loc:Get macro_duplicate}" Padding="8,2" Margin="0,0,4,0" Click="BtnMacroDuplicate_Click" Style="{StaticResource K2IconButton}" Tag="&#xE8C8;"/>
                                    <Button x:Name="BtnMacroDelete"    Content="{loc:Get delete}"          Padding="8,2" Click="BtnMacroDelete_Click"    Style="{StaticResource K2IconButton}" Tag="&#xE74D;"/>
                                </WrapPanel>
                                <Border Grid.Row="2" Background="#111115" CornerRadius="6" Padding="4">
                                    <ListBox x:Name="LbMacros"
                                         Background="Transparent" BorderThickness="0"
                                         ItemContainerStyle="{StaticResource MacroLibraryItemStyle}"
                                         SelectionChanged="LbMacros_SelectionChanged"
                                         DisplayMemberPath="Name">
                                        <!-- Bare-bones template (no default WPF/Fluent chrome): the
                                         stock ListBox template has its own "disabled" visual state
                                         that paints a system-light/white background regardless of
                                         the Background set above, and its fixed-size chrome doesn't
                                         stretch to fill a "*" row the way this bare ScrollViewer
                                         does. Same technique as LvMacroInputs below. -->
                                        <ListBox.Template>
                                            <ControlTemplate TargetType="ListBox">
                                                <ScrollViewer Background="Transparent" Padding="2"
                                                          CanContentScroll="False">
                                                    <ItemsPresenter/>
                                                </ScrollViewer>
                                            </ControlTemplate>
                                        </ListBox.Template>
                                    </ListBox>
                                </Border>
                                <Button Grid.Row="3" x:Name="BtnMacroImportBC" Content="{loc:Get macro_import_bc}"
                                    Padding="8,2" Margin="0,6,0,0" Click="BtnMacroImportBC_Click"
                                    Style="{StaticResource K2IconButton}" Tag="&#xE8B5;"
                                    HorizontalAlignment="Left"/>
                            </Grid>

                            <!-- Selected macro editor -->
                            <Grid x:Name="SpMacroSettings" Grid.Column="2" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                                    <TextBlock Text="{loc:Get macro_name}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtMacroName" Width="220" Height="25"
                                         Background="#2A2A2E" Foreground="White"
                                         TextChanged="TxtMacroName_TextChanged"/>
                                </WrapPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Settings column: Devices / Delay / Playback, stacked -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{loc:Get macro_section_devices}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <CheckBox x:Name="CkMacroMouse" Content="{loc:Get macro_record_mouse}"
                                              Margin="0,0,0,6" Click="CkMacroDevice_Click"/>
                                        <CheckBox x:Name="CkMacroMouseMovement" Content="{loc:Get macro_record_mouse_movement}"
                                              Margin="20,0,0,6" FontSize="12" Click="CkMacroDevice_Click"/>
                                        <CheckBox x:Name="CkMacroKeyboard" Content="{loc:Get macro_record_keyboard}"
                                              Margin="0,0,0,18" Click="CkMacroDevice_Click"/>

                                        <TextBlock Text="{loc:Get macro_delay}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <RadioButton x:Name="RbMacroDelayRecorded" GroupName="MacroDelayGroup"
                                                 Content="{loc:Get macro_delay_recorded}"
                                                 Style="{StaticResource MacroOptionRowStyle}" Checked="RbMacroDelay_Checked"/>
                                        <RadioButton x:Name="RbMacroDelayCustom" GroupName="MacroDelayGroup"
                                                 Style="{StaticResource MacroOptionRowStyle}" Checked="RbMacroDelay_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Get macro_delay_custom}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtMacroCustomDelay" Width="66" Height="25" Margin="8,0,4,0"
                                                     Padding="5,2" Background="#2A2A2E" Foreground="White"
                                                     TextChanged="TxtMacroCustomDelay_TextChanged"/>
                                                <TextBlock Text="ms" VerticalAlignment="Center" Opacity="0.7"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RbMacroDelayNone" GroupName="MacroDelayGroup"
                                                 Content="{loc:Get macro_delay_none}" Margin="0,0,0,18"
                                                 Style="{StaticResource MacroOptionRowStyle}" Checked="RbMacroDelay_Checked"/>

                                        <TextBlock Text="{loc:Get macro_playback}" Style="{StaticResource K2SideGroupHeader}"/>
                                        <RadioButton x:Name="RbMacroPlaybackOnce" GroupName="MacroPlaybackGroup"
                                                 Content="{loc:Get macro_playback_once}"
                                                 Style="{StaticResource MacroOptionRowStyle}" Checked="RbMacroPlayback_Checked"/>
                                        <RadioButton x:Name="RbMacroPlaybackHold" GroupName="MacroPlaybackGroup"
                                                 Content="{loc:Get macro_playback_held}"
                                                 Style="{StaticResource MacroOptionRowStyle}" Checked="RbMacroPlayback_Checked"/>
                                        <RadioButton x:Name="RbMacroPlaybackRepeat" GroupName="MacroPlaybackGroup"
                                                 Style="{StaticResource MacroOptionRowStyle}" Checked="RbMacroPlayback_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{loc:Get macro_repeat_short}" VerticalAlignment="Center"/>
                                                <TextBox x:Name="TxtMacroRepeatN" Width="66" Height="25" Margin="8,0,4,0"
                                                     Padding="5,2" Background="#2A2A2E" Foreground="White"
                                                     TextChanged="TxtMacroRepeatN_TextChanged"/>
                                                <TextBlock Text="{loc:Get macro_times_suffix}" VerticalAlignment="Center" Opacity="0.7"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="RbMacroPlaybackToggle" GroupName="MacroPlaybackGroup"
                                                 Content="{loc:Get macro_playback_toggle}"
                                                 Style="{StaticResource MacroOptionRowStyle}" Checked="RbMacroPlayback_Checked"/>
                                    </StackPanel>

                                    <!-- Inputs / commands -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Get macro_section_inputs}"
                                                   Style="{StaticResource K2SideGroupHeader}" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1" x:Name="CkMacroShowPressRelease"
                                                  Content="{loc:Get macro_show_press_release}"
                                                  Tag="&#xE7C8;" Style="{StaticResource K2ToggleRow}"
                                                  Click="CkMacroShowPressRelease_Click"/>
                                        </Grid>

                                        <Border Grid.Row="1" Background="#18181C" BorderBrush="{StaticResource K2BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" MinHeight="260">
                                            <ListView x:Name="LvMacroInputs" Background="Transparent" BorderThickness="0"
                                                  ScrollViewer.CanContentScroll="False">
                                                <ListView.Template>
                                                    <ControlTemplate TargetType="ListView">
                                                        <ScrollViewer Background="Transparent" Padding="4">
                                                            <ItemsPresenter/>
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </ListView.Template>
                                                <ListView.ItemContainerStyle>
                                                    <Style TargetType="ListViewItem">
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Focusable" Value="False"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListViewItem">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListView.ItemContainerStyle>
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="#232328" CornerRadius="6" Margin="4,3" Padding="10,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24"/>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="22"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Number}"
                                                                       Foreground="#68686E" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Style="{StaticResource MacroPressIndicatorStyle}"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding Glyph}"
                                                                       FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                       Foreground="#9A9AA2" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="3" Text="{Binding Label}"
                                                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                <TextBlock Grid.Column="4" Text="{Binding DelayMs, StringFormat={}{0} ms}"
                                                                       Foreground="#68686E" FontSize="11"
                                                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="10,0,0,0">
                                                                    <Button Tag="&#xE70E;" CommandParameter="{Binding}" Click="BtnMacroInputMoveUp_Click"
                                                                        Style="{StaticResource MacroRowIconButton}" ToolTip="{loc:Get macro_move_up}"/>
                                                                    <Button Tag="&#xE70D;" CommandParameter="{Binding}" Click="BtnMacroInputMoveDown_Click"
                                                                        Style="{StaticResource MacroRowIconButton}" ToolTip="{loc:Get macro_move_down}"/>
                                                                    <Button Tag="&#xE74D;" CommandParameter="{Binding}" Click="BtnMacroInputDelete_Click"
                                                                        Style="{StaticResource MacroRowIconButton}" ToolTip="{loc:Get macro_delete_input}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Border>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="BtnMacroRecord" Content="{loc:Get macro_start_recording}"
                                                Padding="12,6" Margin="0,0,8,0" Click="BtnMacroRecord_Click"
                                                Style="{StaticResource K2IconAccentButton}" Tag="&#xE7C8;"/>
                                            <Button x:Name="BtnMacroPlay" Content="{loc:Get macro_play}"
                                                Padding="10,6" Margin="0,0,8,0" Click="BtnMacroPlay_Click"
                                                Style="{StaticResource K2IconButton}" Tag="&#xE768;"/>
                                            <Button x:Name="BtnMacroStop" Content="{loc:Get stop}"
                                                Padding="10,6" Margin="0,0,8,0" Click="BtnMacroStop_Click"
                                                Style="{StaticResource K2IconButton}" Tag="&#xE71A;"/>
                                            <TextBlock x:Name="TblMacroInputCount" Text="0 actions"
                                                   VerticalAlignment="Center" Foreground="#808080" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Assigned to -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{loc:Get macro_section_assigned}" Style="{StaticResource K2SideGroupHeader}"
                                               ToolTip="{loc:Get macro_assigned_help}"/>
                                        <ItemsControl x:Name="LvMacroAssignments">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#232328" CornerRadius="6" Margin="0,0,0,6" Padding="8,6">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding KeyLabel}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding Subtitle}" Foreground="#808088"
                                                                   FontSize="11" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="TblMacroNotAssigned" Text="{loc:Get macro_not_assigned}"
                                               Foreground="#606068" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
                <!-- end PnlMacro -->

                <!-- ==================== General Settings ==================== -->
                <Grid x:Name="PnlSettings" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="24" MaxWidth="480" HorizontalAlignment="Left">
                            <TextBlock Text="{loc:Get tab_settings}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

                            <GroupBox x:Name="GbAppUpdate" Header="{loc:Get settings_update_group}" Margin="0,0,0,20">
                                <StackPanel Margin="8">
                                    <TextBlock x:Name="TxtAppCurrentVersion" Foreground="#9A9AA2" FontSize="12"/>
                                    <Button x:Name="BtnAppCheckUpdate" Content="{loc:Get settings_update_check_btn}"
                                    Padding="8,4" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Click="BtnAppCheckUpdate_Click"
                                    Style="{StaticResource K2IconButton}" Tag="&#xE895;"/>
                                    <TextBlock x:Name="TxtAppUpdateStatus" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                                    <ProgressBar x:Name="PbAppUpdateDownload" Height="6" Margin="0,6,0,0"
                                         Minimum="0" Maximum="100" Visibility="Collapsed"/>

                                    <StackPanel x:Name="PnlAppUpdateAvailable" Visibility="Collapsed" Margin="0,12,0,0">
                                        <TextBlock x:Name="TxtAppUpdateNotes" Foreground="#C8C8CE"
                                           TextWrapping="Wrap" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="BtnAppUpdateInstall" Content="{loc:Get settings_update_install_btn}"
                                            Padding="10,6" Margin="0,0,8,0" Visibility="Collapsed"
                                            Click="BtnAppUpdateInstall_Click"
                                            Style="{StaticResource K2IconAccentButton}" Tag="&#xE896;"/>
                                            <Button x:Name="BtnAppUpdateZip" Content="{loc:Get settings_update_zip_btn}"
                                            Padding="10,6" Margin="0,0,8,0" Visibility="Collapsed"
                                            Click="BtnAppUpdateZip_Click"
                                            Style="{StaticResource K2IconAccentButton}" Tag="&#xE896;"/>
                                            <Button x:Name="BtnAppUpdateViewRelease" Content="{loc:Get settings_update_view_release_btn}"
                                            Padding="8,4"
                                            Click="BtnAppUpdateViewRelease_Click"
                                            Style="{StaticResource K2IconButton}" Tag="&#xE8A7;"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppBcImport" Header="{loc:Get settings_bc_import_group}" Margin="0,0,0,20">
                                <StackPanel Margin="8" Orientation="Horizontal">
                                    <Button x:Name="BtnAppImportFromBaseCamp" Content="{loc:Get settings_bc_import_btn}"
                                    Padding="8,4" VerticalAlignment="Center"
                                    Click="BtnAppImportFromBaseCamp_Click"
                                    Style="{StaticResource K2IconButton}" Tag="&#xE8B5;"/>
                                    <Path Style="{StaticResource K2HintIcon}"
                                       ToolTip="{loc:Get settings_bc_import_hint}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppBcDllFolder" Header="{loc:Get settings_bc_dll_group}" Margin="0,0,0,20">
                                <StackPanel Margin="8">
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <RadioButton x:Name="RbBcDllAuto" Content="{loc:Get settings_bc_dll_radio_auto}"
                                             GroupName="BcDllMode" Checked="RbBcDllMode_Checked"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_bc_dll_hint}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtBcDetected" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="20,0,0,10" FontSize="12"/>

                                    <RadioButton x:Name="RbBcDllManual" Content="{loc:Get settings_bc_dll_radio_manual}"
                                         GroupName="BcDllMode" Margin="0,4" Checked="RbBcDllMode_Checked"/>
                                    <TextBox x:Name="TxtBcDllFolder" IsReadOnly="True" Margin="20,4,0,8"/>
                                    <Button x:Name="BtnBcDllFolderBrowse" Content="{loc:Get settings_bc_dll_browse}"
                                    Padding="8,4" HorizontalAlignment="Left" Margin="20,0,0,0"
                                    Click="BtnBcDllFolderBrowse_Click"
                                    Style="{StaticResource K2IconButton}" Tag="&#xE8DA;"/>

                                    <TextBlock x:Name="TxtBcDllStatus" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppGeneral" Header="{loc:Get settings_general}" Margin="0,0,0,20">
                                <StackPanel Margin="8">
                                    <CheckBox x:Name="CkCloseToTray" Content="{loc:Get settings_close_to_tray}"
                                      Click="CkCloseToTray_Click" FontSize="14"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox x:Name="CkK2Autostart" Content="{loc:Get settings_k2_autostart}"
                                          Click="CkK2Autostart_Click" FontSize="14"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_k2_autostart_hint}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox x:Name="CkStartMinToTray" Content="{loc:Get settings_start_min_tray}"
                                          Click="CkStartMinToTray_Click" FontSize="14"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_start_min_tray_hint}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbDeviceSync" Header="{loc:Get settings_device_sync_group}" Margin="0,0,0,20">
                                <StackPanel Margin="8">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="CkSyncAcrossDevices" Content="{loc:Get sync_across_devices}"
                                          Click="CkSyncAcrossDevices_Click" FontSize="14"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get sync_across_devices_hint}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox x:Name="CkSyncLightingAcrossDevices" Content="{loc:Get sync_lighting_across_devices}"
                                          Click="CkSyncLightingAcrossDevices_Click" FontSize="14"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get sync_lighting_across_devices_hint}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbDpDeviceMap" Header="{loc:Get settings_dp_devicemap_group}" Margin="0,0,0,20">
                                <StackPanel Margin="8" Orientation="Horizontal">
                                    <Button x:Name="BtnDpDeviceMap" Content="{loc:Get settings_dp_devicemap_btn}"
                                    Padding="8,4" VerticalAlignment="Center"
                                    Click="BtnDpDeviceMap_Click"
                                    Style="{StaticResource K2IconButton}" Tag="&#xE8AB;"/>
                                    <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_dp_devicemap_hint}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppLanguage" Header="{loc:Get settings_language}" Margin="0,0,0,20">
                                <StackPanel Margin="8">
                                    <ComboBox x:Name="CmbAppLanguage" Width="220" HorizontalAlignment="Left"
                                      SelectionChanged="CmbAppLanguage_SelectionChanged"/>
                                    <TextBlock Text="{loc:Get settings_language_hint}" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppFont" Header="{loc:Get settings_font_family}" Margin="0,0,0,20">
                                <StackPanel Margin="8">
                                    <ComboBox x:Name="CmbAppFont" Width="220" HorizontalAlignment="Left"
                                      SelectionChanged="CmbAppFont_SelectionChanged"/>
                                    <TextBlock Text="{loc:Get settings_font_family_hint}" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppAccentColor" Header="{loc:Get settings_accent_color}" Margin="0,0,0,20">
                                <StackPanel Margin="8">
                                    <ComboBox x:Name="CmbAppAccentColor" Width="220" HorizontalAlignment="Left"
                                      SelectionChanged="CmbAppAccentColor_SelectionChanged"/>
                                    <TextBlock Text="{loc:Get settings_accent_color_hint}" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>

                                    <TextBlock Text="{loc:Get settings_icon_color}" FontSize="14" Margin="0,16,0,0"/>
                                    <ComboBox x:Name="CmbAppIconColor" Width="220" HorizontalAlignment="Left" Margin="0,6,0,0"
                                      SelectionChanged="CmbAppIconColor_SelectionChanged"/>
                                    <TextBlock Text="{loc:Get settings_icon_color_hint}" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbIconGalleryStyle" Header="{loc:Get settings_icon_style}" Margin="0,0,0,20">
                                <StackPanel Margin="8">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RbIconStyleBlack" Content="{loc:Get settings_icon_style_black}"
                                             GroupName="IconGalleryStyle" Margin="0,0,20,0"
                                             Checked="IconGalleryStyle_Checked"/>
                                        <RadioButton x:Name="RbIconStyleColor" Content="{loc:Get settings_icon_style_color}"
                                             GroupName="IconGalleryStyle"
                                             Checked="IconGalleryStyle_Checked"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Get settings_icon_style_hint}" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppLogLevel" Header="{loc:Get settings_log_level}" Margin="0,4,0,0">
                                <StackPanel Margin="8">
                                    <RadioButton x:Name="RbLogOff"     Content="{loc:Get log_off}"
                                         GroupName="AppLogLevel" Margin="0,4" Checked="RbLogLevel_Checked"/>
                                    <RadioButton x:Name="RbLogNormal"  Content="{loc:Get log_normal}"
                                         GroupName="AppLogLevel" Margin="0,4" Checked="RbLogLevel_Checked"/>
                                    <RadioButton x:Name="RbLogVerbose" Content="{loc:Get log_verbose}"
                                         GroupName="AppLogLevel" Margin="0,4" Checked="RbLogLevel_Checked"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <CheckBox x:Name="CkPersistLogs" Content="{loc:Get settings_persist_logs}"
                                          Click="CkPersistLogs_Click" FontSize="14"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_persist_logs_hint}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button x:Name="BtnAppExportLog" Content="{loc:Get settings_export_log_btn}"
                                        Padding="8,4" VerticalAlignment="Center"
                                        Click="BtnAppExportLog_Click"
                                        Style="{StaticResource K2IconButton}" Tag="&#xE898;"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_export_log_hint}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppBcInteractions" Header="{loc:Get settings_bc_interactions_group}" Margin="0,20,0,0">
                                <StackPanel Margin="8">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="CkAutoStopBaseCamp" Content="{loc:Get settings_auto_stop_bc}"
                                          Click="CkAutoStopBaseCamp_Click" FontSize="14"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_auto_stop_bc_hint}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <CheckBox x:Name="CkKillBcWorker" Content="{loc:Get settings_kill_bc_worker}"
                                          Click="CkKillBcWorker_Click" FontSize="14"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_kill_bc_worker_hint}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <CheckBox x:Name="CkRestartBcOnClose" Content="{loc:Get settings_restart_bc_on_close}"
                                          Click="CkRestartBcOnClose_Click" FontSize="14"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_restart_bc_on_close_hint}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <CheckBox x:Name="CkBcAutostart" Content="{loc:Get settings_bc_autostart}"
                                          Click="CkBcAutostart_Click" FontSize="14"/>
                                        <Path x:Name="HintBcAutostart" Style="{StaticResource K2HintIcon}"
                                              ToolTip="{loc:Get settings_bc_autostart_hint}"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppSignalRgb" Header="{loc:Get settings_signalrgb_group}" Margin="0,20,0,0">
                                <StackPanel Margin="8">
                                    <TextBlock Text="{loc:Get settings_signalrgb_hint}" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"/>

                                    <TextBlock x:Name="TxtSignalRgbStatus" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RbSignalRgbYield" Content="{loc:Get settings_signalrgb_mode_yield}"
                                             GroupName="SignalRgbMode" FontSize="14" Checked="RbSignalRgbMode_Checked"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_signalrgb_mode_yield_hint}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <RadioButton x:Name="RbSignalRgbStop" Content="{loc:Get settings_signalrgb_mode_stop}"
                                             GroupName="SignalRgbMode" FontSize="14" Checked="RbSignalRgbMode_Checked"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_signalrgb_mode_stop_hint}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <RadioButton x:Name="RbSignalRgbOff" Content="{loc:Get settings_signalrgb_mode_off}"
                                             GroupName="SignalRgbMode" FontSize="14" Checked="RbSignalRgbMode_Checked"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_signalrgb_mode_off_hint}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,20,0,8">
                                        <TextBlock Text="{loc:Get settings_signalrgb_plugins}" FontWeight="SemiBold"
                                           FontSize="14" VerticalAlignment="Center"/>
                                        <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get settings_signalrgb_plugins_hint}"/>
                                    </StackPanel>
                                    <!-- WrapPanel, not a horizontal StackPanel: the three labels are
                                         localized and the settings column is narrow, so on a StackPanel
                                         the third button was clipped off the right edge (user report
                                         2026-08-27). Wrapping keeps every button reachable whatever the
                                         language does to the label widths. -->
                                    <WrapPanel Margin="0,0,0,-8">
                                        <Button x:Name="BtnSignalRgbInstallPlugins" Content="{loc:Get settings_signalrgb_install_plugins}"
                                        Padding="8,4" Margin="0,0,8,8" Click="BtnSignalRgbInstallPlugins_Click"
                                        Style="{StaticResource K2IconButton}" Tag="&#xE896;"/>
                                        <Button x:Name="BtnSignalRgbRemovePlugins" Content="{loc:Get settings_signalrgb_remove_plugins}"
                                        Padding="8,4" Margin="0,0,8,8" Click="BtnSignalRgbRemovePlugins_Click"
                                        Style="{StaticResource K2IconButton}" Tag="&#xE74D;"/>
                                        <Button x:Name="BtnSignalRgbOpenPluginFolder" Content="{loc:Get settings_signalrgb_open_plugin_folder}"
                                        Padding="8,4" Margin="0,0,8,8" Click="BtnSignalRgbOpenPluginFolder_Click"
                                        Style="{StaticResource K2IconButton}" Tag="&#xE838;"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppDanger" Header="{loc:Get settings_danger_zone}"
                              Margin="0,24,0,0" BorderBrush="{StaticResource K2DangerBrush}">
                                <StackPanel Margin="8" Orientation="Horizontal">
                                    <Button x:Name="BtnAppRestoreDefaults" Content="{loc:Get restore_defaults_app}"
                                    Padding="8,4" VerticalAlignment="Center"
                                    Click="BtnAppRestoreDefaults_Click"
                                    Style="{StaticResource K2IconButton}" Tag="&#xE777;"/>
                                    <Path Style="{StaticResource K2HintIcon}" ToolTip="{loc:Get restore_defaults_app_hint}"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="GbAppAcknowledgements" Header="{loc:Get settings_acknowledgements_group}"
                              Margin="0,24,0,0">
                                <StackPanel Margin="8">
                                    <TextBlock x:Name="TxtAppAcknowledgements" Foreground="#9A9AA2"
                                       TextWrapping="Wrap" FontSize="12"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- "Extra" — scrollable list of external reference links, one card per
                         row (see MainWindow.Settings.cs's InitExtraLinksPanel /
                         LinkPreviewService). Each card shows the linked page's own Open Graph
                         preview image on the left and title/url on the right, and opens the
                         link in the default browser on click. Left margin of 40 (vs. the
                         Settings column's own 24) keeps its content clear of the Settings
                         ScrollViewer's scrollbar on narrower windows. -->
                    <StackPanel Grid.Column="1" Margin="40,24,24,24" VerticalAlignment="Top">
                        <TextBlock Text="{loc:Get settings_extra_title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="IcExtraLinkGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="#9A9AA2" Margin="0,0,0,10"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Height="140" Margin="0,0,0,16" CornerRadius="8"
                                                        ClipToBounds="True" Background="#14141A" BorderBrush="#2A2A33"
                                                        BorderThickness="1" Cursor="Hand" MouseLeftButtonUp="ExtraLinkCard_Click"
                                                        ToolTip="{Binding Url}" MaxWidth="640" HorizontalAlignment="Stretch">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <DockPanel Margin="12">
                                                                <Border DockPanel.Dock="Left" Width="180" CornerRadius="6"
                                                                ClipToBounds="True" Background="#101014">
                                                                    <Image Source="{Binding Image}" Stretch="UniformToFill"/>
                                                                </Border>
                                                                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" MaxHeight="60"/>
                                                                    <TextBlock Text="{Binding Url}" FontSize="11" Foreground="#9A9AA2"
                                                                       TextTrimming="CharacterEllipsis" Margin="0,10,0,0"/>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
                <!-- end PnlSettings -->

            </Grid>
            <!-- end content panels -->
        </Grid>
        <!-- end outer device Grid -->

        <!-- Status bar — kept in the tree (LblStatus is still written to from many
             code-behind files) but hidden from view per user request; language
             switching moved to Settings > Language (GbAppLanguage). -->
        <StatusBar Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
            <StatusBarItem>
                <TextBlock x:Name="LblStatus" Text="{loc:Get driver_not_opened}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Hardware-busy overlay — shown while a blocking device write (NDK/Display Dial
             picture upload, etc.) is in flight, so the app reads as "waiting", not frozen.
             Toggled via RunHwBusy/ShowHwBusy/HideHwBusy (MainWindow.HwBusy.cs). Root-level,
             spanning both rows, so it covers the whole window (tab strip, content, status
             bar) — not just the device content area. Semi-transparent (unlike PnlLoading)
             so the interface stays visible underneath, since this is a transient wait, not
             a full page swap. -->
        <Grid x:Name="PnlHwBusy" Grid.RowSpan="2" Panel.ZIndex="20" Background="#D91A1A1E"
              Visibility="Collapsed">
            <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#F02A2A32" BorderBrush="{DynamicResource K2AccentBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="36,28">
                <StackPanel>
                    <TextBlock x:Name="TxtHwBusyMessage" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380"
                               TextWrapping="Wrap"/>
                    <ProgressBar IsIndeterminate="True" Width="280" Height="3"
                                 Margin="0,18,0,0" Foreground="{DynamicResource K2AccentBrush}" Background="#1A1A1E"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
