<UserControl x:Class="K2.App.MakaluDpiRemapPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core">
    <!-- "Key Binding" (button remap) section content — DIRECT child of
         MainWindow.xaml (MainWindow.Makalu.cs toggles SecRemap directly).
         Despite the class name (kept for now to limit churn), DPI no longer
         lives here — its levels list moved into MakaluRgbSettingsPanel's
         Settings section. Do not nest this inside another custom
         UserControl (a "shell" wrapping this + MakaluRgbSettingsPanel) —
         that specific nesting was tried 2026-07-10 and appeared to crash,
         though the WinDbg session that eventually root-caused the *real*
         bug that day (a plain null-ref in MkSection_Changed/
         SldMkDpi_ValueChanged firing before dependent fields were assigned
         — see MainWindow.Makalu.cs's doc comment) suggests the
         "nesting" theory may itself have been a misdiagnosis of the same
         root cause, never independently re-verified after the real fix.
         Treat nesting as unconfirmed-risky, not proven-safe, until someone
         actually retests it. -->
    <Grid>
        <!-- Remap ("Key Binding" in the sidebar — DPI used to live here too,
             now moved into MakaluRgbSettingsPanel's Settings section, see
             MainWindow.xaml). This is the default Makalu section (see
             InitMkSectionNav), so it starts Visible, not Collapsed — the
             sibling sections in MakaluRgbSettingsPanel (SecRgb/SecSettings)
             both start Collapsed to match.
             Layout aligned to every other device's Key Binding section
             (2026-07-27, explicit user request — previously Makalu was the
             one deliberate exception, see MainWindow.xaml's PnlSecKeyMapping
             comment): hint + list + Configure/Remove, same shape as
             Everest60KeyBindingPanel/MainWindow.xaml's PnlSecKeyMapping. The
             list only shows buttons whose assignment differs from this
             model's default (2026-07-27, user feedback: showing every
             physical button — including every still-default one — read as
             clutter/empty rows; MakaluDpiRemapPanel.xaml.cs's
             RefreshMkItemVisibility filters, _byIdx stays unfiltered so
             hotspot-click-to-configure still reaches every button
             regardless), built by BuildMkButtonList. Configure opens
             MakaluRemapConfigDialog (Makalu's own small firmware vocabulary,
             not the shared ButtonActionDialog/K2Action — see that dialog's
             doc comment); Remove resets the button back to its model
             default. Clicking a hotspot on the device image
             (MainWindow.Makalu.cs's MkHotspotClicked -> SelectRemapButton)
             selects the row AND opens Configure directly, same flow as
             Everest 60's SelectKey. -->
        <Grid x:Name="SecRemap">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- title -->
                <RowDefinition Height="Auto"/> <!-- hint -->
                <RowDefinition Height="*"/>    <!-- list + buttons -->
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{loc:Get makalu_remap_title}" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock Grid.Row="1" Text="{loc:Get key_binding_hint}"
                       Foreground="#9A9AA2" FontStyle="Italic"
                       TextWrapping="Wrap" Margin="0,0,0,8"/>

            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>
                <ListView Grid.Column="0" x:Name="LvMkButtons" Margin="0,0,8,0"
                          SelectionChanged="LvMkButtons_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Padding="2"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                    <Button x:Name="BtnMkConfigure" Content="{loc:Get ev_configure}" Padding="8,4"
                            Click="BtnMkConfigure_Click" HorizontalAlignment="Stretch" Margin="0,0,0,4"
                            IsEnabled="False"/>
                    <Button x:Name="BtnMkRemove" Content="{loc:Get ev_remove}" Padding="8,4"
                            Click="BtnMkRemove_Click" HorizontalAlignment="Stretch"
                            IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Remap-left-button safety confirm overlay (auto-revert countdown) -->
        <Border x:Name="PnlMkRemapConfirm" Panel.ZIndex="20"
                Background="#CC000000" Visibility="Collapsed">
            <Border Background="#1E1E24" BorderBrush="#3A3A40" BorderThickness="1" CornerRadius="8"
                    Padding="20" Width="320" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="LblMkRemapConfirmText" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnMkRemapKeep" Content="{loc:Get makalu_remap_keep_btn}"
                                Click="BtnMkRemapKeep_Click" Padding="10,5" Margin="0,0,8,0"/>
                        <Button x:Name="BtnMkRemapRevert" Content="{loc:Get makalu_remap_revert_btn}"
                                Click="BtnMkRemapRevert_Click" Padding="10,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
