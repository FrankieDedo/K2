<Window x:Class="K2.App.ScreenProbePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core"
        Title="{loc:Get studio_probe_pick_title}"
        Width="520" Height="520" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource K2AppFontFamily}"
        Style="{DynamicResource K2WindowStyle}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Unchecked by default on purpose: this dialog is the way OUT of the combo's own
             process filter, so opening it already filtered would show exactly the same short
             list the user came here to get past. -->
        <CheckBox Grid.Row="0" x:Name="ChkFilter" Content="{loc:Get studio_probe_pick_filter}"
                  Margin="0,0,0,10" Foreground="{DynamicResource K2TextBrush}"
                  Click="ChkFilter_Click"/>

        <Grid Grid.Row="1">
            <ListBox x:Name="LstProbes" MouseDoubleClick="LstProbes_MouseDoubleClick"
                     SelectionChanged="LstProbes_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="{DynamicResource K2SurfaceAltBrush}"
                     Foreground="{DynamicResource K2TextBrush}"
                     BorderBrush="{DynamicResource K2BorderBrush}" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Process}" FontSize="11"
                                       Foreground="{DynamicResource K2TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="LblEmpty" Text="{loc:Get studio_probe_pick_empty}"
                       Visibility="Collapsed" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"
                       Foreground="{DynamicResource K2TextMutedBrush}"/>
        </Grid>

        <!-- The library is also where readings are MADE and unmade: coming here to look for one
             and finding it needs editing (or was never worth keeping) is the same trip. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
            <Button Content="{loc:Get studio_probe_new}" Padding="10,3" Click="BtnNew_Click"/>
            <Button x:Name="BtnEdit" Content="{loc:Get studio_probe_edit}" Margin="6,0,0,0"
                    Padding="10,3" Click="BtnEdit_Click"/>
            <Button x:Name="BtnDelete" Content="{loc:Get studio_probe_delete}" Margin="6,0,0,0"
                    Padding="10,3" Click="BtnDelete_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Get cancel}" MinWidth="90" IsCancel="True"/>
            <Button x:Name="BtnOk" Content="{loc:Get ok}" MinWidth="90" Margin="8,0,0,0"
                    IsDefault="True" Style="{StaticResource K2IconAccentButton}" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
