<Window x:Class="K2.App.GameLinkTreeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core"
        xmlns:local="clr-namespace:K2.App"
        Title="{loc:Get link_tree_title}"
        Width="480" Height="560" MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource K2AppFontFamily}"
        Style="{DynamicResource K2WindowStyle}">

    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:GameLinkPathNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding DisplayText}" ToolTip="{Binding FullPath}"
                       Foreground="{DynamicResource K2TextBrush}"/>
        </HierarchicalDataTemplate>
        <!-- TwoWay: expanding a row by hand has to write back, or the next "expand all" would work
             from a stale idea of what is already open. -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Get link_tree_intro}"
                   Foreground="{DynamicResource K2TextMutedBrush}" FontSize="11"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{loc:Get link_tree_filter}" Foreground="{DynamicResource K2TextBrush}"
                       Margin="0,0,0,3"/>
            <TextBlock Text="{loc:Get link_tree_filter_hint}" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource K2TextMutedBrush}" Margin="0,0,0,3"/>
            <!-- No live filtering as you type, deliberately: a link can answer with tens of
                 thousands of values, and re-filtering a tree that size on every keystroke is slow
                 enough to be unusable and heavy enough to have taken K2 (a 32-bit process) down. The
                 search happens when it is ASKED for. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="TxtFilter" Height="26"
                         VerticalContentAlignment="Center" KeyDown="TxtFilter_KeyDown"/>
                <Button Grid.Column="1" x:Name="BtnSearch" Content="{loc:Get link_tree_search}"
                        Margin="6,0,0,0" Padding="12,3" Style="{StaticResource K2IconButton}"
                        Tag="&#xE721;" Click="BtnSearch_Click"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="{loc:Get link_tree_expand_all}" Padding="10,3" Margin="0,0,6,0"
                        Style="{StaticResource K2IconButton}" Tag="&#xE710;"
                        Click="BtnExpandAll_Click"/>
                <Button Content="{loc:Get link_tree_collapse_all}" Padding="10,3"
                        Style="{StaticResource K2IconButton}" Tag="&#xE738;"
                        Click="BtnCollapseAll_Click"/>
            </StackPanel>
            <CheckBox x:Name="ChkShowAll" Content="{loc:Get link_tree_show_all}" Margin="0,6,0,0"
                      Foreground="{DynamicResource K2TextBrush}"
                      ToolTip="{loc:Get link_tree_show_all_tip}"
                      Checked="ChkShowAll_Changed" Unchecked="ChkShowAll_Changed"/>
        </StackPanel>

        <Border Grid.Row="2" BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource K2BorderBrush}"
                Background="{DynamicResource K2SurfaceBrush}">
            <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      MouseDoubleClick="Tree_MouseDoubleClick"
                      PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{loc:Get link_tree_go_here}" Click="MnuShowAll_Click"
                                  ToolTip="{loc:Get link_tree_go_here_tip}"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
            </TreeView>
        </Border>

        <!-- Its own FULL-WIDTH row, not a cell squeezed in beside the buttons: this line is where
             every refusal, count and error lands ("42000 values - too many to list"), and sharing a
             row with OK/Cancel let it run underneath them, i.e. say nothing at all. -->
        <TextBlock Grid.Row="3" x:Name="LblSelected" Margin="0,12,0,0" TextWrapping="Wrap"
                   MaxHeight="52" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource K2TextMutedBrush}"/>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="BtnExport" Content="{loc:Get link_tree_export}" Padding="10,3"
                        Style="{StaticResource K2IconButton}" Tag="&#xE896;"
                        ToolTip="{loc:Get link_tree_export_tip}" Click="BtnExport_Click"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="BtnOk" Content="{loc:Get ok}" MinWidth="90" IsEnabled="False"
                    Style="{StaticResource K2IconAccentButton}" Click="BtnOk_Click"/>
            <Button Grid.Column="2" Content="{loc:Get cancel}" MinWidth="90" IsCancel="True"
                    Margin="8,0,0,0" Style="{StaticResource K2IconButton}"/>
        </Grid>
    </Grid>
</Window>
