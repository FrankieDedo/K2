<Window x:Class="K2.App.DpDeviceMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core"
        Title="{loc:Get dp_devicemap_title}"
        Width="460" SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{DynamicResource K2WindowStyle}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- title -->
            <RowDefinition Height="Auto"/>  <!-- hint -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>  <!-- column headers -->
            <RowDefinition Height="Auto"/>  <!-- rows -->
            <RowDefinition Height="Auto"/>  <!-- empty text -->
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>  <!-- buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Get dp_devicemap_title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" Text="{loc:Get dp_devicemap_hint}" Foreground="#9A9AA2"
                   TextWrapping="Wrap" FontSize="12"/>

        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Get dp_devicemap_col_current}" Foreground="#808088" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="{loc:Get dp_devicemap_col_firmware}" Foreground="#808088" FontSize="11"/>
            <TextBlock Grid.Column="2" Text="{loc:Get dp_devicemap_col_board}" Foreground="#808088" FontSize="11"/>
        </Grid>

        <ScrollViewer Grid.Row="4" MaxHeight="300" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LvDpDeviceMap">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#232328" CornerRadius="6" Margin="0,0,0,6" Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding CurrentLabel}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding Firmware}"
                                           Foreground="#9A9AA2" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="2" Text="{Binding BoardNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Width="60" HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="3" Content="{loc:Get dp_devicemap_identify_btn}"
                                        Padding="6,3" FontSize="11" Tag="{Binding RawId}"
                                        Click="BtnDpDeviceMapIdentify_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="TxtDpDeviceMapEmpty" Grid.Row="5" Text="{loc:Get dp_devicemap_none_connected}"
                   Foreground="#9A9AA2" TextWrapping="Wrap" FontSize="12" Visibility="Collapsed"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{loc:Get save}" Width="90" Padding="6,2" IsDefault="True"
                    Style="{StaticResource K2IconAccentButton}"
                    Click="BtnDpDeviceMapSave_Click" Margin="0,0,8,0"/>
            <Button Content="{loc:Get cancel}" IsCancel="True" MinWidth="72"/>
        </StackPanel>
    </Grid>
</Window>
