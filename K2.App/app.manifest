<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="K2.App.app"/>

  <!-- Elevation is required to control BaseCampService (runs as LocalSystem): without
       it, sc.exe stop/start silently fails (access denied) and Base Camp's service can
       respawn MountainDisplayPadWorker on its own, reintroducing the DisplayPad icon
       corruption K2's auto-stop is meant to prevent — confirmed on hardware 2026-07-15
       (worker was back up right after K2's kill, service inaccessible without admin). -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 8.1 / 10 / 11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>

  <!-- Senza questo blocco l'app non dichiara alcun DPI awareness: Windows la
       tratta come "unaware", la disegna a 96 DPI e la ridimensiona via bitmap
       per adattarla allo scaling del monitor — è questo che rende il testo
       (specie bold+italic delle tab dispositivo) sfocato/"pixellato" a
       125%/150%/ecc. PerMonitorV2 fa disegnare tutto nativamente alla
       risoluzione reale del monitor. Il compilatore segnala WFAC010 perche'
       il progetto ha anche UseWindowsForms=true (per il ColorDialog nativo),
       ma quel warning presuppone un'app WinForms pura con Application.Run —
       qui il DPI awareness reale e' comunque governato dal manifest, come da
       modello WPF; il warning e' soppresso in K2.App.csproj (2026-07-28). -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
