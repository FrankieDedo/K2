<Window x:Class="K2.App.GameStudioTemplateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core"
        Title="{loc:Get studio_action_new}"
        SizeToContent="Height" Width="600" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource K2AppFontFamily}"
        Style="{DynamicResource K2WindowStyle}">

    <Window.Resources>
        <!-- One model: a small drawing of what the tile will look like, its name, and the kind of
             thing it is for. The whole card is the button. -->
        <Style x:Key="TplCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource K2SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource K2BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" Padding="14,12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource K2HoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource K2AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TplName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource K2TextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>
        <Style x:Key="TplHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource K2TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtTitle" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource K2TextBrush}"/>
            <TextBlock Text="{loc:Get studio_tpl_intro}" Style="{StaticResource TplHint}" Margin="0,4,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2">
            <Button Style="{StaticResource TplCard}" Tag="Bar" Click="Card_Click">
                <StackPanel>
                    <Border Height="18" Width="120" HorizontalAlignment="Left" CornerRadius="3"
                            Background="{DynamicResource K2SurfaceDarkBrush}">
                        <Border Width="82" HorizontalAlignment="Left" CornerRadius="3"
                                Background="{DynamicResource K2AccentBrush}"/>
                    </Border>
                    <TextBlock Text="{loc:Get studio_tpl_bar}" Style="{StaticResource TplName}"/>
                    <TextBlock Text="{loc:Get studio_tpl_bar_hint}" Style="{StaticResource TplHint}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TplCard}" Tag="Number" Click="Card_Click">
                <StackPanel>
                    <TextBlock Text="72" FontSize="20" FontWeight="Bold" Height="18"
                               Foreground="{DynamicResource K2AccentHoverBrush}" LineHeight="18"
                               LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock Text="{loc:Get studio_tpl_number}" Style="{StaticResource TplName}"/>
                    <TextBlock Text="{loc:Get studio_tpl_number_hint}" Style="{StaticResource TplHint}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TplCard}" Tag="OnOff" Click="Card_Click">
                <StackPanel>
                    <Border Width="40" Height="18" CornerRadius="9" HorizontalAlignment="Left"
                            Background="{DynamicResource K2AccentBrush}">
                        <Ellipse Width="12" Height="12" Fill="White" HorizontalAlignment="Right" Margin="0,0,3,0"/>
                    </Border>
                    <TextBlock Text="{loc:Get studio_tpl_onoff}" Style="{StaticResource TplName}"/>
                    <TextBlock Text="{loc:Get studio_tpl_onoff_hint}" Style="{StaticResource TplHint}"/>
                </StackPanel>
            </Button>

            <Button Style="{StaticResource TplCard}" Tag="Mirror" Click="Card_Click">
                <StackPanel>
                    <Rectangle Width="18" Height="18" HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                               Stroke="{DynamicResource K2AccentHoverBrush}" StrokeThickness="2"
                               StrokeDashArray="3 2"/>
                    <TextBlock Text="{loc:Get studio_kind_mirror}" Style="{StaticResource TplName}"/>
                    <TextBlock Text="{loc:Get studio_tpl_mirror_hint}" Style="{StaticResource TplHint}"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,6,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button HorizontalAlignment="Left" Style="{StaticResource K2IconButton}" Tag="&#xE70F;"
                    Content="{loc:Get studio_tpl_blank}" Click="Blank_Click"/>
            <Button Grid.Column="1" Content="{loc:Get cancel}" MinWidth="90" IsCancel="True"
                    Style="{StaticResource K2IconButton}"/>
        </Grid>
    </Grid>
</Window>
