<Window x:Class="K2.App.MakaluLodCalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:K2.Core;assembly=K2.Core"
        Title="{loc:Get makalu_lod_title}"
        Height="480" Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource K2WindowStyle}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- hint -->
            <RowDefinition Height="260"/>   <!-- draw canvas -->
            <RowDefinition Height="Auto"/>  <!-- progress -->
            <RowDefinition Height="Auto"/>  <!-- start/reset + done -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Get makalu_lod_hint}" TextWrapping="Wrap"
                   Foreground="{StaticResource K2TextMutedBrush}" FontSize="12"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="#111115" BorderBrush="#2A2A32" BorderThickness="1" CornerRadius="6">
            <Canvas x:Name="CvsDraw" Background="Transparent" ClipToBounds="True"
                    MouseLeftButtonDown="CvsDraw_MouseDown" MouseMove="CvsDraw_MouseMove"
                    MouseLeftButtonUp="CvsDraw_MouseUp" MouseLeave="CvsDraw_MouseLeave">
                <Ellipse x:Name="EllHandle" Width="16" Height="16" Fill="White"
                         Stroke="{DynamicResource K2AccentBrush}" StrokeThickness="2"
                         Canvas.Left="142" Canvas.Top="122" IsHitTestVisible="False"/>
            </Canvas>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,10,0,10">
            <DockPanel Margin="0,0,0,4">
                <TextBlock Text="{loc:Get makalu_lod_progress}" FontSize="11"
                           Foreground="{StaticResource K2TextMutedBrush}"/>
                <TextBlock x:Name="LblProgressVal" Text="0%" FontWeight="Bold" FontSize="11"
                           Margin="6,0,0,0"/>
            </DockPanel>
            <ProgressBar x:Name="PbProgress" Minimum="0" Maximum="100" Value="0" Height="8"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnStart" Content="{loc:Get makalu_lod_start}" Click="BtnStart_Click" Padding="10,4" Margin="0,0,6,0"/>
            <Button x:Name="BtnDone" Content="{loc:Get makalu_lod_done}" Click="BtnDone_Click" Padding="10,4"/>
        </StackPanel>
    </Grid>
</Window>
